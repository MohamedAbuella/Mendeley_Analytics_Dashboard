issn = {23524677},
journal = {Sustainable Energy, Grids and Networks},
keywords = {Ancillary services,Frequency control,Renewable energy,Stochastic economic model predictive control,Stochastic programming,Storage degradation},
month = {jun},
publisher = {Elsevier Ltd},
title = {{Stochastic economic model predictive control for renewable energy and ancillary services trading with storage}},
volume = {38},
year = {2024}
}
