keywords = {Liner shipping,Particle swarm optimization,PhyML,Speed optimization,Sustainable maritime logistics,Very High cited doc,WSR,Weather archive data,important doc,shipping},
mendeley-tags = {PhyML,Very High cited doc,WSR,important doc,shipping},
pages = {330--342},
publisher = {Elsevier Ltd},
title = {{A decision support system for vessel speed decision in maritime logistics using weather archive big data}},
url = {https://doi.org/10.1016/j.cor.2017.06.005},
volume = {98},
year = {2018}
}
