journal = {Applied Sciences (Switzerland)},
keywords = {Contextual optimization,Facebook Prophet,Machine learning,Short-term and long-term predictions,Solar irradiance forecasting,Support vector machine},
month = {jan},
number = {1},
publisher = {MDPI},
title = {{Solar Irradiance Forecasting Using a Data-Driven Algorithm and Contextual Optimisation}},
volume = {12},
year = {2022}
}
