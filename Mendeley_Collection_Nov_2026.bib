journal = {Computer Communications},
keywords = {Coverage and connectivity,Path,Path planning techniques,Security,Space-air-ground integrated networks,Theoretical Background,Tra_GMM_DMP_Spline,Unmanned aerial vehicles (UAVs) communications,Very High cited doc,important doc,review,shipping},
