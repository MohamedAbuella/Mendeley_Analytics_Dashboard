@article{Pudjianto2023,
abstract = {With high predictability and a consistent energy availability profile, Tidal Stream (TS) could play an important part in the optimal future low-carbon energy mix, improving the supply reliability and system resilience through diversification of renewable energy supplementing wind and solar power. This paper summarises key findings from UK studies on the benefits of TS by assessing its impact on the overall energy system. The studies use the Integrated Whole Energy System (IWES) model to minimise the overall cost of the 2050 GB energy system with and without TS under different scenarios while respecting the net-zero emission target and reliability requirement. The results show that TS could displace some capacity of mid-merit or peaking plants, indicating some capacity value of offshore wind and lowering the levelised cost of wind power because of lower system integration costs. Diversifying energy resources and improving flexibility are crucial to coping with low-carbon energy resource variation. The studies also demonstrate that the value of TS by 2050 should be around {\pounds}50 per MW per h, and this cost target could be achieved if a sufficient learning rate (10-15%) with 10 GW of installed capacity could be obtained in the transition period. Other sensitivity studies provide insight into the impact of location, heat decarbonisation pathways, lower annual wind capacity factor, system flexibility, and interconnection capacity on TS's wider energy system benefits.},
author = {Pudjianto, Danny and Frost, Ciaran and Coles, Daniel and Angeloudis, Athanasios and Smart, Gavin and Strbac, Goran},
doi = {10.1039/d2ya00251e},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Pudjianto et al. - 2023 - UK studies on the wider energy system benefits of tidal stream.pdf:pdf},
issn = {27531457},
journal = {Energy Advances},
keywords = {Heating,Hydrogen,OR,Theoretical Background,important doc},
mendeley-tags = {Heating,Hydrogen,OR,Theoretical Background,important doc},
number = {6},
pages = {789--796},
publisher = {Royal Society of Chemistry},
title = {{UK studies on the wider energy system benefits of tidal stream}},
url = {http://dx.doi.org/10.1039/D2YA00251E},
volume = {2},
year = {2023}
}
@article{Ahmed2017,
abstract = {Multi-step ahead wind forecasting is a key consideration for wind farm owners operating in a competitive electricity market for assessing the reliability of a power plant and devising an optimal dispatch strategy to maximize their revenues. In this scenario, the accuracy of the forecasts and swiftness of the prediction process are the major factors. This paper presents an accurate and fast mechanism for wind forecasting up to six steps in future. Two different multi-step prediction strategies, namely, direct strategy and recursive strategy are used for this purpose. A nonlinear autoregressive neural network is developed to implement these techniques for wind speed time series. The developed method is evaluated in terms of standard performance indices via a thorough case study considering real-world wind speed data. The simulation results depict the efficacy of the proposed methodology as compared to a benchmark prediction model especially for longer time horizons. .},
author = {Ahmed, Adil and Khalid, Muhammad},
doi = {10.1016/j.egypro.2017.09.609},
issn = {18766102},
journal = {Energy Procedia},
keywords = {Multi-step ahead wind forecasting,Nonlinear Autoregressive Neural Network,Persistence,Theoretical Background,important doc},
mendeley-tags = {Theoretical Background,important doc},
pages = {192--204},
publisher = {Elsevier B.V.},
title = {{Multi-step Ahead Wind Forecasting Using Nonlinear Autoregressive Neural Networks}},
url = {https://doi.org/10.1016/j.egypro.2017.09.609},
volume = {134},
year = {2017}
}
