issn = {15582256},
journal = {Proceedings of the IEEE},
keywords = {5G communication,COVID-19,GT,OR,RE Teaching,Theoretical Background,Very High cited doc,cybera physicala social systems,data analytics,data privacy,demand response (DR),distribution systems,energy justice,important doc,review,smart grid,sociala technological integration,wireless communication},
mendeley-tags = {GT,OR,RE Teaching,Theoretical Background,Very High cited doc,important doc,review},
number = {7},
pages = {694--724},
