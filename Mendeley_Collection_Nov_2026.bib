journal = {IEEE Transactions on Sustainable Energy},
keywords = {Coordinated bidding strategy,GT,Hydrogen,OR,Theoretical Background,Very High cited doc,cooperative game,important doc,power-To-gas (P2G),profit allocation,wind power},
