keywords = {Capacity allocation,GASnets,Hydrogen,OR,Theoretical Background,Very High cited doc,gas balancing,gas-to-power,hydrogen injection,important doc,natural gas (NG) network,power-to-gas (PtG)},
mendeley-tags = {GASnets,Hydrogen,OR,Theoretical Background,Very High cited doc,important doc},
number = {9},
pages = {1580--1595},
title = {{Modeling and Simulation of Gas Distribution Networks in a Multienergy System Environment}},
