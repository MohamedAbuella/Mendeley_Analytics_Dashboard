issn = {01420615},
journal = {International Journal of Electrical Power and Energy Systems},
keywords = {Electrification,EnergPolicy,GASnets,Heating,Hydrogen,Multi-Vector Energy System,OR,Retrofit,Steam methane reforming,TEA,Theoretical Background,important doc},
mendeley-tags = {EnergPolicy,GASnets,Heating,Hydrogen,Multi-Vector Energy System,OR,TEA,Theoretical Background,important doc},
number = {PB},
