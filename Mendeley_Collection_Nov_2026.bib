keywords = {Bias-variance trade-off,Gaussian processes,Inverse problems,Kernel-based regularization,Linear system identification,Model complexity selection,Prediction error methods,Reproducing kernel Hilbert spaces,Very High cited doc,linear system identification,model complexity selection,prediction error methods,review,sysid},
