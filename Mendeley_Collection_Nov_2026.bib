issn = {2041840X},
keywords = {DER,charging,electric vehicle,standards},
month = {may},
number = {3},
publisher = {John Wiley and Sons Ltd},
title = {{A comprehensive review of standards and best practices for utility grid integration with electric vehicle charging stations}},
volume = {11},
year = {2022}
