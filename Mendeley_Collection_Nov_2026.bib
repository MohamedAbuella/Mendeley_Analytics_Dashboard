doi = {10.1016/j.ijepes.2015.02.006},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Bessa et al. - 2015 - Probabilistic solar power forecasting in smart grids using distributed information.pdf:pdf},
