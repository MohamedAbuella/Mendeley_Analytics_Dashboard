file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Zhang et al. - 2023 - Exploring the MIT Mathematics and EECS Curriculum Using Large Language Models.pdf:pdf},
title = {{Exploring the MIT Mathematics and EECS Curriculum Using Large Language Models}},
url = {http://arxiv.org/abs/2306.08997},
year = {2023}
}
