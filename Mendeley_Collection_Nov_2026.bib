pages = {744--754},
title = {{A Two-Stage Robust Optimization for Centralized-Optimal Dispatch of Photovoltaic Inverters in Active Distribution Networks}},
url = {http://ieeexplore.ieee.org/document/7592421/},
volume = {8},
year = {2017}
