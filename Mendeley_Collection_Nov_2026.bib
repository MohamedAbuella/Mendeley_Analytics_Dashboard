@article{VanSchaeybroeck2018,
abstract = {This chapter is devoted to a description of the main methods proposed so far to postprocess long-range forecasts from seasonal up to decadal time scales. After a brief overview of the difficulties that long-term ensemble forecasts are facing and the statistical framework in which postprocessing is envisaged, a description of the current methods of postprocessing (multi-) model long-range forecasts is presented. Particular emphasis is put on recent techniques used for correcting ensemble forecasts (member-by-member approaches), which are then applied in the context of a benchmark model, a low-order coupled ocean-atmosphere model, and in the context of an operational forecasting system. It turns out that the underlying hypothesis on the nature of the “weather noise” is crucial in order to get reliable ensemble forecasts. A brief discussion on the challenges in the context of long-range probabilistic forecasts is also provided.},
author = {{Van Schaeybroeck}, Bert and Vannitsem, St{\'{e}}phane},
doi = {10.1016/B978-0-12-812372-0.00010-8},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Van Schaeybroeck, Vannitsem - 2018 - Postprocessing of Long-Range Forecasts.pdf:pdf},
isbn = {9780128123720},
journal = {Statistical Postprocessing of Ensemble Forecasts},
keywords = {post-processing},
