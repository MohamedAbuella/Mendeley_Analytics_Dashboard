@article{Kong2018,
abstract = {Power distribution architecture refers to the organization and interactions of its components and participants. The system architecture should reflect the increasing and changing needs of all participants. In conjunction with the growth of low carbon technologies, traditionally passive customers have started to participate in energy trading, especially in the distribution system. A new architecture for the future distribution system is required to encourage the active customers to benefit the distribution network as well as themselves. This paper proposes a hierarchical architecture adapted from the Smart Grid Architecture Model. A sixth layer is added to the original five to represent the customer. The proposed system architecture will help future Distribution System Operators gain a better understanding of the future distribution system. A high degree of flexibility for both the network's and the customer's side will also be gained in the new system architecture.},
