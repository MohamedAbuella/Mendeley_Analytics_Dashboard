journal = {Solar Energy},
keywords = {Clustering analysis,Solar resource intra-day variability,Weather patterns},
number = {March},
pages = {374--387},
publisher = {Elsevier},
title = {{Analysis of the intra-day solar resource variability in the Iberian Peninsula}},
url = {https://doi.org/10.1016/j.solener.2018.06.060},
volume = {171},
year = {2018}
}
