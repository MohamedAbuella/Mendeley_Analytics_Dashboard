keywords = {Map-matching algorithm,Navigation,Positioning system,Road network},
pages = {153--165},
publisher = {Elsevier Ltd},
title = {{A critical review of real-time map-matching algorithms: Current issues and future directions}},
volume = {48},
year = {2014}
}
