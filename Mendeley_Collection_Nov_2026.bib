keywords = {Business process,Energy efficiency,Fuel savings,Integrated management,Optimization,System},
month = {dec},
pages = {39--48},
publisher = {Elsevier Ltd},
title = {{Integrated approach to vessel energy efficiency}},
volume = {110},
year = {2015}
