issn = {20763417},
keywords = {Metocean,artificial intelligence,automation,data interoperability,machine learning,oil and gas},
month = {jun},
number = {11},
publisher = {MDPI},
title = {{Development and Integration of Metocean Data Interoperability for Intelligent Operations and Automation Using Machine Learning: A Review}},
