@article{Gu2017,
abstract = {—In this paper, a short-term load forecasting approach based network reconfiguration is proposed in a parallel manner. Specifically, a support vector regression (SVR) based short-term load forecasting approach is designed to provide an accurate load prediction and benefit the network reconfiguration. Because of the nonconvexity of the three-phase balanced optimal power flow, a second-order cone program (SOCP) based approach is used to relax the optimal power flow problem. Then, the alternating direction method of multipliers (ADMM) is used to compute the optimal power flow in distributed manner. Considering the limited number of the switches and the increasing computation capability, the proposed network reconfiguration is solved in a parallel way. The numerical results demonstrate the feasible and effectiveness of the proposed approach. Index terms— Electrical distribution system, network re-configuration, alternating direction method of multipliers, sup-port vector regression, semidefinite relaxation programming, convex optimization, optimal power flow, short-term load forecasting NOMENCLATURE G The graph for PDS with a node set and a link set: G = [V, E]. $\omega$ $\omega$ is a linear combination coefficient of SVR, 1 2 $\omega$ T $\omega$ indicates the flatness of the regression coefficients. b b is an offset coefficient of SVR. C C is a trade-off parameter of SVR. $\gamma$ $\gamma$ is a parameter of (Gaussian) radial basis function. $\epsilon$ $\epsilon$ is an adjustable precision parameter, which indicates the training error threshold. R risk The objective function of designed for the SVR. ϕ 1 , ϕ 2 Two positive acceleration coefficients for velocity updates of each particle in the PSO. $\theta$ 1 , $\theta$ 2 Two independently random variables with uniformly distributed range (0, 1) for veloc-ity updates of each particle in the PSO. $\eta$ Ω g The complex current to bus i. z ij The complex impedance between bus i and bus j, z ij = r ij + ix ij . S ij The branch flow S ij = P ij + iQ ij . P ij The real power P ij = |I ij | 2 r ij . s i Power injection on bus i.},
archivePrefix = {arXiv},
arxivId = {arXiv:1711.10690v1},
author = {Gu, Yi and Jiang, Huaiguang and Zhang, Jun Jason and Zhang, Yingchen and Muljadi, Eduard and Solis, Francisco J},
