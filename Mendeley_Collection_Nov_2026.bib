journal = {Energy},
keywords = {Electric transport,Energy sectors integration,Flexibility,Heating,Hydrogen,Multi-Vector Energy System,OR,RE Teaching,Sector coupling,Smart charging,Theoretical Background,V2G,important doc,review},
mendeley-tags = {Heating,Hydrogen,Multi-Vector Energy System,OR,RE Teaching,Theoretical Background,important doc,review},
number = {May},
pages = {131635},
publisher = {Elsevier Ltd},
title = {{Role of smart charging of electric vehicles and vehicle-to-grid in integrated renewables-based energy systems on country level}},
