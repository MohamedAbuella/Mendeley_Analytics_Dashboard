isbn = {9780123971777},
keywords = {Cloud speed,Correlation,Cumulative distribution function,Geographic smoothing,Ground data,Puerto rico,Ramp rates,Solar variability,Wavelet variability model},
pages = {149--169},
publisher = {Elsevier},
title = {{Quantifying and Simulating Solar-Plant Variability Using Irradiance Data}},
url = {http://dx.doi.org/10.1016/B978-0-12-397177-7.00007-3},
