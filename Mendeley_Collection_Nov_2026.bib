journal = {IEEE Journal on Selected Areas in Communications},
keywords = {Asymmetric digital subscriber line (ADSL),Dynamic spectral management,GT,Game theory,Interference channel,Iterative water-filling,Nash equilibrium,OR,Power control,Spectral compatibility,Upstream power backoff,Very High cited doc,Very-high bit-rate digital subscriber line (VDSL)},
