isbn = {9780123971777},
journal = {Solar Energy Forecasting and Resource Assessment},
keywords = {Bias error,Forecast applications,Forecasting metrics,Input selection,Numerical weather prediction,Persistence error,Satellite,Sky imager,Solar variability,Solar-forecasting methods,Solar-power uncertainty,Stochastic learning},
