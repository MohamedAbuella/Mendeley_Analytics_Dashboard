journal = {Archives of Mining Sciences},
keywords = {Convective term,Design flow equation,GASnets,GERG 2004 application,Kinetic energy term,OR,Pipeline gas flow,Steady-state flow model,Theoretical Background,important doc},
mendeley-tags = {GASnets,OR,Theoretical Background,important doc},
number = {1},
pages = {23--38},
title = {{Comparative assesment of steady-state pipeline gas flow models}},
volume = {57},
year = {2012}
}
