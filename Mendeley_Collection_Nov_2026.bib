journal = {International Journal of Data Science and Analytics},
keywords = {Automatic identification system,Data mining,Genetic algorithms,Path,Pattern recognition,Synchromodal logistics,important doc,shipping},
mendeley-tags = {Path,important doc,shipping},
number = {2-3},
