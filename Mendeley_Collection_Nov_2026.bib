journal = {Energy Research and Social Science},
keywords = {Distributed power,Energy democracy,Energy politics,High cited doc,RE Teaching,Renewable energy transition,review},
mendeley-tags = {High cited doc,RE Teaching,review},
number = {October 2017},
pages = {78--93},
publisher = {Elsevier},
title = {{Political power and renewable energy futures: A critical review}},
url = {https://doi.org/10.1016/j.erss.2017.10.018},
volume = {35},
year = {2018}
}
