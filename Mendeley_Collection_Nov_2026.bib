@article{Gottfredson1994,
abstract = {The NADPH‐dependent enzymic reduction of disulfide bonds in human choriogonadotropin and its two subunits, $\alpha$ and $\beta$, was examined with thioredoxin and thioredoxin reductase from Escherichia coli. With 12$\mu$M thioredoxin and 0.1 $\mu$M thioredoxin reductase at pH 7 all disulfide bonds in the $\alpha$ subunit could be reduced in 15 min. The reduction of disulfide bonds was recorded by a simple spectrophotometric assay at 340 nm, which allowed quantitation of the reduction rate and the number of disulfide bonds reduced. Partial reduction of the $\alpha$ subunit with thioredoxin followed by S‐carboxymethylation with iodo[2‐3H]acetic acid and analysis of tryptic peptides indicated that all S‐S bonds in the a subunit were surface oriented and equally reactive. The usefulness of thioredoxin reducide bonds as a chemical probe of protein structure was shown by the much slower reaction of disulfide bonds in the intact hormone as compared to its two biologically inactive subunits. Copyright {\textcopyright} 1976, Wiley Blackwell. All rights reserved},
