@article{Ramirez2018,
abstract = {Much has been speculated about how the Great Pyramid was constructed, as well as the rule used to determine its proportions. Two main theories have been proposed for this last point: one stating that Pi was used to set the proportion base-height, the other that this proportion was determined using the Golden Ratio Phi. The interesting point is that both theories fits the Great Pyramid proportions with two or three decimals precision, good enough for construction's purposes. Using this fact, it is shown in this paper that several algebraic relationships can be set between Pi and the Golden Ratio at the same precision. Exact transcendental Pi-Phi relationships can be also obtained from the Great Pyramid geometry. It is also shown in this paper that these relationships between Pi and Phi only happens for the square pyramid's geometry.},
author = {Ramirez, Miguel R and Park, Galena and School, High},
keywords = {important doc},
mendeley-tags = {important doc},
number = {1},
pages = {1--11},
title = {{the Great Pyramid of Giza, Pi, and the Golden Ratio}},
year = {2018}
}
