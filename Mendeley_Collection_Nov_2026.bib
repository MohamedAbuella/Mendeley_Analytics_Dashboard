isbn = {1540-7977 VO - 13},
issn = {15407977},
journal = {IEEE Power and Energy Magazine},
number = {3},
pages = {67--80},
title = {{Streetlights are getting smarter: Integrating an intelligent communications and control system to the current infrastructure}},
