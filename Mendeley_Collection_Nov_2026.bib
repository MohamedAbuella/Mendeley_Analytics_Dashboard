issn = {0041-1655},
journal = {Transportation Science},
keywords = {berth allocation problem,container terminal,cooperative game theory,exact methods,optimization,speed,transportation},
number = {Imo 2018},
title = {{The Multiport Berth Allocation Problem with Speed Optimization: Exact Methods and a Cooperative Game Analysis}},
volume = {i},
year = {2022}
