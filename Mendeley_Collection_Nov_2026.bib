pages = {571--580},
publisher = {The Authors},
title = {{Value of gas network infrastructure flexibility in supporting cost effective operation of power systems}},
url = {http://dx.doi.org/10.1016/j.apenergy.2017.05.132},
volume = {202},
year = {2017}
}
