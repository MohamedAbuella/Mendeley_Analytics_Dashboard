arxivId = {physics/9810036},
author = {Hoffert, Martin I. and Caldeira, Ken and Jain, Atul K. and Haites, Erik F. and Harvey, L. D. Danny and Potter, Seth D. and Schlesinger, Michael E. and Schneider, Stephen H. and Watts, Robert G. and Wigley, Tom M. L. and Wuebbles, Donald J.},
