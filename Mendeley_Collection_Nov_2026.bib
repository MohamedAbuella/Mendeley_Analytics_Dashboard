publisher = {Elsevier Ltd},
title = {{Numerical methods for monitoring and evaluating the biofouling state and effects on vessels' hull and propeller performance: A review}},
url = {https://doi.org/10.1016/j.oceaneng.2022.110883},
volume = {251},
