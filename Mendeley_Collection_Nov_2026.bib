journal = {IEEE Transactions on Wireless Communications},
keywords = {Cognitive small cell,GT,OFDMA,OR,Resource allocation,Very High cited doc,cooperative game,power control},
mendeley-tags = {GT,OR,Very High cited doc},
number = {6},
pages = {3481--3493},
