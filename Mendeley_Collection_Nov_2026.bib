issn = {03603199},
journal = {International Journal of Hydrogen Energy},
keywords = {EnergPolicy,Energy system modelling,Expansion planning,GASnets,Hydrogen,Multi-Vector Energy System,OR,Sector coupling,TEA,Theoretical Background,important doc,review},
