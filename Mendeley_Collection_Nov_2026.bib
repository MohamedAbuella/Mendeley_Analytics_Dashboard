@article{HassanzadehMoghimi2024,
abstract = {Policymakers face the challenge of integrating intermittent output from variable renewable energy (VRE). Even in a well-functioning power sector with flexible generation, producers' incentives may not align with society's welfare-maximisation objective. At the same time, political pressure can obstruct policymakers from pricing damage from CO2 emissions according to its social costs. In facilitating decarbonisation, transmission planning will have to adapt to such economic and environmental distortions. Using a Stackelberg model of the Nordic power sector, we find that a first-best transmission-expansion plan involves better resource sharing between zones, which actually reduces the need for some VRE adoption. Next, we allow for departures from perfect competition and identify an extended transmission-expansion plan under market power by nuclear plants. By contrast, temporal arbitrage by hydro reservoirs does not necessitate transmission expansion beyond that of perfect competition because it incentivises sufficient VRE adoption using existing lines. Meanwhile, incomplete CO2 pricing under perfect competition requires a transmission plan that matches hydro-rich zones with sites for VRE adoption. However, since incomplete CO2 pricing leaves fossil-fuelled generation economically viable, it reduces the leverage of strategic producers, thereby catalysing less (more) extensive transmission expansion under market power by nuclear (hydro) plants.},
author = {{Hassanzadeh Moghimi}, Farzad and Boomsma, Trine K. and Siddiqui, Afzal S.},
doi = {10.1016/j.eneco.2024.107610},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Hassanzadeh Moghimi, Boomsma, Siddiqui - 2024 - Transmission planning in an imperfectly competitive power sector with environmental exte.pdf:pdf},
issn = {01409883},
journal = {Energy Economics},
keywords = {Electricity markets,EnergPolicy,Environmental policy,GASnets,GT,GT-IES,Game theory,Hydropower,Market power,Multi-Vector Energy System,OR,Theoretical Background,Transmission planning,important doc},
mendeley-tags = {EnergPolicy,GASnets,GT,GT-IES,Multi-Vector Energy System,OR,Theoretical Background,important doc},
number = {May},
pages = {107610},
publisher = {Elsevier B.V.},
title = {{Transmission planning in an imperfectly competitive power sector with environmental externalities}},
url = {https://doi.org/10.1016/j.eneco.2024.107610},
volume = {134},
year = {2024}
}
