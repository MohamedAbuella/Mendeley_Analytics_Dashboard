@techreport{Chongfuangprinya,
abstract = {Panel Abstract Because of uncertainties from distributed energy resources (DER), operation of the grid with integrated DER to decarbonize the energy sector becomes more complex and dynamic for grid operator. Various operational challenges such as voltage control and fault management play a critical role in ensuring the security, economics, and efficiency of electricity delivery. In recent years, we have seen a remarkable amount of work applying artificial intelligent (AI) algorithm to address such challenges. The objective of this panel is to share state-of-art multidisciplinary and multi-industry research work demonstrating the impact of AI-based research on electricity infrastructure and grid control. Multiple panelists will discuss and demonstrate how AI-based solutions can solved the challenges of distribution power grid with DERs to facilitate reproducibility of these works and future research in AI-based power system automatic control. Topics include (1) AI-based control framework for volt/var management, (2) AI-Grid, autonomous grid designed to keep power infrastructure resilient from cyberattacks, faults and disastrous accidents, (3) Micro Grid Control, and (4) Demonstration of AI-based control on utility testbed.},
author = {Chongfuangprinya, Panitarn and America, Hitachi},
