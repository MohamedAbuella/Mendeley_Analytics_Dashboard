keywords = {Biogas catalytic reforming,Green hydrogen,Hydrogen,Membrane-based CO2 capture,OR,Pre- and post-combustion CO2 capture,TEA,Techno-economic and environmental assessment (TEEA,important doc},
mendeley-tags = {Hydrogen,OR,TEA,important doc},
number = {December 2024},
pages = {702--711},
publisher = {Elsevier Ltd},
title = {{Techno-economic and environmental assessment of green hydrogen production via biogas reforming with membrane-based CO2 capture}},
