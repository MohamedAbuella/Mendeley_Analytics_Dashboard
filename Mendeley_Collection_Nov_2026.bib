isbn = {9781728182988},
journal = {2020 IEEE Global Communications Conference, GLOBECOM 2020 - Proceedings},
keywords = {LSTM,fast uplink grant,internet of things,long short-term Memory,machine type communications,recurrent neural network,source traffic prediction},
