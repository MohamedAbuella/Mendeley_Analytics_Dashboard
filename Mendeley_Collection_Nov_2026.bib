issn = {03603199},
journal = {International Journal of Hydrogen Energy},
keywords = {Combined gas and electricity networks,EnergPolicy,GASnets,Hydrogen,Hydrogen electrolysis,Multi-Vector Energy System,OR,Power-to-gas,Theoretical Background,Very High cited doc,important doc},
