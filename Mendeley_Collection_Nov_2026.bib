file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Conselice et al. - 2016 - THE EVOLUTION OF GALAXY NUMBER DENSITY AT z 8 AND ITS IMPLICATIONS(3).pdf:pdf},
issn = {15384357},
journal = {The Astrophysical Journal},
keywords = {Theoretical Background,Very High cited doc,evolution,fundamental parameters,galaxies,galaxies: evolution,galaxies: fundamental parameters,galaxies: general,galaxies: high-redshift,galaxies: luminosity function,galaxies: structure,general,high-redshift,important doc,luminosity function,mass function,structure},
