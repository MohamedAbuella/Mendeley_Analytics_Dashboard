issn = {2076-3417},
journal = {Applied Sciences},
keywords = {difference degree,elastic net,gmdh,lasso,neural network,short-term load forecasting},
number = {9},
pages = {1603},
title = {{Short-Term Load Forecasting Based on Elastic Net Improved GMDH and Difference Degree Weighting Optimization}},
url = {http://www.mdpi.com/2076-3417/8/9/1603},
volume = {8},
