journal = {IEEE Access},
keywords = {AC machines,Automotive engineering,electric vehicles,permanent magnet machines,robustness,sensitivity analysis,statistics,time series analysis},
pages = {23454--23471},
publisher = {Institute of Electrical and Electronics Engineers Inc.},
title = {{Overview of Sensitivity Analysis Methods Capabilities for Traction AC Machines in Electrified Vehicles}},
