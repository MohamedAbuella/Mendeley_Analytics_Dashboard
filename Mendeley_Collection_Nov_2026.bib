issn = {18790690},
journal = {Renewable and Sustainable Energy Reviews},
keywords = {Curtailment ratio,Penetration ratio,Photovoltaic (PV),RE Teaching,Solar power,Theoretical Background,VRE (Variable renewable energy),Wind power,important doc,review},
