@article{Vespe2012,
abstract = {Maritime anomaly detection requires an efficient representation and consistent knowledge of vessel behaviour. Automatic Identification System (AIS) data provides ships state vector and identity information that is here used to automatically derive knowledge of maritime traffic in an unsuper-vised way. The proposed approach only utilises AIS data, historical or real-time, and is aimed at incrementally learning motion patterns without any specific a priori contextual description. This can be applied to a single AIS terrestrial receiver, to regional networks or to global scale tracking. The maritime traffic representation underpins low-likelihood behaviour detection and supports enhanced Maritime Situational Awareness by providing a characterisation of vessels traffic.},
author = {Vespe, Michele and Visentini, Ingrid and Bryan, Karna and Braca, Paolo},
