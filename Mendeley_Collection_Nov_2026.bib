@article{Feng2018b,
abstract = {Solar forecasting accuracy is affected by weather conditions, and weather awareness forecasting models are expected to improve the performance. However, it may not be available and reliable to classify different forecasting tasks by using only meteorological weather categorization. In this paper, an unsupervised clustering-based (UC-based) solar forecasting methodology is developed for short-term (1-hour-ahead) global horizontal irradiance (GHI) forecasting. This methodology consists of three parts: GHI time series unsupervised clustering, pattern recognition, and UC-based forecasting. The daily GHI time series is first clustered by an Optimized Cross-validated ClUsteRing (OCCUR) method, which determines the optimal number of clusters and best clustering results. Then, support vector machine pattern recognition (SVM-PR) is adopted to recognize the category of a certain day using the first few hours' data in the forecasting stage. GHI forecasts are generated by the most suitable models in different clusters, which are built by a two-layer Machine learning based Multi-Model (M3) forecasting framework. The developed UC-based methodology is validated by using 1-year of data with six solar features. Numerical results show that (i) UC-based models outperform non-UC (all-in-one) models with the same M3 architecture by approximately 20%; (ii) M3-based models also outperform the single-algorithm machine learning (SAML) models by approximately 20%.},
archivePrefix = {arXiv},
arxivId = {1805.04193},
author = {Feng, Cong and Member, Student and Cui, Mingjian and Hodge, Bri-mathias and Member, Senior},
eprint = {1805.04193},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Feng et al. - 2018 - An Unsupervised Clustering-Based Short-Term Solar Forecasting Methodology Using Multi-Model Machine Learning Blendi.pdf:pdf},
keywords = {important doc,post-processing},
mendeley-tags = {important doc,post-processing},
pages = {1--11},
title = {{An Unsupervised Clustering-Based Short-Term Solar Forecasting Methodology Using Multi-Model Machine Learning Blending. (arXiv:1805.04193v1 [cs.LG])}},
url = {http://arxiv.org/abs/1805.04193},
year = {2018}
}
@article{Sideratos2020,
abstract = {Accurate predictions for solar and wind power generation are necessary for the secure and economic operation of a power system with significant penetration of these renewable energy sources. In this paper, a novel prediction model to forecast the power produced by both variable energy sources is proposed. The proposed model applies radial basis functions neural networks (RBFNN) for both clustering and regression tasks. Initially, a novel RBFNN clusters the input data in several overlapping areas based on their variable importance using multi-width radial basis functions (RBFs). The RBFs are designed so that every input vector activates more than one cluster in order to finally produce an ensemble of predictions. Using the above RBFNN clusterer, input subsets are created and processed by RBFNNs designed to make predictions (regressors). Every RBFNN regressor uses also multi-width RBFs based on a novel basis function optimized by the Adam algorithm. The proposed model is developed using the TensorFlow deep learning framework. The proposed model is robust to the high dimensionality of systems and can learn large training datasets with high accuracy. It is self-constructive and can operate in both online and off-line mode. Results from two solar and two wind power forecasting applications are presented to show the effectiveness of the proposed model. Moreover, the model is benchmarked against the performance of state-of-the-art prediction methods.},
author = {Sideratos, George and Hatziargyriou, Nikos D.},
doi = {10.1016/j.ijepes.2020.106041},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Sideratos, Hatziargyriou - 2020 - A distributed memory RBF-based model for variable generation forecasting.pdf:pdf},
issn = {01420615},
journal = {International Journal of Electrical Power and Energy Systems},
keywords = {Deep learning,Multi-width RBF,RES forecasting,Radial basis function neural network},
number = {May 2019},
pages = {106041},
publisher = {Elsevier},
title = {{A distributed memory RBF-based model for variable generation forecasting}},
url = {https://doi.org/10.1016/j.ijepes.2020.106041},
volume = {120},
year = {2020}
}
