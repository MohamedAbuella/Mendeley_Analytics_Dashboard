isbn = {0038092X},
issn = {0038092X},
journal = {Solar Energy},
keywords = {CSP-FoSyS,DNI,Direct normal irradiance,Irradiance forecast,Model output statistics,Plant simulation,Scholar_abs_solar_post,post-processing},
mendeley-tags = {Scholar_abs_solar_post,post-processing},
pages = {244--255},
