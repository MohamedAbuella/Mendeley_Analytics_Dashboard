@article{Lin1996a,
abstract = {-It has recently been shown that gradient-descent learning algorithms for recurrent neural networks can perform poorly on tasks that involve long-term dependencies, i.e., those problems for which the desired output depends on inputs pre-sented at times far in the past. We show that the long-term dependencies problem is lessened for a class of architectures called Nonlinear AutoRegressive models with exogenous (NARX) recurrent neural networks, which have powerful representa-tional capabilities. We have previously reported that gradient descent learning can be more effective in NARX networks than in recurrent neural network architectures that have " hidden states " on problems including grammatical inference and nonlin-ear system identification. Typically, the network converges much faster and generalizes better than other networks. The results in this paper are consistent with this phenomenon. We present some experimental results which show that NARX networks can often retain information for two to three times as long as conventional recurrent neural networks. We show that although NARX networks do not circumvent the problem of long-term dependencies, they can greatly improve performance on long-term dependency problems. We also describe in detail some of the assumption regarding what it means to latch information robustly and suggest possible ways to loosen these assump-tions.},
author = {Lin, Tsungnan and Horne, Bill G and Tiiio, Peter and Giles, C Lee},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Lin et al. - 1996 - Learning Long-Term Dependencies in(2).pdf:pdf},
journal = {IEEE Transactions on Neural Networks},
keywords = {LLM,LSTM,Technical report of california institute for energ,Very High cited doc,important doc},
mendeley-tags = {LLM,LSTM,Technical report of california institute for energ,Very High cited doc,important doc},
number = {6},
pages = {1329--1338},
title = {{Learning Long-Term Dependencies in NARX Recurrent Neural Networks}},
url = {https://pdfs.semanticscholar.org/f62c/3868ebabb5d84bfcf1c5eae6d72d5fb33125.pdf},
volume = {7},
year = {1996}
}
@article{Lara-Benitez2021,
abstract = {In recent years, deep learning techniques have outperformed traditional models in many machine learning tasks. Deep neural networks have successfully been applied to address time series forecasting problems, which is a very important topic in data mining. They have proved to be an effective solution given their capacity to automatically learn the temporal dependencies present in time series. However, selecting the most convenient type of deep neural network and its parametrization is a complex task that requires considerable expertise. Therefore, there is a need for deeper studies on the suitability of all existing architectures for different forecasting tasks. In this work, we face two main challenges: a comprehensive review of the latest works using deep learning for time series forecasting and an experimental study comparing the performance of the most popular architectures. The comparison involves a thorough analysis of seven types of deep learning models in terms of accuracy and efficiency. We evaluate the rankings and distribution of results obtained with the proposed models under many different architecture configurations and training hyperparameters. The datasets used comprise more than 50,000 time series divided into 12 different forecasting problems. By training more than 38,000 models on these data, we provide the most extensive deep learning study for time series forecasting. Among all studied models, the results show that long short-term memory (LSTM) and convolutional networks (CNN) are the best alternatives, with LSTMs obtaining the most accurate forecasts. CNNs achieve comparable performance with less variability of results under different parameter configurations, while also being more efficient.},
archivePrefix = {arXiv},
arxivId = {2103.12057},
author = {Lara-Ben{\'{i}}tez, Pedro and Carranza-Garc{\'{i}}a, Manuel and Riquelme, Jos{\'{e}} C.},
doi = {10.1142/S0129065721300011},
eprint = {2103.12057},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Lara-Ben{\'{i}}tez, Carranza-Garc{\'{i}}a, Riquelme - 2021 - An Experimental Review on Deep Learning Architectures for Time Series Forecasting(3).pdf:pdf},
issn = {17936462},
journal = {International Journal of Neural Systems},
keywords = {Deep learning,forecasting,review,shipping,time series},
mendeley-tags = {shipping},
number = {3},
pages = {1--25},
pmid = {33588711},
title = {{An Experimental Review on Deep Learning Architectures for Time Series Forecasting}},
volume = {31},
year = {2021}
}
