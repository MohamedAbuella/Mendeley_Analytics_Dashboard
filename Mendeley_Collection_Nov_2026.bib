file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Huang et al. - 2018 - Accelerated Evaluation of Automated Vehicles Using Piecewise Mixture Models(2).pdf:pdf},
issn = {15249050},
journal = {IEEE Transactions on Intelligent Transportation Systems},
keywords = {Automated vehicles,evaluation,safety,testing},
number = {9},
pages = {2845--2855},
publisher = {IEEE},
title = {{Accelerated Evaluation of Automated Vehicles Using Piecewise Mixture Models}},
volume = {19},
year = {2018}
}
