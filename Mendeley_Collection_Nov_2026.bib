}
@article{Dehghan2024,
abstract = {Natural gas is the primary energy source for the UK's heat sector, contributing to about one-third of annual carbon emissions. Furthermore, heating in buildings contributes to about 20% of annual carbon emissions. The heat sector is one of the most challenging sectors for decarbonisation. However, heat electrification in the UK's buildings could substantially reduce carbon emissions. This transition could result in substantial reductions in energy system costs because of cross-vector flexibility in the integrated energy sectors. There may be geographical barriers to implementing district heating networks. However, centralised electric heating can offer greater efficiency benefits compared to decentralised solutions, resulting in substantial cost savings. This paper aims to evaluate the whole-system value of centralised electrified heating to partially supply the UK's heat demand in 2035, compared to decentralised solutions. The results indicate that centralised electric heating can lead to significant reductions in annual peak demand, installed capacities of renewables and storages, and consequently, substantial overall system cost savings compared to a decentralised paradigm. Implementing centralised electric heating to partially supply 30% of the electrified heat demand is found to reduce the overall system costs by up to {\pounds}1.57bn/yr compared to decentralised solutions to fully supply the electrified heat demand.},
author = {Dehghan, Shahab and Aunedi, Marko and Ameli, Hossein and Strbac, Goran},
doi = {10.1016/j.epsr.2024.110144},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Dehghan et al. - 2024 - Whole-system value of electrified district heating networks in decarbonising heat sector in the UK.pdf:pdf},
