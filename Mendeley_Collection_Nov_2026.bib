issn = {15249050},
journal = {IEEE Transactions on Intelligent Transportation Systems},
keywords = {Traffic signal optimization,V2I cooperation,connected automated vehicle,fuel consumption,intelligent transportation systems,travel time,vehicle speed control},
number = {4},
pages = {1390--1403},
publisher = {IEEE},
title = {{Cooperative Method of Traffic Signal Optimization and Speed Control of Connected Vehicles at Isolated Intersections}},
volume = {20},
