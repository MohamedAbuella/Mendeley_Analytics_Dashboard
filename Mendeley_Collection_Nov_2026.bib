issn = {2211467X},
journal = {Energy Strategy Reviews},
keywords = {Denmark,Energy systems analysis,Energy transition,Heating,Hydrogen,Model application,Model description,OR,TEA,TIMES model,Theoretical Background,Very High cited doc},
