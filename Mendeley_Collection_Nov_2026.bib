journal = {Solar Energy},
keywords = {DNI,Direct and global irradiance,High cited doc,Interannual,Solar resource,Suncast73-75,Validation,Variability,post-processing},
mendeley-tags = {High cited doc,Suncast73-75,post-processing},
number = {5},
