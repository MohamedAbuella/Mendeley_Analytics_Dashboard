keywords = {Hydrogen,Hydrogen cleanness index,Hydrogen economy,Hydrogen production,Hydrogen square,RE Teaching,Theoretical Background,Very High cited doc,review},
mendeley-tags = {Hydrogen,RE Teaching,Theoretical Background,Very High cited doc,review},
number = {7},
pages = {3847--3869},
publisher = {Elsevier Ltd},
title = {{Hydrogen production for energy: An overview}},
url = {https://doi.org/10.1016/j.ijhydene.2019.12.059},
volume = {45},
