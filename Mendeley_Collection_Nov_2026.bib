@article{Rigoni2022,
abstract = {Unlocking the potential flexibility of distributed energy resources (DERs) will be key towards integrating large penetrations of renewable generation. However, exploiting such a resource requires operators and aggregators to consider the operational constraints of the local grid. The challenge is that the access to modelling tools, which consider such constraints, for the development of novel solutions is limited. Therefore, this work introduces a free open-source python-based toolkit for the solution of the optimal day-ahead scheduling problem for domestic-scale DERs in low voltage distribution grids. Multiple resources such as photovoltaics, energy storage systems and electric vehicles are included. To account for the grid constraints, the three-phase unbalanced power flow equations are embedded into the model, which is available for 6 real British networks modelled in EPRI's OpenDSS. Crucially, all models are open for user modification, meaning that new DERs, networks, and objective functions can be incorporated.},
author = {Rigoni, Valentin and Keane, Andrew},
doi = {10.1109/OSMSES54027.2022.9769132},
