issn = {15580016},
journal = {IEEE Transactions on Intelligent Transportation Systems},
keywords = {Traffic forecasting,spatial dependence,temporal dependence,temporal graph convolutional network (T-GCN)},
number = {9},
pages = {3848--3858},
publisher = {IEEE},
title = {{T-GCN: A Temporal Graph Convolutional Network for Traffic Prediction}},
