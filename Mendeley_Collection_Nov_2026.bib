title = {{A Scientific Perspective on Big Data in Earth Observation}},
year = {2020}
}
@article{Murray2021,
abstract = {This study presents a deep learning framework to support regional ship behavior prediction using historical AIS data. The framework is meant to aid in proactive collision avoidance, in order to enhance the safety of maritime transportation systems. In this study, it is suggested to decompose the historical ship behavior in a given geographical region into clusters. Each cluster will contain trajectories with similar behavior characteristics. For each unique cluster, the method generates a local model to describe the local behavior in the cluster. In this manner, higher fidelity predictions can be facilitated compared to training a model on all available historical behavior. The study suggests to cluster historical trajectories using a variational recurrent autoencoder and the Hierarchical Density-Based Spatial Clustering of Applications with Noise algorithm. The past behavior of a selected vessel is then classified to the most likely clusters of behavior based on the softmax distribution. Each local model consists of a sequence-to-sequence model with attention. When utilizing the deep learning framework, a user inputs the past trajectory of a selected vessel, and the framework outputs the most likely future trajectories. The model was evaluated using a geographical region as a test case, with successful results.},
author = {Murray, Brian and Perera, Lokukaluge Prasad},
doi = {10.1016/j.ress.2021.107819},
issn = {09518320},
journal = {Reliability Engineering and System Safety},
keywords = {AIS,Collision avoidance,Deep learning,Maritime safety,Maritime situation awareness,Ship navigation,Trajectory prediction,shipping},
mendeley-tags = {shipping},
number = {June},
pages = {107819},
publisher = {Elsevier Ltd},
title = {{An AIS-based deep learning framework for regional ship behavior prediction}},
url = {https://doi.org/10.1016/j.ress.2021.107819},
volume = {215},
year = {2021}
}
@article{Zeng2020,
abstract = {The conventional extrapolation of ship resistance from model tests to full scale presumes that the coefficient of wave-making resistance (Cw) depends on the Froude number only. This leads to the assumption that Cw of a ship is identical to Cw of its scaled model. However, this assumption is challenged in shallow water due to viscous effects, which are represented by the Reynolds number (Re). In this study, different scales (different Re) of the Wigley hull and the KCS hull are used to investigate the scale effects on Cw numerically. After verification and validation, systematic computations are performed for both ships and their scaled models in various shallow-water conditions. Based on the results, significantly larger values of Cw are found for the KCS at model scale in very shallow water, suggesting that the conventional extrapolation has to be reconsidered. Additionally, this study reveals the relationship between the changes in frictional resistance coefficient (Cf) and the changes in Cw caused by shallow water, which benefits the prediction of shallow water effects on Cw. Finally, use of a larger ship model, where the Re is also higher, is recommended for resistance tests in shallow water to reduce scale effects on Cw.},
author = {Zeng, Qingsong and Hekkenberg, Robert and Thill, Cornel and Hopman, Hans},
doi = {10.1016/j.oceaneng.2020.107654},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Zeng et al. - 2020 - Scale effects on the wave-making resistance of ships sailing in shallow water.pdf:pdf},
issn = {00298018},
journal = {Ocean Engineering},
keywords = {PhyML,Resistance extrapolation,SSS,Scale effect,Shallow water,WSR,Wave-making resistance,shipping},
mendeley-tags = {PhyML,SSS,WSR,shipping},
number = {May},
pages = {107654},
publisher = {Elsevier Ltd},
title = {{Scale effects on the wave-making resistance of ships sailing in shallow water}},
url = {https://doi.org/10.1016/j.oceaneng.2020.107654},
volume = {212},
year = {2020}
}
