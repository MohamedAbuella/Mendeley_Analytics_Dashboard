issn = {23523409},
journal = {Data in Brief},
keywords = {Energy policy,Energy system modelling,Energy transition,Hydrogen,Hydrogen economy,OSeMOSYS,TEA,important doc},
mendeley-tags = {Hydrogen,OSeMOSYS,TEA,important doc},
pages = {109822},
