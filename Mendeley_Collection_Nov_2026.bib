file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Pourmaleki et al. - 2022 - Techno-Economic Analysis of a 12-kW Photovoltaic System Using an Efficient Multiple Linear Regression Mode(2).pdf:pdf},
