journal = {Renewable and Sustainable Energy Reviews},
keywords = {Alternative power sources,Eco-friendly fuels,Shipping,CO2 emissions,Energy efficiency,Eco-frien,Sustainable energy},
number = {September},
pages = {110222},
publisher = {Elsevier Ltd},
title = {{A comprehensive review on countermeasures for CO2 emissions from ships}},
