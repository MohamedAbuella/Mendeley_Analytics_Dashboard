issn = {20755309},
journal = {Buildings},
keywords = {barriers,buildings,infrastructure solar PV,multiple linear regression model (MLRM),renewable energy,rule-based decision support system (RBDSS)},
month = {jul},
number = {7},
publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
title = {{Factors Hindering Solar Photovoltaic System Implementation in Buildings and Infrastructure Projects: Analysis through a Multiple Linear Regression Model and Rule-Based Decision Support System}},
volume = {13},
year = {2023}
