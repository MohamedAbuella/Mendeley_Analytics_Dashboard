file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Wenhai et al. - 2019 - Successful blue economy examples with an emphasis on international perspectives(2).pdf:pdf},
issn = {22967745},
journal = {Frontiers in Marine Science},
keywords = {Blue economy,Data analysis and information delivery,Deep ocean stewardship,Ecological restoration,Macro-economic control policies,SSS,Science-based products,Very High cited doc,shipping},
mendeley-tags = {SSS,Very High cited doc,shipping},
number = {JUN},
