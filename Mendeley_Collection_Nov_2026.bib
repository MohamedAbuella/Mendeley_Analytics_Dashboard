journal = {IET Generation, Transmission and Distribution},
keywords = {Heating,Integrated energy system,Multi-Vector Energy System,OR,Theoretical Background,coordinated planning,evaluation indexes,important doc,renewable energy,uncertainties},
mendeley-tags = {Heating,Multi-Vector Energy System,OR,Theoretical Background,important doc},
number = {14},
pages = {3232--3244},
title = {{Coordinated planning of integrated electricity–heat–gas energy system considering renewable energy consumption}},
