issn = {20452322},
journal = {Scientific Reports},
keywords = {Heating,Hydrogen,Multi-Vector Energy System,OR,TEA,review},
mendeley-tags = {Heating,Hydrogen,Multi-Vector Energy System,OR,TEA,review},
number = {1},
pages = {1--14},
pmid = {36959198},
publisher = {Nature Publishing Group UK},
title = {{Simulating flexibility, variability and decentralisation with an integrated energy system model for Great Britain}},
url = {https://doi.org/10.1038/s41598-023-31257-9},
volume = {13},
year = {2023}
}
