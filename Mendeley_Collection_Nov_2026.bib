mendeley-tags = {EnergPolicy,OR,OSeMOSYS,Very High cited doc},
month = {oct},
number = {10},
pages = {5850--5870},
title = {{OSeMOSYS: The Open Source Energy Modeling System. An introduction to its ethos, structure and development.}},
volume = {39},
year = {2011}
