issn = {0038092X},
journal = {Solar Energy},
keywords = {Computer vision,Deep learning,Fish-eye camera,PV output prediction,RE Teaching,Ramp PV,Sky images,Solar forecasting,important doc,post-processing},
mendeley-tags = {RE Teaching,Ramp PV,important doc,post-processing},
pages = {171--179},
title = {{SKIPP'D: A SKy Images and Photovoltaic Power Generation Dataset for short-term solar forecasting}},
