keywords = {Autonomous ships,GNN,Multi-scale map,Ship route planning,Visibility graph,shipping},
mendeley-tags = {GNN,shipping},
number = {June 2020},
pages = {108242},
publisher = {Elsevier Ltd},
title = {{Long-voyage route planning method based on multi-scale visibility graph for autonomous ships}},
url = {https://doi.org/10.1016/j.oceaneng.2020.108242},
volume = {219},
year = {2021}
