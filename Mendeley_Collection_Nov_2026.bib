journal = {Proceedings of the 8th International Conference on Signal Processing and Integrated Networks, SPIN 2021},
keywords = {Convolution neural network (CNN),Local Binary Pattern (LBP),histopathology images},
pages = {755--759},
title = {{Classification of Breast Cancer Histopathological Images using Convolutional Neural Networks}},
year = {2021}
}
