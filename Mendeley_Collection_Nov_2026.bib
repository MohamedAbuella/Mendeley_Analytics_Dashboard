mendeley-tags = {EnergPolicy,GT,Heating,High cited doc,Hydrogen,OR,RE Teaching,TEA,Theoretical Background,important doc},
pages = {122435},
publisher = {Elsevier Ltd},
title = {{A Nash bargaining-based cooperative planning and operation method for wind-hydrogen-heat multi-agent energy system}},
