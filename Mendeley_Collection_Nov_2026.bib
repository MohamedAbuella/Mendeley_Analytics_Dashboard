@article{Pecenak2017,
abstract = {IEEE Quasi static time-series simulations (QSTS) of distribution feeders are a critical element of distributed solar PV integration studies. QSTS are typically carried out through computer simulation tools such as OpenDSS. Since a typical feeder contains thousands of buses, for long investigation periods or at fine time scales such simulations are computationally costly. Simulation times are reduced in this paper through a reduction of the number of buses in the model. The feeder reduction algorithm considers p-phase distribution feeders with unbalanced loads and PV, unbalanced wire impedance, mutual coupling, and shunt capacitance, while preserving the spatial variation of load and generation. An extensive Monte Carlo sensitivity analysis was performed on a real feeder from a California utility. All bus voltage differences are found to be less than 1.13% with a root mean square error of 0.21%. Simulation time savings were up to 96% when only one bus is selected to remain in the model. Example applications of the proposed algorithm are interconnection studies of utility-scale PV system to the distribution grid, siting analyses of other distributed energy resources (DERs), and dynamic behavior of devices in large systems such as smart inverters on distribution grids.},
author = {Pecenak, Z.K. and Disfani, V.R. and Reno, M.J. and Kleissl, J.},
doi = {10.1109/TPWRS.2017.2726502},
file = {::},
issn = {08858950},
journal = {IEEE Transactions on Power Systems},
keywords = {Distribution system,mutual impedance,network reduction,quasi static time-series simulations,sky imager,spatiotemporal photovoltaic forecast},
number = {2},
pages = {1320--1328},
title = {{Multiphase distribution feeder reduction}},
volume = {33},
year = {2017}
}
@article{Bocchetti2013,
abstract = {Due to the growth of competitiveness imposed by the shipping market and attention to the reduction of environmental impacts, many shipping companies are applying a policy of resources rationalization. Therefore, proper and continuous monitoring of the fuel consumption arc a crucial task to detect any progress after planned improving actions. Through multiple linear regression analysis, this paper proposes a statistical model which allows practitioners to exploit navigation information usually available from board sensors. In particular, the proposed model allows fuel consumption, and therefore CO2 emissions, to be predicted from a set of navigation parameters which describe the mission profile. Moreover, it allows us to estimate the confidence region and prediction intervals for the fuel consumption. The latter can be used to control the fuel consumption by comparing the actual fuel consumption to the prediction limits expected by the model for given mission profile.},
author = {Bocchetti, D. and Lepore, A. and Palumbo, B. and Vitiello, L.},
