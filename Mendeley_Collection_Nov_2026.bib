eprint = {1603.04467v2},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Weinman, Lidaka, Aggarwal - 2011 - TensorFlow Large-scale machine learning.pdf:pdf},
isbn = {9780123849885},
