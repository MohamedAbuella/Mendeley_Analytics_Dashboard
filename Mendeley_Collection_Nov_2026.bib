journal = {Maritime Business Review},
keywords = {Capacity utilisation factor,Market structure analysis,North-east Asian market,Short sea shipping},
month = {nov},
number = {4},
pages = {414--429},
publisher = {Emerald Group Holdings Ltd.},
title = {{Market structure of short sea shipping in northeast Asia}},
volume = {6},
