keywords = {E-navigation,Energy efficiency,Libya,Space technologies,WSR,Weather routing,shipping},
mendeley-tags = {Libya,WSR,shipping},
pages = {462--471},
title = {{Preliminary assessment of route optimisation for fuel minimisation and safety of navigation by the use of cooperatively collected data at sea}},
