isbn = {9783030972394},
issn = {16113349},
keywords = {AIS,Destination prediction,Graph model,Heterogeneous graph,Link prediction,Machine learning,Maritime transportation},
pages = {80--93},
publisher = {Springer Science and Business Media Deutschland GmbH},
title = {{Vessel Destination Prediction Using a Graph-Based Machine Learning Model}},
volume = {13197 LNCS},
year = {2022}
