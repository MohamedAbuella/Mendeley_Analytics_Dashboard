@book{Buizza2018,
abstract = {Weather affects many human activities, and this is why people try to understand and predict it. Since 1950, weather forecasts have been produced using dynamical methods. More precisely, up to the early 1990s, weather products were generated using one, single forecast. The problem that weather forecasters and their users had to face was that these single forecasts were diverging from reality (i.e., from the atmosphere trajectory) from early forecast ranges, without the forecasters having any knowledge about when this would occur. This divergence between a forecast and reality happens because of the chaotic growth of forecast errors, linked to uncertainties in the knowledge of the initial state, and because of model approximations. The chaotic nature of the atmosphere makes the problem very difficult, because it causes even very small errors to affect a forecast after only few days. Ensembles have been developed in the past 25years to provide forecasters and users with a forecast confidence level, a measure of how accurate the forecast could be. They have been designed to try to simulate all relevant sources of forecast error. Compared with single forecasts, they provide more complete information on the possible future states of the Earth system, because they allow users to estimate, in an objective and reliable way, the range of possible future scenarios. Today, eight operational global ensembles generate more than 500 forecasts a day for the whole globe. One key component of an ensemble suite that is included in some of the most advanced ensembles to estimate the model climate is the reforecast suite. Reforecasts can be used to estimate the ensemble key characteristics (reliability and accuracy) and their capability to predict phenomena. The reforecast datasets are a key resource that can help forecasters extract signals from ensembles, and correct the raw forecasts using statistics based on past performance. This chapter will focus on global ensembles, but most of the concepts and the techniques discussed hereafter are relevant also for limited-area, short-range ensemble prediction. The future will see an increasing use of dynamical ensembles in the short- and the medium-range, and in the sub-seasonal and the seasonal time range, to provide reliable and accurate estimates of the forecast probability density function (PDF). Ensembles will be increasingly used also in data assimilation to provide estimates of the analysis and reanalysis PDF. Furthermore, ensembles will be used more extensively to understand future climate scenarios.},
author = {Buizza, Roberto},
booktitle = {Statistical Postprocessing of Ensemble Forecasts},
doi = {10.1016/B978-0-12-812372-0.00002-9},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Buizza - 2018 - Ensemble Forecasting and the Need for Calibration.pdf:pdf},
isbn = {9780128123720},
keywords = {Dynamical weather prediction,Ensemble prediction,Forecast errors,Predictability,Probabilistic prediction,post-processing},
mendeley-tags = {post-processing},
pages = {15--48},
publisher = {Elsevier Inc.},
title = {{Ensemble Forecasting and the Need for Calibration}},
url = {http://linkinghub.elsevier.com/retrieve/pii/B9780128123720000029},
year = {2018}
}
