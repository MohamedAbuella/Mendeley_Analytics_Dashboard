mendeley-tags = {OR,PhyML,RL,Very High cited doc,important doc,review},
number = {4},
pages = {3201--3211},
title = {{A Multi-Agent Reinforcement Learning-Based Data-Driven Method for Home Energy Management}},
volume = {11},
year = {2020}
