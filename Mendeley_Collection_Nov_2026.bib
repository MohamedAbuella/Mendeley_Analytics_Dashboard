issn = {03062619},
journal = {Applied Energy},
keywords = {Data-driven,Energy efficiency,Machine learning,Predictive control,Reinforcement learning,Wastewater treatment plant},
title = {{Data-driven predictive energy optimization in a wastewater pumping station}},
volume = {252},
year = {2019}
}
