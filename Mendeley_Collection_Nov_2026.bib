pages = {1166--1177},
publisher = {Elsevier Ltd},
title = {{Solar irradiance forecasting at one-minute intervals for different sky conditions using sky camera images}},
url = {http://dx.doi.org/10.1016/j.enconman.2015.09.001},
volume = {105},
year = {2015}
