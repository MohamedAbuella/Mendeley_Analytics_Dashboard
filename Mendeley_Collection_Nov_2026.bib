@article{Wang2019h,
abstract = {The past decade has witnessed the rapid evolution in blockchain technologies, which has attracted tremendous interests from both the research communities and industries. The blockchain network was originated from the Internet financial sector as a decentralized, immutable ledger system for transactional data ordering. Nowadays, it is envisioned as a powerful backbone/framework for decentralized data processing and data-driven self-organization in flat, open-access networks. In particular, the plausible characteristics of decentralization, immutability, and self-organization are primarily owing to the unique decentralized consensus mechanisms introduced by blockchain networks. This survey is motivated by the lack of a comprehensive literature review on the development of decentralized consensus mechanisms in blockchain networks. In this paper, we provide a systematic vision of the organization of blockchain networks. By emphasizing the unique characteristics of decentralized consensus in blockchain networks, our in-depth review of the state-of-the-art consensus protocols is focused on both the perspective of distributed consensus system design and the perspective of incentive mechanism design. From a game-theoretic point of view, we also provide a thorough review of the strategy adopted for self-organization by the individual nodes in the blockchain backbone networks. Consequently, we provide a comprehensive survey of the emerging applications of blockchain networks in a broad area of telecommunication. We highlight our special interest in how the consensus mechanisms impact these applications. Finally, we discuss several open issues in the protocol design for blockchain consensus and the related potential research directions.},
archivePrefix = {arXiv},
arxivId = {1805.02707},
author = {Wang, Wenbo and Hoang, Dinh Thai and Hu, Peizhao and Xiong, Zehui and Niyato, Dusit and Wang, Ping and Wen, Yonggang and Kim, Dong In},
doi = {10.1109/ACCESS.2019.2896108},
eprint = {1805.02707},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Wang et al. - 2019 - A Survey on Consensus Mechanisms and Mining Strategy Management in Blockchain Networks.pdf:pdf},
issn = {21693536},
journal = {IEEE Access},
keywords = {Blockchain,Byzantine fault tolerance,GT,OR,P2P networks,Very High cited doc,block mining,game theory,incentive mechanisms,permissionless consensus},
mendeley-tags = {GT,OR,Very High cited doc},
pages = {22328--22370},
publisher = {IEEE},
title = {{A Survey on Consensus Mechanisms and Mining Strategy Management in Blockchain Networks}},
volume = {7},
year = {2019}
}
@article{Man2020a,
abstract = {The shipping industry constantly strives to achieve efficient use of energy during sea voyages. Previous research that can take advantages of both ethnographic studies and big data analytics to understand factors contributing to fuel consumption and seek solutions to support decision making is rather scarce. This paper first employed ethnographic research regarding the use of a commercially available fuel-monitoring system. This was to contextualize the real challenges on ships and informed the need of taking a bigdata approach to achieve energy efficiency(EE).Then this study constructed two machine-learning models based on the recorded voyage data of five different ferries over a one-year period. The evaluation showed that the models generalize well on different training data sets and model outputs indicated a potential for better performance than the existing commercial EE system. How this predictive-analytical approach could potentially impact the design of decision support navigational systems and management practices was also discussed. It is hoped that this inter disciplinary research could provide some enlightenment for a richer methodological framework in future maritime energy research.},
author = {Man, Yemao and Sturm, Tobias and Lundh, Monica and MacKinnon, Scott N.},
doi = {10.3390/app10062134},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Man et al. - 2020 - From ethnographic research to big data analytics - A case of maritime energy-efficiency optimization(3).pdf:pdf},
issn = {20763417},
journal = {Applied Sciences (Switzerland)},
keywords = {Bigdata,Decision support,Energy management,Ethnography,Interface design,Knowledge development,Machine learning,Maritime energy efficiency,Thick data,shipping},
mendeley-tags = {shipping},
number = {6},
title = {{From ethnographic research to big data analytics - A case of maritime energy-efficiency optimization}},
volume = {10},
year = {2020}
}
@techreport{Soda2011a,
abstract = {For safe navigation, high-resolution information on wind and waves is very important. In coastal areas in particular, the weather and ocean situation changes dramatically in time and place according to the effects of geography and water depth. In this paper, high resolution wave data are generated using SWAN [1][2] as a numerical wave model. To estimate waves, wind data is necessary. By using the mesoscale meteorological model of WRF-ARW, detailed wind data was generated. We simulated wind and ocean waves for the duration of a typhoon passing over Japan in September of 2004. Secondly, we simulated ship maneuvering using simulated wind and wave data. For the ship maneuvering model, the MMG (Mathematic Modeling Group) was used. Combining high-resolution wind and wave data with the numerical navigation model, we studied the effects of wind and waves on a ship's maneuvering. Comparing the simulated rhumb lines of a ship with the dead reckoning tracks, it was recognized that the effects of the wind and waves on a moving ship were significant. 1 INTRODUCTION It is considered that the wind, tidal current, and waves of the ocean are the most important factors in the field of ocean engineering. In particular, the numerical forecasting of tidal currents, winds over the sea, and ocean waves in coastal areas is important when considering ocean environments, fisheries, and the navigation of oceangoing vessels. and the effects to the marine structures or a running ship. In the previous paper, the numerical simulation of tidal currents as they relate to the wind in the bay was explained. The simulation of tidal currents was carried out in Japan's Osaka Bay. The detail tidal current were calculated using the POM (Princeton Oceanography Model) numerical model. The result of the numerical simulation of tidal currents and tidal elevations was compared with observed data in the bay. Comparison of the numerical and calculated results showed agreement. Firstly, in this paper, the numerical simulation of wind over the sea in the coastal sea area is explained. As with the tidal current calculations, the numerical simulation of wind on the sea was carried out in a coastal area in the south of Japan. Details of the distribution of wind on the sea were calculated using the WRF model developed principally among NCEP and NCAR in the United States. The wind calculation was continued for 11 days while a typhoon passed over the Nihon Sea near Japan. A strong wind blew from the southern direction on the coastal sea area. Numerical simulation of ocean waves in the coastal area was carried out using the simulated results of wind. The simulation of ocean waves was carried out by the same coastal area as the wind simulation, and calculated wind were used. Details of the distribution of waves on the sea were calculated using the SWAN model (Simulating Waves Nearshore) developed at the Delft University of Technology in Netherlands.},
author = {Soda, Taisuke and Makino, Hidenari},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Soda et al. - 2011 - Simulation of Weather and Ocean for Numerical Ship Navigation Taisuke.pdf:pdf},
keywords = {OMAE2011-49240},
title = {{Simulation of Weather and Ocean for Numerical Ship Navigation OMAE2011-49}},
url = {https://proceedings.asmedigitalcollection.asme.org},
year = {2011}
}
