journal = {Renewable and Sustainable Energy Reviews},
keywords = {ABM,AIrev,Artificial intelligence,Artificial neural networks,Demand response,GT,Machine learning,Multi-agent systems,Nature-inspired intelligence,OR,PhyML,Power systems,RE Teaching,RL,Semantic,Very High cited doc,important doc,post-processing,review},
