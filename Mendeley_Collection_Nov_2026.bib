journal = {Energy Research and Social Science},
keywords = {Content analysis,Energy studies research,Media content analysis},
pages = {1--29},
publisher = {Elsevier Ltd.},
title = {{What are we doing here? Analyzing fifteen years of energy scholarship and proposing a social science research agenda}},
url = {http://dx.doi.org/10.1016/j.erss.2014.02.003},
volume = {1},
year = {2014}
