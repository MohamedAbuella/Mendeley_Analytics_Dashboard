doi = {10.3389/fenrg.2022.1009217},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Huang, Li - 2022 - Game theory applications in the electricity market and renewable energy trading A critical survey(2).pdf:pdf},
issn = {2296598X},
