isbn = {4989289269},
issn = {19961073},
keywords = {Battery aging,Battery energy storage,Grid connection,Lithium ion,OR,OSeMOSYS,Operation strategy,Optimization,Stationary application,Storage system design,Storagemodelling,Techno-economic analysis},
mendeley-tags = {OR,OSeMOSYS},
number = {12},
title = {{Lithium-ion battery storage for the grid - A review of stationary battery storage system design tailored for applications in modern power grids}},
