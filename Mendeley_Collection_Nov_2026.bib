journal = {IEEE Transactions on Intelligent Transportation Systems},
keywords = {Intel_Trns_Sys,Path planning,Very High cited doc,artificial potential field,autonomous vehicles,model predictive control,road vehicles,shipping,vehicle dynamics and control},
mendeley-tags = {Intel_Trns_Sys,Very High cited doc,shipping},
number = {5},
pages = {1255--1267},
publisher = {IEEE},
title = {{A Potential Field-Based Model Predictive Path-Planning Controller for Autonomous Road Vehicles}},
volume = {18},
