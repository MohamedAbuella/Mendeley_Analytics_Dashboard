journal = {Energy},
keywords = {Bi-level optimization,Economics,GT,Game theory,Microgrid,Renewable power generation,Rooftop photovoltaic (PV) systems,Solar building,Theoretical Background,important doc},
mendeley-tags = {GT,Theoretical Background,important doc},
number = {June},
pages = {133715},
publisher = {Elsevier Ltd},
title = {{Game-theoretic optimization strategy for maximizing profits to both end-users and suppliers in building rooftop PV-based microgrids}},
