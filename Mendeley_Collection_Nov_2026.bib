issn = {19961073},
journal = {Energies},
keywords = {Artificial neural network,Average fuel consumption,Center for alternative fuels engines and emissions,Heavy-duty vehicles,Linear regression,Machine learning,PhyML,Random forest,shipping},
mendeley-tags = {PhyML,shipping},
number = {24},
title = {{Trip based modeling of fuel consumption in modern heavy-duty vehicles using artificial intelligence}},
volume = {14},
year = {2021}
