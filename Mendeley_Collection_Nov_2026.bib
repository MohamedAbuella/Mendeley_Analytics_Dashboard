file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Cheng, Yu, Lin - 2014 - Bi-model short-term solar irradiance prediction using support vector regressors.pdf:pdf},
isbn = {0360-5442},
issn = {03605442},
journal = {Energy},
