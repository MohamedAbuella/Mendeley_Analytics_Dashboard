journal = {Proceedings of the Institution of Mechanical Engineers Part M: Journal of Engineering for the Maritime Environment},
keywords = {High cited doc,Mean value engine model,Performance and emission parameters mapping,PhyML,Propulsion system modelling,Theoretical Background,Two-stroke marine diesel engines,shipping},
mendeley-tags = {High cited doc,PhyML,Theoretical Background,shipping},
number = {1},
pages = {58--76},
title = {{A computational study on the performance and emission parameters mapping of a ship propulsion system}},
volume = {229},
year = {2015}
