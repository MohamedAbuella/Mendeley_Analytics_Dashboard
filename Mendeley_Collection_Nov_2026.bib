title = {{State-of-the-Art on Methods and Software Tools for Short-Term Prediction of Wind Energy Production}},
url = {http://anemos.cma.fr/download/publications/pub_2003_paper_EWEC03_SOTAGiebel.pdf},
year = {2010}
