mendeley-tags = {TEA},
number = {2},
pages = {370--378},
publisher = {Association for Scientific Computing Electronics and Engineering (ASCEE)},
title = {{Techno-Economic Analysis of a 12-kW Photovoltaic System Using an Efficient Multiple Linear Regression Model Prediction}},
