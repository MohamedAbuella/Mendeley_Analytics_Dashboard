journal = {Energy Policy},
keywords = {Air pollution,Climate change,Electric sector,EnergPolicy,Ground-level ozone,Mid-atlantic region,Multi-Vector Energy System,NOx,OR,Theoretical Background,important doc},
mendeley-tags = {EnergPolicy,Multi-Vector Energy System,OR,Theoretical Background,important doc},
number = {x},
pages = {11--21},
publisher = {Elsevier},
title = {{Impacts of climate change on power sector NOx emissions: A long-run analysis of the US mid-atlantic region}},
