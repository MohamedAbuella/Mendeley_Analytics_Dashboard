@article{Diagne2014,
abstract = {An efficient use of solar energy production requires reliable forecast information on surface solar irradiance. This article aims at providing a model output statistics (MOS) method of improving solar irradiance forecasts from Weather Research and Forecasting (WRF) Model. The WRF model was used to produce one year of day ahead solar irradiance forecasts covering Reunion Island with an horizontal resolution of 3 km. These forecasts are refined with a Kalman filter using high quality ground measurements. Determination of the relevant data inputs for the Kalman filter method is realized with a bias error analysis. Solar zenith angle and the clear sky index, among others, are used for this analysis. Accuracy of the method is evaluated with a comprehensive testing procedure using different error metrics. Kalman filtering appears to be a viable method in order to improve the solar irradiance forecasting.},
annote = {(In fig. 1 they categorized Kalman filter as statistical model!)
