doi = {10.1016/j.epsr.2011.01.008},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Moreto, Rolim - 2011 - Using phasor data records and sequence of events to automate the classification of disturbances of power generati.pdf:pdf},
issn = {03787796},
