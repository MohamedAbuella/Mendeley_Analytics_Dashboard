keywords = {Cloud detecting,Cloud tracking,Short-term forecast,Sky imagery},
pages = {496--519},
publisher = {Elsevier Ltd},
title = {{3D cloud detection and tracking system for solar forecast using multiple sky imagers}},
url = {http://dx.doi.org/10.1016/j.solener.2015.05.037},
volume = {118},
year = {2015}
