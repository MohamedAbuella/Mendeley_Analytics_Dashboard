journal = {Machine Learning},
keywords = {Thesis,autoassociation,class imbalance problem,discrimination,feedforward neural networks,recognition,supervised learning,unsupervised learning},
mendeley-tags = {Thesis},
number = {1-2},
pages = {97--122},
title = {{Supervised versus unsupervised binary-learning by feedforward neural networks}},
volume = {42},
year = {2001}
}
