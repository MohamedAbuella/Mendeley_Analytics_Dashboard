keywords = {Analytic hierarchy process,Life cycle cost,Loss of load probability,Multi-criteria decision making,Photovoltaic water pumping system},
number = {August 2017},
pages = {1003--1015},
publisher = {Elsevier},
title = {{Sizing of a standalone photovoltaic water pumping system using hybrid multi-criteria decision making methods}},
