@techreport{Karagiannidis,
abstract = {The purpose of this study is to establish methods for effective pre-processing of ship operational data and to create data-driven ship propulsion models that will be in the core of applications that aim to reduce the carbon footprint of the ships. Thereby, an application of Artificial Neural Networks (ANN) is developed that utilizes the processed ship data, which were automatically collected with high-frequency sampling rate, over a period of 1.5 years. The application predicts the ship's total fuel oil consumption under various scenarios of operation. The necessary statistical calculations and algorithms for data processing were implemented in Python programming language and state-of-the-art deep learning techniques for training and optimizing Feed-Forward Neural Networks (FNNs) were applied. The results show that with a proper "data filtering and preparation" stage (pre-processing), like the one implemented in this study, it is possible to achieve an increased performance of the ship propulsion models and consequently increase our awareness of the ship's performance condition and make more effective decisions regarding strategies and operational measures for reducing fuel oil consumption and emissions.},
author = {Karagiannidis, Pavlos and Themelis, Nikos and Zaraphonitis, George and Spandonidis, Christos and Giordamlis, Christos},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Karagianidis et al. - 2019 - Ship Fuel Consumption Prediction using Artificial Neural Networks.pdf:pdf},
keywords = {ANN,Data Processing,Fuel Consumption Prediction,Performance Monitoring},
title = {{Ship Fuel Consumption Prediction using Artificial Neural Networks}}
}
@article{Goerlandt2015,
abstract = {Many methods and applications for maritime transportation risk analysis have been presented in the literature. In parallel, there is a recent focus on foundational issues in risk analysis, with calls for intensified research on fundamental concepts and principles underlying the scientific field. This paper presents a review and analysis of risk definitions, perspectives and scientific approaches to risk analysis found in the maritime transportation application area, focusing on applications addressing accidental risk of shipping in a sea area. For this purpose, a classification of risk definitions, an overview of elements in risk perspectives and a classification of approaches to risk analysis science are applied. Results reveal that in the application area, risk is strongly tied to probability, both in definitions and perspectives, while alternative views exist. A diffuse situation is also found concerning the scientific approach to risk analysis, with realist, proceduralist and constructivist foundations co-existing. Realist approaches dominate the application area. Very few applications systematically account for uncertainty, neither concerning the evidence base nor in relation to the limitations of the risk model in relation to the space of possible outcomes. Some suggestions are made to improve the current situation, aiming to strengthen the scientific basis for risk analysis.},
author = {Goerlandt, Floris and Montewka, Jakub},
doi = {10.1016/j.ress.2015.01.025},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Goerlandt, Montewka - 2015 - Maritime transportation risk analysis Review and analysis in light of some foundational issues(3).pdf:pdf},
issn = {09518320},
journal = {Reliability Engineering and System Safety},
keywords = {Foundational issues,Maritime accident,Maritime safety,Maritime transportation,Risk analysis principles,Very High cited doc,review,shipping},
mendeley-tags = {Very High cited doc,review,shipping},
pages = {115--134},
publisher = {Elsevier},
title = {{Maritime transportation risk analysis: Review and analysis in light of some foundational issues}},
url = {http://dx.doi.org/10.1016/j.ress.2015.01.025},
volume = {138},
year = {2015}
}
