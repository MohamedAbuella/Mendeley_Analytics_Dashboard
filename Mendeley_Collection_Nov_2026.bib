keywords = {GT,Multi-Vector Energy System,OR,Peer-to-peer trading,Very High cited doc,auction theory,blockchain,challenges,energy cost,energy management,energy market,future research,game theory,important doc,network loss,physical layer,review,storage,virtual layer,voltage violation},
mendeley-tags = {GT,Multi-Vector Energy System,OR,Very High cited doc,important doc,review},
