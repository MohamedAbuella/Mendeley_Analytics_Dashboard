journal = {Renewable and Sustainable Energy Reviews},
keywords = {Consumer-centric electricity market,Decentralized and distributed optimization,Energy community,OR,Peer-to-peer energy trading,Prosumers,Theoretical Background,Very High cited doc,important doc,review},
