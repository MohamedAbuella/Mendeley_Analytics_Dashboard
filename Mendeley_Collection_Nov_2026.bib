publisher = {Elsevier Ltd},
title = {{Achieving fuel efficiency of harbour craft vessel via combined time-series and classification machine learning model with operational data}},
url = {https://doi.org/10.1016/j.martra.2022.100073},
volume = {3},
year = {2022}
