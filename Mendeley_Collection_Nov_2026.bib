isbn = {9665306960},
keywords = {Hydrogen,Libya,RE Teaching,SAM,TEA,Theoretical Background,residential buildings,sam,solar photovoltaic,techno-economic feasibility},
mendeley-tags = {Hydrogen,Libya,RE Teaching,TEA,Theoretical Background},
title = {{Techno-Economic Feasibility Assessment of Grid-Connected PV Systems for Residential Buildings in Saudi Arabia — A Case Study roughly}},
year = {2020}
