journal = {Brilliance: Research of Artificial Intelligence},
month = {mar},
number = {1},
pages = {32--42},
publisher = {Information Technology and Science (ITScience)},
title = {{Artificial Intelligence in Engineering}},
volume = {3},
year = {2023}
}
