@article{Rusu2013a,
abstract = {The objective of this work is to present a system for operability prediction of the vessels operating in the Azores Archipelago. The methodology adopted is based on the results of a numerical wave model to calculate the vessels' seakeeping performance under the predicted sea states. A strip theory method is used to evaluate the containership responses, and by comparison with the prescribed values of relevant seakeeping criteria, limit sea state that still allows standard operational conditions for that vessel are determined. Operability indexes are computed for each grid point, at a given time, by comparing the predicted significant wave height and mean wave period with the maximum allowed values for a specific operation criterion. The areas in which the level of operability of the ships will be degraded due to weather conditions are easily identified in these maps and can be avoided.},
author = {Rusu, L. and Soares, C. Guedes},
doi = {10.1201/b15813-124},
