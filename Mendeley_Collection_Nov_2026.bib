@inproceedings{Kim2017,
abstract = {The South Korean government has been started monitoring and reassessment for new and renewable resource under greenhouse reduction related with the climate agreement in Paris. This study investigated characteristics of the model-derived direct normal irradiance (DNI) using ten-minute data of the Weather Research and Forecasting (WRF) model with 1 km grid spacing. First, ground horizontal irradiance (GHI) and direct normal irradiance (DNI) from the model was compared with those of ground stations throughout South Korea to evaluate the uncertainty of the GHI-derived DNI. Then solar thermal resource potential was assessed in terms of quantity. Uncertainty of irradiances appeared highly dependent on sky conditions. Annual mean bias error (BME) and root mean square error (RMSE) in DNI was 16.09% and 45%, respectively. For measured clear conditions the WRF model at all stations have been biased (was errors) by less than 2%(10%), whereas these biases have been exceeded 35%(52%) for measured cloudy conditions in DNI. The DNI for clear sky was also high consistency of the value of 850 W/m 2 against a whole year whereas GHI was steep temporal variations although it's very similar with those of measurements. The annual mean DNI for clear sky was high over most areas except southeastern areas and Jeju island which is humid regions.},
author = {Kim, Jin-Young and Yun, Chang-Yeol and Kim, Chang Ki and Kang, Yong-Heack and Kim, Hyun-Goo and Lee, Sang-Nam and Kim, Shin-Young},
