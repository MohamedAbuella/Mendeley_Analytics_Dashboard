issn = {20724292},
journal = {Remote Sensing},
keywords = {Path,Theoretical Background,abnormal vessel behavior,ais data,clustering methods,important doc,machine learning,maritime surveillance system,shipping,situational awareness},
mendeley-tags = {Path,Theoretical Background,important doc,shipping},
number = {6},
pages = {1477},
title = {{A Comprehensive Study of Clustering-Based Techniques for Detecting Abnormal Vessel Behavior}},
volume = {15},
