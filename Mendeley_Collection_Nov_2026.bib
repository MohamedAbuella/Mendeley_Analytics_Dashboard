issn = {00401625},
journal = {Technological Forecasting and Social Change},
keywords = {Energy innovation,Fuel mix,Grey TOPSIS, grey linear programming,Interindustry architectural innovation,PhyML,Sustainable energy,grey linear programming,review,shipping},
mendeley-tags = {PhyML,review,shipping},
number = {March 2018},
pages = {381--393},
publisher = {Elsevier},
title = {{Sustainable resource allocation for power generation: The role of big data in enabling interindustry architectural innovation}},
