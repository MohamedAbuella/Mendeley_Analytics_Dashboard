@article{Nakashima2007,
abstract = {Purpose : To report a case of malignant lymphoma of central nervous system (CNS) which initiated as uveitis and which responded to massive dosis of methotrexate. Case and Findings : A 56-year-old female presented with decreased vision in her right eye. The corrected visual acuity was 0.03. The right eye showed subretinal exudates in the central and nasal fundus. Systemic prednisolone was effective but was followed by hemorrhage and exudates in the periphery one month later. Diagnostic imaging showed nodular lesion in the brain. Vitreous biopsy was negative. Biopsy of the brain led to the diagnosis of malignant lymphoma. Ocular and CNS lesions improved after intrathecal and systemic methotrexate in massive dosis with final visual acuity of 0.04. Conclusion : This case illustrates that ocular and CNS malignant lymphoma may respond to intrathecal and systemic methotrexate in massive dosis.},
