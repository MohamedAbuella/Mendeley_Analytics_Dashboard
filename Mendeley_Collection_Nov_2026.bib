isbn = {9798350345094},
journal = {2023 IEEE 7th Conference on Energy Internet and Energy System Integration, EI2 2023},
keywords = {GASnets,GT,Multi-Vector Energy System,OR,Theoretical Background,important doc,microgrid,mixed game,pricing mechanisms,shared energy storage},
mendeley-tags = {GASnets,GT,Multi-Vector Energy System,OR,Theoretical Background,important doc},
