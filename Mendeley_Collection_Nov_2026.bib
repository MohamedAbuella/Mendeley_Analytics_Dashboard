@article{Dawadi2023a,
abstract = {Literature review is a rigorous and lengthy process that requires a considerable amount of time and effort from the reviewers. With the availability of services such as text mining as well as software such as Mendeley, the literature review process has been highly simplified. Similarly, there are numerous readily available Python packages that provide an interesting automated approach to conducting literature reviews. However, for literature review, it is necessary that the reviewers have control over all of the steps to ensure that the results meet the main topic of research. We have developed a semi-automated screening process that can be used to filter papers by using their titles, abstracts and full-texts. First, the titles and abstracts of the papers are screened using separate sets of keywords each for title and abstract, and the papers that do not contain the keywords as specified by the reviewers are removed. In the next step, the full-texts of the remaining papers are screened by generating only those sentences that consist of the keywords specified for full-text screening. This approach significantly reduces the amount of time required to screen and read a collection of papers. Through this work, we aim to reduce the burden on reviewers in screening titles and abstracts and to facilitate the reading of the full-text of papers.},
author = {Dawadi, Research and Araki, Michihiro},
doi = {10.2139/ssrn.4521171},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Dawadi, Araki - 2023 - A Semi-automatic Screening Mechanism for Literature Review(2).pdf:pdf},
journal = {SSRN Electronic Journal},
keywords = {AIrev,Semantic,Theoretical Background,important doc,keyword screening,literature review,python,review,text mining},
mendeley-tags = {AIrev,Semantic,Theoretical Background,important doc,review},
pages = {1--12},
title = {{A Semi-automatic Screening Mechanism for Literature Review}},
year = {2023}
}
@inproceedings{Jeong2011a,
abstract = {Dynamic time warping (DTW), which finds the minimum path by providing non-linear alignments between two time series, has been widely used as a distance measure for time series classification and clustering. However, DTW does not account for the relative importance regarding the phase difference between a reference point and a testing point. This may lead to misclassification especially in applications where the shape similarity between two sequences is a major consideration for an accurate recognition. Therefore, we propose a novel distance measure, called a weighted DTW (WDTW), which is a penalty-based DTW. Our approach penalizes points with higher phase difference between a reference point and a testing point in order to prevent minimum distance distortion caused by outliers. The rationale underlying the proposed distance measure is demonstrated with some illustrative examples. A new weight function, called the modified logistic weight function (MLWF), is also proposed to systematically assign weights as a function of the phase difference between a reference point and a testing point. By applying different weights to adjacent points, the proposed algorithm can enhance the detection of similarity between two time series. We show that some popular distance measures such as DTW and Euclidean distance are special cases of our proposed WDTW measure. We extend the proposed idea to other variants of DTW such as derivative dynamic time warping (DDTW) and propose the weighted version of DDTW. We have compared the performances of our proposed procedures with other popular approaches using public data sets available through the UCR Time Series Data Mining Archive for both time series classification and clustering problems. The experimental results indicate that the proposed approaches can achieve improved accuracy for time series classification and clustering problems. {\textcopyright} 2010 Elsevier Ltd. All rights reserved.},
author = {Jeong, Young Seon and Jeong, Myong K. and Omitaomu, Olufemi A.},
booktitle = {Pattern Recognition},
doi = {10.1016/j.patcog.2010.09.022},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Jeong, Jeong, Omitaomu - 2011 - Weighted dynamic time warping for time series classification(2).pdf:pdf},
issn = {00313203},
keywords = {Adaptive weights,Dynamic time warping,Modified logistic weight function,Time series classification,Time series clustering,Weighted dynamic time warping},
month = {sep},
number = {9},
pages = {2231--2240},
title = {{Weighted dynamic time warping for time series classification}},
volume = {44},
year = {2011}
}
