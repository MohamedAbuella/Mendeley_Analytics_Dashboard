issn = {22279717},
journal = {Processes},
keywords = {Heating,Hydrogen,OR,TEA,biomass,decarbonisation,energy-intensive industries,geothermal,green hydrogen,heat pumps,renewable energies,review,solar thermal},
mendeley-tags = {Heating,Hydrogen,OR,TEA,review},
