issn = {16807316},
journal = {Atmospheric Chemistry and Physics},
number = {5},
pages = {2641--2659},
title = {{Extension of an assessment model of ship traffic exhaust emissions for particulate matter and carbon monoxide}},
volume = {12},
year = {2012}
}
