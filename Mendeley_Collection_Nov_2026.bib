journal = {International Journal of Greenhouse Gas Control},
keywords = {CCS,Carbon trading,GT,Game theory,Mixed integer linear programming (MILP),Multi-Vector Energy System,OR,Theoretical Background,important doc},
mendeley-tags = {GT,Multi-Vector Energy System,OR,Theoretical Background,important doc},
pages = {43--54},
publisher = {Elsevier Ltd},
title = {{Fair design of CCS infrastructure for power plants in Qatar under carbon trading scheme}},
