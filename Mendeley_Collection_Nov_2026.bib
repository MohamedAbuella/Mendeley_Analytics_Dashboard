keywords = {GPV datasets,Gridded nudging,Physics parametrization schemes,Rough-sea navigation,Ship weather routing,WRF regional Model,WSR,shipping},
mendeley-tags = {WSR,shipping},
title = {{Comparative study on WRF model simulations from the viewpoint of optimum ship routing}},
