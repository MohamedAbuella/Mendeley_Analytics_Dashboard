issn = {09596526},
journal = {Journal of Cleaner Production},
keywords = {Artificial neural network,Fuel consumption,Improved particle swarm optimization algorithm,Uncertainty},
month = {apr},
pages = {144--153},
publisher = {Elsevier Ltd},
title = {{A voyage with minimal fuel consumption for cruise ships}},
volume = {215},
year = {2019}
