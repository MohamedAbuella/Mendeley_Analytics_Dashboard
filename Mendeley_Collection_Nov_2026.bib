issn = {11791349},
journal = {Clinical Epidemiology},
keywords = {Cluster analysis,Group-based trajectory modelling,Growth mixture modelling,Latent class analysis,Latent transition analysis,Modelling techniques,Path,Sequence analysis,Tra_GMM_DMP_Spline,review,shipping},
mendeley-tags = {Path,Tra_GMM_DMP_Spline,review,shipping},
pages = {1205--1222},
title = {{Trajectory modelling techniques useful to epidemiological research: A comparative narrative review of approaches}},
