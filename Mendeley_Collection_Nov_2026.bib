journal = {Conference Record of the IEEE Photovoltaic Specialists Conference},
keywords = {Atypical Behavior,Automated Detection,Photovoltaic reference units,Temporal Suitability},
pages = {980--985},
title = {{Towards an improved nowcasting method by evaluating power profiles of PV systems to detect apparently atypical behavior}},
volume = {2016-Novem},
year = {2016}
}
