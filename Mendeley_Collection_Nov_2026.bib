journal = {Renewable and Sustainable Energy Reviews},
keywords = {ABM,Behavioural modelling,Hydrogen,Multi-Vector Energy System,Multi-energy systems,Multiscale modelling,OR,OSeMOSYS,Review,Theoretical Background,Uncertainty,Very High cited doc,important doc,review},
mendeley-tags = {ABM,Hydrogen,Multi-Vector Energy System,OR,OSeMOSYS,Theoretical Background,Very High cited doc,important doc,review},
