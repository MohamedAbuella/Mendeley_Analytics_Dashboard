file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Davo et al. - 2016 - Post-processing techniques and principal component analysis for regional wind power and solar irradiance forecastin.pdf:pdf},
