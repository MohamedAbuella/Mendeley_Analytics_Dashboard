journal = {Computers and Chemical Engineering},
keywords = {Convex relaxation,Hybrid power plant,Hydrogen,Hydrogen production curve,Nonlinear efficiency,OR,Relaxation exactness},
mendeley-tags = {Hydrogen,OR},
title = {{A conic model for electrolyzer scheduling}},
volume = {179},
