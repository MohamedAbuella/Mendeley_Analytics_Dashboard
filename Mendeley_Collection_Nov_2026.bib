file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Thombre et al. - 2022 - Sensors and AI Techniques for Situational Awareness in Autonomous Ships A Review.pdf:pdf},
issn = {15580016},
journal = {IEEE Transactions on Intelligent Transportation Systems},
keywords = {AIS,GNSS,LiDAR,Path,Positioning,RADAR,camera,important doc,machine learning,maritime,microphone,review,sensor fusion,shipping},
