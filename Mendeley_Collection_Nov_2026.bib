issn = {18790690},
journal = {Renewable and Sustainable Energy Reviews},
keywords = {Archetypes,Challenges,Classification,Hydrogen,Model,OR,Taxonomy,important doc,review},
mendeley-tags = {Hydrogen,OR,important doc,review},
number = {January},
