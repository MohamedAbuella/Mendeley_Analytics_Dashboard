issn = {19443986},
journal = {Desalination and Water Treatment},
keywords = {Renewable energy,Reverse osmosis membrane,Solar Stirling engine,Trace pollutants,Wastewater},
pages = {189--211},
title = {{A new system design of using solar dish-hydro combined with reverse osmosis for sewage water treatment: Case study Al-Marj, Libya}},
volume = {193},
year = {2020}
