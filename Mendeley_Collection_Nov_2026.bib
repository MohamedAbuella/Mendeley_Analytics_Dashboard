journal = {Energies},
keywords = {GASnets,Gas distribution,Grid expansion planning,Heat pumps,Heating,Hydrogen,Load-profiles,Multi-Vector Energy System,OR,OSeMOSYS,Power grid,TEA,Theoretical Background},
mendeley-tags = {GASnets,Heating,Hydrogen,Multi-Vector Energy System,OR,OSeMOSYS,TEA,Theoretical Background},
