@article{Musunuru2021,
abstract = {Secondary research involves the summary, collation and synthesis of existing research. Secondary research encompasses few methods among which systematic reviews, meta analysis are widely in use. Using text mining for review of literature is still a lacuna in research world albeit of the existence of this technology or techniques from long. The package litreviewer is a collection of few Python scripts called modules which is useful for performing text mining. All those methods defined in these modules found to have worked effectively while using for web crawling and scraping. The package also supports statistical analysis and other utility functions related to text concatenation and accumulation of the same as in corpus. This means litreviewer is a wholesome solutions for practicing text mining for secondary data research. The efficacy of the package was evaluated with the help of a case study related to Covid-19 pandemic. The package has been found to be useful while testing validity of data besides offering very insightful outcomes.},
