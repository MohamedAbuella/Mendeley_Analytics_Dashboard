doi = {10.1016/j.renene.2018.09.005},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Abuella, Chowdhury - 2019 - Forecasting of solar power ramp events A post-processing approach(2).pdf:pdf},
