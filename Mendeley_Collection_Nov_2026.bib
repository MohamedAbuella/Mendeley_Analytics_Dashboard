file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Filipiak et al. - 2020 - Extracting Maritime Traffic Networks from AIS Data Using Evolutionary Algorithm(2).pdf:pdf},
issn = {18670202},
journal = {Business and Information Systems Engineering},
keywords = {AIS,Artificial intelligence,Genetic algorithm,Graph discovery,Maritime traffic graph,Maritime traffic network,Route planning,Vessel routing,Waypoint discovery,shipping},
mendeley-tags = {AIS,shipping},
number = {5},
pages = {435--450},
title = {{Extracting Maritime Traffic Networks from AIS Data Using Evolutionary Algorithm}},
volume = {62},
year = {2020}
}
