file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Li, Tan - 2010 - Tuning SVM parameters by using a hybrid CLPSO-BFGS algorithm.pdf:pdf},
issn = {09252312},
