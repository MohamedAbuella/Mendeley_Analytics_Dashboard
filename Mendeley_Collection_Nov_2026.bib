doi = {10.1002/aic.17039},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Liu et al. - 2020 - Simultaneous design and operation optimization of renewable combined cooling heating and power systems.pdf:pdf},
