issn = {21693536},
journal = {IEEE Access},
keywords = {Feature extraction,High cited doc,Path,Theoretical Background,important doc,map-match,shipping,similarity calculation,trajectory compression,trajectory partitioning},
mendeley-tags = {High cited doc,Path,Theoretical Background,important doc,map-match,shipping},
pages = {7898--7909},
publisher = {IEEE},
title = {{Finding Abnormal Vessel Trajectories Using Feature Learning}},
volume = {5},
year = {2017}
