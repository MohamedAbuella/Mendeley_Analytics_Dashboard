issn = {02540096},
journal = {Taiyangneng Xuebao/Acta Energiae Solaris Sinica},
keywords = {Gaussian regression process,Health indicator,Lithium-ion battery,Principal component analysis,RUL,Remaining useful life prediction,Theoretical Background},
mendeley-tags = {RUL,Theoretical Background},
