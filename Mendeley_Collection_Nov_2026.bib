keywords = {High cited doc,WSR,algorithms,important doc,mathematical modeling,optimization,optimization problems,review,shipping,voyage,weather routing},
mendeley-tags = {High cited doc,WSR,important doc,review,shipping},
pages = {31--45},
publisher = {Elsevier B.V.},
title = {{Modeling and Optimization Algorithms in Ship Weather Routing}},
url = {http://dx.doi.org/10.1016/j.enavi.2016.06.004},
volume = {4},
year = {2016}
