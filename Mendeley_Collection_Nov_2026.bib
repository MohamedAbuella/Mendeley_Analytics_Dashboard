journal = {Journal of Marine Science and Engineering},
keywords = {Challenges,Social perspectives,Tropical regions,Wave energy,review,shipping},
mendeley-tags = {review,shipping},
number = {7},
title = {{Wave energy in tropical regions: Deployment challenges, environmental and social perspectives}},
volume = {7},
year = {2019}
}
