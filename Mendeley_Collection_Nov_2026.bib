journal = {Solar Energy},
keywords = {NMAE,PV Simulation,PV equivalent electrical circuit,PV forecast power production,PhyML,SolarTechlab,WMAE,important doc},
mendeley-tags = {PV Simulation,PhyML,important doc},
pages = {83--99},
publisher = {Elsevier Ltd},
title = {{Comparison of different physical models for PV power output prediction}},
