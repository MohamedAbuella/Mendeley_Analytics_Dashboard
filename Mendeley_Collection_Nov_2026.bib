journal = {Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences},
keywords = {PhyML,Semantic,Very High cited doc,climate,neural networks,physical constraints,physics-informed machine learning,review,turbulent flows,weather and climate modeling},
