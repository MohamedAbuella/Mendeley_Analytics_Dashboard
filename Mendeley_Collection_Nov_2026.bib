issn = {20711050},
journal = {Sustainability (Switzerland)},
keywords = {Latin America,OR,Theoretical Background,electric propulsion,energy planning,energy transition,renewable energy,review,smart energy systems,transportation},
mendeley-tags = {OR,Theoretical Background,review},
number = {23},
title = {{Smart Electrical Planning, Roadmaps and Policies in Latin American Countries Through Electric Propulsion Systems: A Review}},
volume = {16},
year = {2024}
