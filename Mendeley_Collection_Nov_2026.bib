journal = {North American Power Symposium (NAPS)},
keywords = {Forecasting,Predictive models,Statistical methods,Weather forecasting,Wind forecasting,Wind power generation,Wind speed,Wind speed forecasting,artificial neural network,artificial neural networks,auto-regressive moving average,electric grid,environmental considerations,fuzzy logic,neural nets,numeric weather prediction,persistence method,power engineering computing,power grids,renewable energy resource,time horizons,wind intermittency,wind power,wind power forecasting,wind power prediction},
