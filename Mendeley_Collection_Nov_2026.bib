keywords = {GASnets,Heating,Hydrogen,Multi-Vector Energy System,OR,RE Teaching,TEA,Theoretical Background,important doc},
mendeley-tags = {GASnets,Heating,Hydrogen,Multi-Vector Energy System,OR,RE Teaching,TEA,Theoretical Background,important doc},
number = {October},
