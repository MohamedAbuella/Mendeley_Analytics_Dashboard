@article{Ofner2022a,
abstract = {This paper introduces a method for the detection of knock occurrences in an internal combustion engine (ICE) using a 1D convolutional neural network trained on in-cylinder pressure data. The model architecture was based on considerations regarding the expected frequency characteristics of knocking combustion. To aid the feature extraction, all cycles were reduced to 60{\deg} CA long windows, with no further processing applied to the pressure traces. The neural networks were trained exclusively on in-cylinder pressure traces from multiple conditions and labels provided by human experts. The best-performing model architecture achieves an accuracy of above 92% on all test sets in a tenfold cross-validation when distinguishing between knocking and non-knocking cycles. In a multi-class problem where each cycle was labeled by the number of experts who rated it as knocking, 78% of cycles were labeled perfectly, while 90% of cycles were classified at most one class from ground truth. They thus considerably outperform the broadly applied MAPO (Maximum Amplitude of Pressure Oscillation) detection method, as well as other references reconstructed from previous works. Our analysis indicates that the neural network learned physically meaningful features connected to engine-characteristic resonance frequencies, thus verifying the intended theory-guided data science approach. Deeper performance investigation further shows remarkable generalization ability to unseen operating points. In addition, the model proved to classify knocking cycles in unseen engines with increased accuracy of 89% after adapting to their features via training on a small number of exclusively non-knocking cycles. The algorithm takes below 1 ms (on CPU) to classify individual cycles, effectively making it suitable for real-time engine control.},
archivePrefix = {arXiv},
arxivId = {2201.06990},
author = {Ofner, Andreas B. and Kefalas, Achilles and Posch, Stefan and Geiger, Bernhard C.},
doi = {10.1109/TMECH.2022.3144832},
eprint = {2201.06990},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Ofner et al. - 2022 - Knock Detection in Combustion Engine Time Series Using a Theory-Guided 1-D Convolutional Neural Network Approach.pdf:pdf},
month = {jan},
title = {{Knock Detection in Combustion Engine Time Series Using a Theory-Guided 1D Convolutional Neural Network Approach}},
url = {http://arxiv.org/abs/2201.06990 http://dx.doi.org/10.1109/TMECH.2022.3144832},
year = {2022}
}
