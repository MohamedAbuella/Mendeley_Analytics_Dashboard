@article{Nielsen2011a,
abstract = {The fa??ade design is and should be considered a central issue in the design of energy-efficient buildings. That is why dynamic fa??ade components are increasingly used to adapt to both internal and external impacts, and to cope with a reduction in energy consumption and an increase in occupant comfort. To gain a complete picture of any fa??ade's performance and subsequently carry out a reasonable benchmarking of various fa??ade alternatives, the total energy consumption and indoor environment need to be considered simultaneously. We quantified the potential of dynamic solar shading fa??ade components by using integrated simulations that took energy demand, the indoor air quality, the amount of daylight available, and visual comfort into consideration. Three types of fa??ades were investigated (without solar shading, with fixed solar shading, and with dynamic solar shading), and we simulated them with various window heights and orientations. Their performance was evaluated on the basis of the building's total energy demand, its energy demand for heating, cooling and lighting, and also its daylight factors. Simulation results comparing the three fa??ade alternatives show potential for significant energy reduction, but greater differences and conflicting tendencies were revealed when the energy needed for heating, cooling and artificial lighting were considered separately. Moreover, the use of dynamic solar shading dramatically improved the amount of daylight available compared to fixed solar shading, which emphasises the need for dynamic and integrated simulations early in the design process to facilitate informed design decisions about the fa??ade. ?? 2011 Elsevier Ltd.},
author = {Nielsen, Martin Vraa and Svendsen, Svend and Jensen, Lotte Bjerregaard},
