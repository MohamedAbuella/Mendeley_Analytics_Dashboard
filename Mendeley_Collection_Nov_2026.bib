journal = {Applied Energy},
keywords = {Energy networks integration,Heating,Hydrogen,Integrated value chains (value webs),MILP,Multi-Vector Energy System,Multi-objective optimisation,Multi-vector energy networks,OR,RE Teaching,Renewable energy value chains,Semantic,TEA,Very High cited doc,important doc},
