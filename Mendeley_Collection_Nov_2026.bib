journal = {Utilities Policy},
keywords = {Electricity deregulation,Electricity models,GT,OR,Strategic energy bidding,Supply function equilibria,Theoretical Background,Very High cited doc,important doc},
mendeley-tags = {GT,OR,Theoretical Background,Very High cited doc,important doc},
