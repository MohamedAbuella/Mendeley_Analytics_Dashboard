@article{Olmer2017,
abstract = {This article focuses on the validity of the circumduction test for measuring shoulder flexibility in older adults. Participants included 137 community-dwelling older adults. Equipment consisted of a cord with a fixed handle on one end and a sliding handle on the other. The sliding handle was adjusted so that the cord length between the 2 handles equaled the participant's shoulder width. Holding the 2 handles, the participant must pass the cord from the front of the body over the head and as far back as possible with extended arms. The score is the fanning-out angle. Forward flexion, abduction, horizontal retroflexion, and outward rotation were also measured. The test and criterion measurements were administered within 1 wk. The criterion-related validity of the circumduction test as a measure of forward flexion and horizontal retroflexion received support from moderate correlations. Its use as a measure of abduction and outward rotation, however, received no support from the data. ABSTRACT FROM AUTHOR},
