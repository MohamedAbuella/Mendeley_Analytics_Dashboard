journal = {IEEE Transactions on Knowledge and Data Engineering},
keywords = {Data science trajectories,PhyML,data mining,data-driven methodologies,knowledge discovery process,review,shipping},
mendeley-tags = {PhyML,review,shipping},
number = {8},
pages = {3048--3061},
