keywords = {Building,Fuel cell,Hybrid power system,Hydrogen,Libya,Modelling and simulation,RE Teaching,Renewable energy,Solar PV,Very High cited doc},
mendeley-tags = {Hydrogen,Libya,RE Teaching,Very High cited doc},
pages = {180--189},
publisher = {Elsevier Ltd},
title = {{Modelling and performance analysis of a stand-alone hybrid solar PV/Fuel Cell/Diesel Generator power system for university building}},
