journal = {Energy Conversion and Management},
keywords = {Expert input selection,Online learning,Prediction of holidays,Random forest,Short term load forecast,Variable importance},
pages = {1040--1051},
publisher = {Elsevier Ltd},
title = {{Day-ahead load forecast using random forest and expert input selection}},
url = {http://dx.doi.org/10.1016/j.enconman.2015.07.041},
volume = {103},
year = {2015}
}
