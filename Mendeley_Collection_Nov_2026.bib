issn = {15582191},
journal = {IEEE Transactions on Knowledge and Data Engineering},
keywords = {Earth observation data,Earth science,Geoscience,Machine learning,PhyML,Physics-based models,Very High cited doc,review,shipping},
mendeley-tags = {PhyML,Very High cited doc,review,shipping},
number = {8},
pages = {1544--1554},
publisher = {IEEE},
title = {{Machine Learning for the Geosciences: Challenges and Opportunities}},
volume = {31},
year = {2019}
