journal = {Applied Energy},
keywords = {Controllable load,Coordinated system planning,Coupled microgrid,Multi-Vector Energy System,Natural gas systems,OR,Theoretical Background,important doc},
mendeley-tags = {Multi-Vector Energy System,OR,Theoretical Background,important doc},
number = {August 2017},
pages = {361--369},
publisher = {Elsevier},
title = {{Planning of solar photovoltaics, battery energy storage system and gas micro turbine for coupled micro energy grids}},
url = {https://doi.org/10.1016/j.apenergy.2017.09.066},
volume = {219},
year = {2018}
