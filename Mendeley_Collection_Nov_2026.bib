@article{Christodoulou2020b,
abstract = {The integration of shipping into multimodal supply chains represents a major challenge for the transport industry due to the reduced external effects of waterborne transport compared to land-based modes of transport. Roll on-Roll off (RoRo) shipping represents a maritime segment that could easily form part of an intermodal transport system, due to the fast cargo handling and the high frequency of departures. RoRo segment is quite developed in Sweden, representing 22% of the maritime segments, while forestry industry is one of the main shippers of RoRo services in the intra-European trade. This paper analyses the purchasing chain of forestry RoRo shipping services and identifies the determinants that have impact on its competitiveness. 8 semi-structured interviews with RoRo shipping operators, forestry companies and freight forwarders in Sweden were conducted, providing valuable input to this study. A taxonomy of determinant factors in the purchasing process of forestry RoRo shipping services is developed highlighting the interactions between them and drawing attention to the barriers that prevent the further employment of this transport mode. The results suggest that a different management ‘culture' on carriers-shippers' relationships and efficient port operations are key determinants for the establishment of successful intermodal RoRo services.},
author = {Christodoulou, Anastasia and Kappelin, Henrik},
doi = {10.1016/j.cstp.2020.07.008},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Christodoulou, Kappelin - 2020 - Determinant factors for the development of maritime supply chains The case of the Swedish forest ind(3).pdf:pdf},
issn = {22136258},
journal = {Case Studies on Transport Policy},
keywords = {Forest industry,Intermodal supply chains,Multimodal maritime transport,Purchasing,RoRo shipping,Short sea shipping},
month = {sep},
number = {3},
pages = {711--720},
publisher = {Elsevier Ltd},
title = {{Determinant factors for the development of maritime supply chains: The case of the Swedish forest industry}},
volume = {8},
year = {2020}
}
