keywords = {Capacity optimization,Compressed air energy storage,GASnets,GT,GT-IES,Game theory,HGT,Integrated energy systems,Multi-Vector Energy System,Nash equilibrium,OR,Shapley value,Theoretical Background,Very High cited doc,important doc},
mendeley-tags = {GASnets,GT,GT-IES,HGT,Multi-Vector Energy System,OR,Theoretical Background,Very High cited doc,important doc},
