file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Drgoňa et al. - 2020 - All you need to know about model predictive control for buildings.pdf:pdf},
issn = {13675788},
journal = {Annual Reviews in Control},
keywords = {Building climate control,Heating,MPC formulation,MPC implementation,MPC software tools,Model predictive control,OR,PhyML,RE Teaching,RL,Theoretical Background,Very High cited doc,climate,important doc,review,sysid},
mendeley-tags = {Heating,OR,PhyML,RE Teaching,RL,Theoretical Background,Very High cited doc,climate,important doc,review,sysid},
