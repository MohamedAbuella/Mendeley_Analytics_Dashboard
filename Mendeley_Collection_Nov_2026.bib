@article{Gallego2014,
abstract = {In order to implement accurate models for wind power ramp forecasting, ramps need to be previously\r characterised. This issue has been typically addressed by performing binary ramp/non-ramp\r classifications based on ad-hoc assessed thresholds. However, recent works question this approach.\r This paper presents the ramp function, an innovative wavelet- based tool which detects and\r characterises ramp events in wind power time series. The underlying idea is to assess a continuous\r index related to the ramp intensity at each time step, which is obtained by considering large power\r output gradients evaluated under different time scales (up to typical ramp durations). The ramp\r function overcomes some of the drawbacks shown by the aforementioned binary classification and\r permits forecasters to easily reveal specific features of the ramp behaviour observed at a wind\r farm. As an example, the daily profile of the ramp-up and ramp-down intensities are obtained for the\r case of a wind farm located in Spain.},
author = {Gallego, Crist{\'{o}}bal and Cuerva, {\'{A}}lvaro and Costa, Alexandre},
doi = {10.1088/1742-6596/555/1/012040},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Gallego, Cuerva, Costa - 2014 - Detecting and characterising ramp events in wind power time series.pdf:pdf},
issn = {1742-6588},
journal = {Journal of Physics: Conference Series},
number = {1},
pages = {012040},
title = {{Detecting and characterising ramp events in wind power time series}},
url = {http://stacks.iop.org/1742-6596/555/i=1/a=012040},
volume = {555},
year = {2014}
}
