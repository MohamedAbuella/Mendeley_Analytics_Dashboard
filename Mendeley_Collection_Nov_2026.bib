issn = {1470174X},
journal = {Studies in Higher Education},
keywords = {Meta-analysis,Narrative literature review,PhD students,Postdoctoral study},
number = {10},
pages = {1756--1769},
title = {{Publishing not perishing: How research students transition from novice to knowledgeable using systematic quantitative literature reviews}},
volume = {40},
year = {2014}
}
