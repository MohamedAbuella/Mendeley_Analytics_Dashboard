eprint = {1905.05529},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Li et al. - 2019 - Entity-relation extraction as multi-turn question answering(2).pdf:pdf},
isbn = {9781950737482},
journal = {ACL 2019 - 57th Annual Meeting of the Association for Computational Linguistics, Proceedings of the Conference},
pages = {1340--1350},
title = {{Entity-relation extraction as multi-turn question answering}},
year = {2020}
}
