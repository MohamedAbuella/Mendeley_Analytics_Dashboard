keywords = {GNN,Theoretical Background,Traffic forecasting,Very High cited doc,shipping,spatial dependence,temporal dependence,temporal graph convolutional network (T-GCN)},
mendeley-tags = {GNN,Theoretical Background,Very High cited doc,shipping},
