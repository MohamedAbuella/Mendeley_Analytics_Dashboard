@techreport{Hiremath2021a,
abstract = {Delay in the delivery of finished goods causes many problems to organizations. As suggested by previous literature, there are many causes that delay delivery, including prominent enablers such as labor productivity, machine breakdown, shortage and delivery of raw materials, capacity utilization, weather conditions, logistics, and planning and scheduling. However, no study has addressed the hierarchical links between all these enablers. This study has used the Total Interpretive Structural Model (TISM) to understand these links. A fuzzy matrix multiplication was applied to understand the degree of influence between the selected enablers. Most of the studies use interpretive structural model to draw diagraph and Matriced' Impacts Crois{\'{e}}s Multiplication Appliqu{\'{e}}e {\'{a}} un Classement (cross-impact matrix multiplication applied to classification) to cluster the enablers. This study uses both simultaneously to characterize the hierarchical linkages. The study found that machine breakdown, planning and scheduling were driving variables. Plant capacity utilization and labor productivity emerged as linking variables. The shortage of raw materials was the only dependent enabler. The weather conditions and logistics were autonomous variables. The fuzzy TISM elucidated that shortage of raw material caused delays in final delivery. The raw material shortages were due to improper planning and scheduling of acquisition and this coupled with breakdown of machinery caused deviations in capacity utilization and affected labor productivity. Based on the linkages present among the enablers, the study concluded that proper planning and scheduling of preventive maintenance by management would alleviate delays considerably.},
author = {Hiremath, Chetan V and Halagatti, Mahantesh B and Dyasanur, Aishwarya and Banakar, Vinayak S},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Hiremath, Halagatti, ... - 2021 - Unveiling the Linkages Between Enablers for.pdf:pdf},
title = {{Unveiling the Linkages Between Enablers for On-Time Dispatch of Finished Goods in SMEs: An Integrative TISM-Fuzzy MICMAC Analysis}},
year = {2021}
}
