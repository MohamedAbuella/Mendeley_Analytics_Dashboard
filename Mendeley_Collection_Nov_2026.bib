keywords = {AIS,Artificial intelligence,Automatic identification systems data,DBSCAN algorithm,Machine learning,Maritime autonomous surface ships,Path,Ship maneuvering guidelines,Ship trajectory,Theoretical Background,important doc,shipping},
mendeley-tags = {AIS,Path,Theoretical Background,important doc,shipping},
number = {2},
pages = {1--33},
title = {{An AIS data-driven approach to analyze the pattern of ship trajectories in ports using the DBSCAN algorithm}},
volume = {11},
