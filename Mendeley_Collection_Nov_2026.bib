issn = {03062619},
keywords = {Building energy,Deep learning,Electric vehicles,HVAC control,Machine learning,RL,Smart grid},
mendeley-tags = {RL},
month = {feb},
pages = {1072--1089},
publisher = {Elsevier Ltd},
title = {{Reinforcement learning for demand response: A review of algorithms and modeling techniques}},
volume = {235},
