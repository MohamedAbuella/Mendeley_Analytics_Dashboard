journal = {Energy Strategy Reviews},
keywords = {Climate change mitigation,Decarbonization,Energy system modelling,Heating,Hydrogen,Hydrogen economy,OR,OSeMOSYS,RE Teaching,TEA,Theoretical Background,important doc},
mendeley-tags = {Heating,Hydrogen,OR,OSeMOSYS,RE Teaching,TEA,Theoretical Background,important doc},
