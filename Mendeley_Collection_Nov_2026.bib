issn = {15582183},
journal = {IEEE Transactions on Parallel and Distributed Systems},
keywords = {Edge user allocation,GT,Nash equilibrium,OR,Very High cited doc,cost-effectiveness,edge computing,edge server,game theory,multi-tenancy,pay-as-you-go},
