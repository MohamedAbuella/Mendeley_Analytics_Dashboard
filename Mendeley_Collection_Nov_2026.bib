file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Nguena Nguefack et al. - 2020 - Trajectory modelling techniques useful to epidemiological research A comparative narrative review of (2).pdf:pdf},
issn = {11791349},
keywords = {Cluster analysis,Group-based trajectory modelling,Growth mixture modelling,Latent class analysis,Latent transition analysis,Modelling techniques,Sequence analysis},
pages = {1205--1222},
publisher = {Dove Medical Press Ltd},
title = {{Trajectory modelling techniques useful to epidemiological research: A comparative narrative review of approaches}},
volume = {12},
