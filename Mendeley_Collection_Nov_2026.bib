journal = {Renewable and Sustainable Energy Reviews},
keywords = {Energy efficiency,Energy storage,High cited doc,Hydrogen,Libya,RE Teaching,Renewable energy,Sustainable development,Theoretical Background,important doc,review},
mendeley-tags = {High cited doc,Hydrogen,Libya,RE Teaching,Theoretical Background,important doc,review},
number = {February},
