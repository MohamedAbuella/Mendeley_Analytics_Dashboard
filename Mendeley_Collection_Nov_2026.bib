file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Albadi et al. - 2020 - Enhancing electricity supply mix in Oman with energy storage systems a case study ABSTRACT.pdf:pdf},
issn = {19397046},
journal = {International Journal of Sustainable Engineering},
keywords = {Renewable energy resources,pumped-hydroelectric energy storage,techno-economic evaluation},
number = {3},
pages = {487--496},
publisher = {Taylor & Francis},
title = {{Enhancing electricity supply mix in Oman with energy storage systems: a case study}},
url = {https://doi.org/10.1080/19397038.2020.1773570},
