doi = {10.1109/TPWRS.2013.2266378},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Sevlian, Rajagopal - 2013 - Detection and statistics of wind power ramps(2).pdf:pdf},
