journal = {Sustainability (Switzerland)},
keywords = {Freight transport,Maritime policy,Modal competition,SSS,Short sea shipping,Southern African Development Community,important doc,shipping},
mendeley-tags = {SSS,important doc,shipping},
number = {6},
pages = {1--16},
title = {{Barriers and enablers for short sea shipping in the Southern African Development Community}},
volume = {11},
