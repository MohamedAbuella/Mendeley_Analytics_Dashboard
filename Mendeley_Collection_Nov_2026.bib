keywords = {Europe,GASnets,Heating,Hydrogen,PyPSA,TEA,Theoretical Background,Very High cited doc,carbon-neutrality,energy system modeling,energy systems,hydrogen network,pipeline retrofitting,renewable energy,sector-coupling,transmission},
