issn = {23524847},
journal = {Energy Reports},
keywords = {Optimal power flow,Parallel computing,PhyML,RL,Reinforcement learning,TD3,Theoretical Background,shipping},
mendeley-tags = {PhyML,RL,Theoretical Background,shipping},
pages = {43--50},
