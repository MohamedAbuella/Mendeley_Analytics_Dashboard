journal = {Journal of the Japan Society of Naval Architects and Ocean Engineers},
keywords = {PhyML,Theoretical Background,shipping},
mendeley-tags = {PhyML,Theoretical Background,shipping},
number = {0},
pages = {37--43},
title = {{Slowly-varying Added Resistance in Irregular Waves in Consideration of Higher Order Components}},
volume = {28},
year = {2018}
}
