journal = {Compute},
pages = {1--9},
title = {{Linear Discriminant Analysis - a Brief Tutorial}},
url = {http://www.music.mcgill.ca/$\sim$ich/classes/mumt611_07/classifiers/lda_theory.pdf},
volume = {11},
year = {1998}
}
