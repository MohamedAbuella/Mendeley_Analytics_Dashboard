keywords = {Capacity utilisation strategy,Demand variations and trade imbalances,Liner shipping,RoRo,Vessel capacity utilisation},
month = {dec},
number = {4},
pages = {418--437},
title = {{Strategies for capacity utilisation in short sea shipping}},
volume = {11},
year = {2009}
}
