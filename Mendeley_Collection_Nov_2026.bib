keywords = {CO2 emissions,IMO2050,Integrated assessment modelling,International shipping,OR,climate,shipping},
mendeley-tags = {OR,climate,shipping},
month = {dec},
publisher = {Elsevier Ltd},
title = {{Global futures of trade impacting the challenge to decarbonize the international shipping sector}},
volume = {237},
year = {2021}
