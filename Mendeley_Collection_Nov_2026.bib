@techreport{JoseDeCarvalho,
abstract = {1. Radia{\c{c}}{\~{a}}o Solar. 1.1. Recurso solar e meteorologia da radia{\c{c}}{\~{a}}o solar. Resumo. As tecnologias de gera{\c{c}}{\~{a}}o de energia solar, como os sistemas fotovoltaicos e concentradores de energia solar, dependem quase que exclusivamente da incid{\^{e}}ncia direta da radia{\c{c}}{\~{a}}o solar. Esse recurso, visto da superf{\'{i}}cie da Terra, possui uma varia{\c{c}}{\~{a}}o conforme condi{\c{c}}{\~{o}}es de sombreamento por nuvens. As nuvens s{\~{a}}o capazes de baixar drasticamente em poucos minutos a radia{\c{c}}{\~{a}}o solar direta, assim trazendo varia{\c{c}}{\~{o}}es abruptas n{\~{a}}o planejadas na gera{\c{c}}{\~{a}}o e distribui{\c{c}}{\~{a}}o de energia. Sendo assim, para inserir cada vez mais essas tecnologias {\`{a}}s redes de distribui{\c{c}}{\~{a}}o, torna-se necess{\'{a}}rio prever interrup{\c{c}}{\~{o}}es de gera{\c{c}}{\~{a}}o de energia provenientes de sombreamentos, para que outro sistema de gera{\c{c}}{\~{a}}o de energia, que n{\~{a}}o dependa exclusivamente da irradia{\c{c}}{\~{a}}o solar direta, seja iniciado. O intuito deste trabalho foi desenvolver inicialmente uma revis{\~{a}}o sistem{\'{a}}tica da bibliografia e uma an{\'{a}}lise bibliom{\'{e}}trica sobre previs{\~{a}}o solar de curto prazo, a partir de artigos presentes nas bases de dados da Scopus e Web of Science. Foi utilizada uma combina{\c{c}}{\~{a}}o de palavras-chave, de forma a conhecer os principais m{\'{e}}todos que vem sendo discutidos, os principais pesquisadores da {\'{a}}rea, onde essas pesquisas ent{\~{a}}o sendo desenvolvidas e a que ponto est{\~{a}}o as pesquisas em rela{\c{c}}{\~{a}}o as previs{\~{o}}es. Por fim, foi feito uma busca em bases de dados de publica{\c{c}}{\~{o}}es nacionais, com o intuito de enfatizar alguns dos principais trabalhos desenvolvidos neste tema em quest{\~{a}}o no Brasil. Palavras-chave: Previs{\~{a}}o solar de curto prazo; Energia fotovoltaica; Previs{\~{a}}o solar intra-hora.},
author = {{Jos{\'{e}} De Carvalho}, Matheus},
