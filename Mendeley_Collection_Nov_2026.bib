isbn = {9781509022519},
journal = {Proceedings - 2016 IEEE 2nd International Conference on Big Data Computing Service and Applications, BigDataService 2016},
keywords = {Logistic regression,Ramp PV,temporal uncertainty,wind ramp prediction},
