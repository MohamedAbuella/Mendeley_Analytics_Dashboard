@incollection{Wunsch2019a,
abstract = {Inverse problems and methods in an oceanographic context are almost always ones of statistical estimation theory. They normally involve a combination of a “model” of some form, as well as observational data. The presence of noise in data, and the common issue of sparse sampling leads inevitably to a discussion of ill-posedness. Examples in the oceanographic sciences abound—from purely physical ones to those involving complex biogeochemical data and models. The most commonly used solution methods are formulated as variants of conventional least-squares, but other options do exist. A good inverse method will extract useful information from incomplete and inconsistent data while providing information about reliability.},
author = {Wunsch, Carl},
