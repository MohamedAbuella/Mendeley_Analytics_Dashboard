volume = {2},
year = {2016}
}
@article{DAmico2014,
abstract = {The prediction of wind speed is one of the most important aspects when dealing with renewable energy. In this paper we show a new nonparametric model, based on semi-Markov chains, to predict wind speed and the energy produced by a commercial blade. Particularly, we use an indexed semi-Markov model, that reproduces accurately the statistical behavior of wind speed. The model is used to forecast future wind speed and the energy produced through a 10 kW Aircon wind turbine. We forecast one step ahead and for different time scales. In order to check the main features of the model we show, as indicator of goodness, the root mean square error between real data and predicted ones. We compare our forecasting results with those of a persistence model and of an autoregressive model. ?? 2014 Elsevier B.V. All rights reserved.},
