@techreport{Patil,
abstract = {Power producers are looking for ways to reduce carbon emissions without compromising their market competitiveness. To meet this challenge, classic baseload fossil-fuel-burning power plants are diversifying electricity production by enhancing renewables in the mix. Also, for the optimization of the Power Plants to use the most efficient transmission depending upon load variance, weather statistics, power plant rated efficiency and primary energy conversion factors different model simulations are now being used. OEMOF is one of those enhancing energy modelling systems which is a modular open-source framework. The functional database is integrated with Python "Pandas" library. In this report, a detailed outline of the Power Plant System optimization for Denmark has been done. The analytical data assimilation for the year of 2018 has been modelled and based on energy demand, plant output accumulation a simulated model for 2030 has been proposed. In the data aggregation, the relative power output for each type of energy source has been outlined concerning primary energy sources that are used in present and is forecasted to be utilized in future. The summarized result that was observed was the power demand is higher in the Winter season which is mainly covered by CHP and Wind Plants. Comparatively lower energy demand in the Summer season is attributed mostly by Wind Power Plants. Although in Summer the PV power generation is high still it covers a very small amount of demand as it is not feasible due to weather condition in Denmark. Fossil fuels are being substituted by biomass, waste material, biofuel rapidly in the CHP plants which is attributing in CO2 reduction. At the same time more Wind Power Plants, PV Plants are being installed to increase the liability in the Renewable sector more. The report also represents data related to Energy import and export from Denmark with time variance over the year. A comprehensive study has also been conducted in this report to profile the CO2 emission scenario and how lower scale emission data can be achieved has been proposed based on energy optimization model. So, a detailed forecast has been made for 2030 based on the Danish Energy Agency (DEA) goals, future power plant instalment proposals in line with the increasing demand for energy. The 2018 model which has been outlined and calibrated with the existing data has been taken as the standard parameter to scale up the optimization for 2030. So, the results are believed to be well-coordinated and approves Denmark's 2030 visions for energy accumulation by different sectors. There were some drawbacks in the field of energy storage, forecasting of the complicated energy economics. Henceforth assumptions have been taken based on the EU Energy market and Danish Power Transmission data to provide a statistical representation which helps to build a general understanding of the whole energy model with cost amassment. The report is a reflection of both statistical studies with governed power plant equations, energy economics and energy framework that have been modelled by OEMOF. The conducted results have been evaluated separately. Both the results show a significant resemblance of derived final results which leads to the fact that the framework model done by OEMOF itself is veracious. More accuracy is always possible and the authors accept that fact by also proposing some future model recommendation. iii},
author = {Patil, Parag Rajan},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Dhamale et al. - 2020 - ENERGY SYSTEM MODELLING OF DENMARK USING OEMOF.pdf:pdf},
title = {{ENERGY SYSTEM MODELLING OF DENMARK USING OEMOF PROJECT REPORT SUBMITTED TO DEPARTMENT OF OF RENEWABLE ENERGY SYSTEMS HOCHSCHULE NORDHAUSEN}}
}
