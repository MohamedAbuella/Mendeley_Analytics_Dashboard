@techreport{Using2024,
abstract = {View Takashi YANASE's profile Takashi YANASE • 2nd Tokyo Electric Power Services Company - Manager Tokyo Electric Power Company Holdings, Inc. - Manager University of Tokyo - Doctoral Student 12h • Edited • ■Base-Year Validation: Simulating Japan's 2024 Power Grid with PyPSA As part of our energy modeling framework development for long-term power system evaluation, we completed an hourly 8,760-hour base-year simulation of Japan's 2024 power supply and demand using an LP cost-minimization model. This check serves as a critical diagnostic to validate structural behavior and characterize model limitations before expanding to future snapshots. ■Quick Takeaways (Model vs. Actual 2024 Data): Renewables: Solar (12.6% model vs. 11.4% actual) and Hydro (8.9% model vs. 7.9% actual) aligned closely with observed ISEP statistics. Thermal Mix Bias: A pure merit-order LP formulation naturally overstated coal (+11.5 pt) and understated gas (-7.6 pt). This benchmark highlights the exact system impact of real-world operational constraints such as LNG take-or-pay contracts and unit commitment limits. Core Metrics: Total cleared generation reached 858.5 TWh with a CO2 intensity of 443 g-CO2/kWh. ■What's Next? The model successfully demonstrated its capability to appropriately represent the seasonal and time-of-day structure of residual demand, such as the sharp midday drops during spring light-load weeks. We are now scaling this framework into a 9-node regional configuration to endogenously capture inter-regional transmission constraints across Japan's major utility areas. For full methodology and validation parameters, refer to my report: "2024_Supply-Demand_Simulation_by PyPSA_Report_EN.pdf".},
author = {Using, Base-year Calculation and Model, Linear-programming Cost-minimization},
file = {:C\:/HP Folders/+Folder 2022/+H_OR/2024_Supply-Demand_Simulation_by PyPSA_Report_EN.pdf:pdf},
keywords = {OR,Theoretical Background,important doc},
mendeley-tags = {OR,Theoretical Background,important doc},
title = {{Results of a Power Supply – Demand Simulation for Japan at the 2024 Snapshot}},
year = {2024}
}
@inproceedings{VandenBoom2014b,
abstract = {The speed/power characteristics of ships have always been at the core of ship design. To prove contractually agreed values, speed trials are conducted by the yard prior to delivery of the ship to the owner. In the past schedule integrity of the vessel was often the most important factor for the speed requirement. Today, owners and operators are keen to reduce fuel consumption to decrease operational costs. So far a variety of methods for conducting and analyzing speed/power trials have been used by shipyards. With the assistance of the Sea Trial Analysis-Joint Industry Project, ITTC developed guidelines for the execution and analysis of speed/power trials compliant with IMO EEDI. The need to reduce fuel costs and exhaust gas emissions including the upcoming environmental regulations such as EEOI by IMO urge for reliable monitoring of ship performance in service conditions. This requires accurate information of the speed through water. Although the speed log is one of the oldest instruments on board it is not considered the most reliable one. Results of an extensive monitoring campaign on board a 1800 TEU container vessel equipped with six speed logs within SPA-JIP will be presented. The state of art of performance monitoring will be presented.},
author = {van den Boom, Henk J.J. and Hasselaar, Thijs W.F.},
booktitle = {SNAME Maritime Convention 2014, SMC 2014},
doi = {10.5957/SMC-2014-t04},
