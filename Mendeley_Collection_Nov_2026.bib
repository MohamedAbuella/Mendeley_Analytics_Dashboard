@article{Bruno2020,
abstract = {The present paper deals with a performance assessment of the ERA5 wave dataset in an ocean basin where local wind waves superimpose on swell waves. The evaluation framework relies on observed wave data collected during a coastal experimental campaign carried out offshore of the southern Oman coast in the Western Arabian Sea. The applied procedure requires a detailed investigation on the observed waves, and aims at classifying wave regimes: observed wave spectra have been split using a 2D partition scheme and wave characteristics have been evaluated for each wave component. Once the wave climate was defined, a detailed wave model assessment was performed. The results revealed that during the analyzed time span the ERA5 wave model overestimates the swell wave heights, whereas the wind waves' height prediction is highly influenced by the wave developing conditions. The collected field dataset is also useful for a discussion on spectral wave characteristics during monsoon and post-monsoon season in the examined region; the recorded wave data do not suffice yet to adequately describe wave fields generated by the interaction of monsoon and local winds.},
author = {Bruno, Maria Francesca and Molfetta, Matteo Gianluca and Totaro, Vincenzo and Mossa, Michele},
doi = {10.3390/jmse8030214},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Bruno et al. - 2020 - Performance assessment of ERA5 wave data in a swell dominated region.pdf:pdf},
issn = {20771312},
journal = {Journal of Marine Science and Engineering},
keywords = {Arabian Sea,Model performance evaluation,Monsoon,SSS,Spectra partitioning,Swell,WSR,copernicus_marine,important doc,shipping},
mendeley-tags = {SSS,WSR,copernicus_marine,important doc,shipping},
number = {3},
title = {{Performance assessment of ERA5 wave data in a swell dominated region}},
volume = {8},
year = {2020}
}
