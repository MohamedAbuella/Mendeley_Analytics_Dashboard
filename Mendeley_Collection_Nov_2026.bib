@article{Barforoushi2010,
abstract = {A new hybrid framework based on game theory and dynamic programming (DP) with random demands and prices is proposed for studying the impacts of regulatory interventions on the dynamics of investment in power generation in electricity markets. In our approach, using Markov chains, the electric demand and growth of fuel prices have been modeled. DP has been used for solving the generation expansion planning (GEP) problem. Investment strategies of other investors in the market are modeled as constraints. The income of the investor is calculated by modeling strategic interactions among market players in the spot energy market. The Cournot game concept has been applied and the Nash equilibrium is calculated for each state and stage of DP. Simulation results confirm that the proposed framework is an appropriate decision-support tool that provides useful information about dynamics of investment. {\textcopyright} 2006 IEEE.},
author = {Barforoushi, Taghi and Moghaddam, Mohsen P. and Javidi, M. Hossein and Sheikh-El-Eslami, Mohammad K.},
doi = {10.1109/TPWRS.2010.2049034},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Barforoushi et al. - 2010 - Evaluation of regulatory impacts on dynamic behavior of investments in electricity markets A new hybrid DPGA.pdf:pdf},
issn = {08858950},
journal = {IEEE Transactions on Power Systems},
keywords = {Electricity markets,GT,GT-IES,Multi-Vector Energy System,OR,Theoretical Background,game theory,generation expansion planning,important doc,investment dynamics,stochastic dynamic programming},
mendeley-tags = {GT,GT-IES,Multi-Vector Energy System,OR,Theoretical Background,important doc},
number = {4},
pages = {1978--1986},
publisher = {IEEE},
title = {{Evaluation of regulatory impacts on dynamic behavior of investments in electricity markets: A new hybrid DP/GAME framework}},
volume = {25},
year = {2010}
}
