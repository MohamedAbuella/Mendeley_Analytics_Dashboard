file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Lacal Arantegui, J{\"{a}}ger-Waldau - 2018 - Photovoltaics and wind status in the European Union after the Paris Agreement.pdf:pdf},
issn = {18790690},
journal = {Renewable and Sustainable Energy Reviews},
keywords = {Market development,Paris Agreement (COP 21),Photovoltaic,Policy options,Technological development,Wind energy,important doc},
mendeley-tags = {important doc},
number = {June 2017},
pages = {2460--2471},
publisher = {Elsevier Ltd},
title = {{Photovoltaics and wind status in the European Union after the Paris Agreement}},
