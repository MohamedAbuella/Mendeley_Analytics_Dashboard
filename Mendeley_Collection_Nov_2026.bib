journal = {Journal of International Logistics and Trade},
keywords = {Bayesian Networks,Korea Unification Era,Shipping,Simulation,South-North Korea maritime co-operation,Vessel traffic},
number = {2},
pages = {91--105},
publisher = {Jungseok Research Institute of International Logistics and Trade},
title = {{Short sea shipping on the West Coast of Korea: Keys to activating the shipping industry in preparation for korea unification era}},
