keywords = {Automated market making,Blockchain,Energy market,GT,Mechanism design,OR},
mendeley-tags = {GT,OR},
pages = {99--113},
publisher = {Elsevier Ltd},
title = {{Deployment and analysis of a blockchain-based local energy market}},
url = {https://doi.org/10.1016/j.egyr.2021.11.283},
volume = {8},
year = {2022}
}
