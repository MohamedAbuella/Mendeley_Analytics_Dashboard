journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
keywords = {AIS,Destination prediction,Graph model,Heterogeneous graph,Link prediction,Machine learning,Maritime transportation,shipping},
mendeley-tags = {AIS,shipping},
pages = {80--93},
title = {{Vessel Destination Prediction Using a Graph-Based Machine Learning Model}},
volume = {13197 LNCS},
year = {2022}
