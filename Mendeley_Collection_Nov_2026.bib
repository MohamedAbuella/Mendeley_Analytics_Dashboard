issn = {09596526},
journal = {Journal of Cleaner Production},
keywords = {AIrev,Alternative marine fuels,Decarbonization,International maritime organization,Maritime transport,Research trend,Shipping emissions,climate,important doc,review,shipping},
mendeley-tags = {AIrev,climate,important doc,review,shipping},
