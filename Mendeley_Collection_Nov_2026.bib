file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Transit - 2020 - Deep Learning Architecture for Short-Term Passenger Flow Forecasting in Urban Rail Transit.pdf:pdf},
issn = {15580016},
journal = {IEEE Transactions on Intelligent Transportation Systems},
keywords = {Attention long short-term memory,deep learning,graph convolutional network,residual network,short-term passenger flow forecasting},
month = {nov},
number = {11},
pages = {7004--7014},
publisher = {Institute of Electrical and Electronics Engineers Inc.},
title = {{Deep Learning Architecture for Short-Term Passenger Flow Forecasting in Urban Rail Transit}},
volume = {22},
year = {2021}
}
