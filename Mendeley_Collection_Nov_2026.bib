file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Smil - 2010 - Science, energy, ethics, and civilization.pdf:pdf},
isbn = {9780521882392},
journal = {Visions of Discovery: New Light on Physics, Cosmology, and Consciousness},
pages = {709--729},
title = {{Science, energy, ethics, and civilization}},
url = {http://vaclavsmil.com/wp-content/uploads/docs/smil-articles-science-energy-ethics-civilization.pdf},
year = {2010}
}
