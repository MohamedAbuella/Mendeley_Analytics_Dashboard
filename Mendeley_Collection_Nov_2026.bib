journal = {Renewable Energy},
keywords = {Adequacy energy source,Economic and environment analysis,Multi-objective optimization,OR,Renewable energy,Sustainable generation system,TEA,Theoretical Background,Very High cited doc},
mendeley-tags = {OR,TEA,Theoretical Background,Very High cited doc},
pages = {308--318},
