issn = {23524677},
journal = {Sustainable Energy, Grids and Networks},
keywords = {Ancillary services,Frequency control,OR,Renewable energy,Stochastic economic model predictive control,Stochastic programming,Storage degradation,Theoretical Background,important doc},
mendeley-tags = {OR,Theoretical Background,important doc},
number = {January},
pages = {101373},
publisher = {Elsevier Ltd},
title = {{Stochastic economic model predictive control for renewable energy and ancillary services trading with storage}},
