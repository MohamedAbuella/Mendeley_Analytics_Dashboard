keywords = {Accident statistics,Collision modelling,Gulf of Finland,Marine traffic safety,Very High cited doc,shipping},
mendeley-tags = {Very High cited doc,shipping},
number = {8},
pages = {1349--1357},
title = {{Analysis of the marine traffic safety in the Gulf of Finland}},
volume = {94},
year = {2009}
}
