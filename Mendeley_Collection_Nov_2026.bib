keywords = {CIS,Energy production,France,HIT,PI,Performance Index,Performance Ratio,Residential PV system},
number = {2},
pages = {1369--1376},
title = {{Review of the performance of residential PV systems in France}},
volume = {16},
year = {2012}
}
