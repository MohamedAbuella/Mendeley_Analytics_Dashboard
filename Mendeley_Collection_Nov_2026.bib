keywords = {Abatement options,Emission reductions,Greenhouse gases,Maritime transport,Shipping and the environment,Theoretical Background,Very High cited doc,WSR,review,shipping},
mendeley-tags = {Theoretical Background,Very High cited doc,WSR,review,shipping},
pages = {408--421},
publisher = {The Authors},
title = {{State-of-the-art technologies, measures, and potential for reducing GHG emissions from shipping – A review}},
