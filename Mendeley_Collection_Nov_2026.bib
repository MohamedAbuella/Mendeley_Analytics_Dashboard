issn = {20837429},
journal = {Polish Maritime Research},
keywords = {Theoretical Background,course alteration,mathematical model,navigation safety,passage planning,shipping,wheel over point},
mendeley-tags = {Theoretical Background,shipping},
number = {3},
pages = {156--174},
title = {{Development of WOP Mathematical Model for Optimum Track-Keeping. A Ship Simulation Study Using VLCC, Focusing on Hard over Rudder Turning Circle with Three Stages of Validation Analysis}},
