keywords = {Irradiance,Lattice data,Nonseparability,Semiparametric time series,Spatio-temporal model},
pages = {15--30},
publisher = {Elsevier Ltd},
title = {{A semiparametric spatio-temporal model for solar irradiance data}},
url = {http://dx.doi.org/10.1016/j.renene.2015.10.001},
volume = {87},
