journal = {TASK QUARTERLY},
keywords = {AIS,MariaDB SQL database,NMEA data,cache mechanism,net-Baltic project,virtualization},
number = {4},
pages = {321--331},
title = {{DATABASE AND BIGDATA PROCESSING SYSTEM FOR ANALYSIS OF AIS MESSAGES IN THE NETBALTIC RESEARCH PROJECT}},
url = {https://doi.org/10.17466/tq2017/21.4/a},
volume = {21},
year = {2017}
