@techreport{Dawadi,
abstract = {Literature review is a rigorous and lengthy process that requires a considerable amount of time and effort from the reviewers. With the availability of services such as text mining as well as software such as Mendeley, the literature review process has been highly simplified. Similarly, there are numerous readily available Python packages that provide an interesting automated approach to conducting literature reviews. However, for literature review, it is necessary that the reviewers have control over all of the steps to ensure that the results meet the main topic of research. We have developed a semi-automated screening process that can be used to filter papers by using their titles, abstracts and full-texts. First, the titles and abstracts of the papers are screened using separate sets of keywords each for title and abstract, and the papers that do not contain the keywords as specified by the reviewers are removed. In the next step, the full-texts of the remaining papers are screened by generating only those sentences that consist of the keywords specified for full-text screening. This approach significantly reduces the amount of time required to screen and read a collection of papers. Through this work, we aim to reduce the burden on reviewers in screening titles and abstracts and to facilitate the reading of the full-text of papers.},
author = {Dawadi, Research and Araki, Michihiro},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Dawadi, Araki - 2023 - A Semi-automatic Screening Mechanism for Literature Review(2).pdf:pdf},
keywords = {Literature review,Python,keyword screening,text mining},
title = {{A Semi-automatic Screening Mechanism for Literature Review}},
url = {https://ssrn.com/abstract=4521171}
}
@article{Cheli2021,
abstract = {Natural gas networks, thanks to their extensiveness and capillarity, could play a crucial role in the green transition of the energy sector. The decarbonization of a gas network can be achieved by injecting green hydrogen into the grid. This work aims to simulate a low-pressure natural gas distribution network serving industrial and residential users and subjected to one localized injection of hydrogen produced by renewable energy sources. The main quality indexes and fluid dynamics parameters of the gas mixture are analysed to understand the feasibility of injecting hydrogen into a natural gas network. Firstly, the network was examined under nominal steady conditions with a constant hydrogen injection. Then, the same grid was simulated considering a 24-h pattern of hydrogen injection, according to the power daily surplus. The results show that the grid can help to buffer the surplus of renewable power produced. The conclusions derived by the results underline that the effect of H2 injection is maximum during the highest excess of electricity and the importance of an accurate choice of the injection node: a wrong choice leads, at the peak of power production, leads to an amplification of the H2 injection impact and hence to a reduction of the Wobbe Index value that overcomes the safety lower limit.},
author = {Cheli, Lapo and Guzzo, Gabriele and Adolfo, Dominique and Carcasci, Carlo},
doi = {10.1016/j.ijhydene.2021.05.100},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Cheli et al. - 2021 - Steady-state analysis of a natural gas distribution network with hydrogen injection to absorb excess renewable ele.pdf:pdf},
issn = {03603199},
journal = {International Journal of Hydrogen Energy},
keywords = {GASnets,Gas distribution networks,High cited doc,Hydrogen,Natural gas,OR,Power-to-Gas,Sector coupling,Wobbe index},
mendeley-tags = {GASnets,High cited doc,Hydrogen,OR},
number = {50},
pages = {25562--25577},
publisher = {Elsevier Ltd},
title = {{Steady-state analysis of a natural gas distribution network with hydrogen injection to absorb excess renewable electricity}},
url = {https://doi.org/10.1016/j.ijhydene.2021.05.100},
volume = {46},
year = {2021}
}
