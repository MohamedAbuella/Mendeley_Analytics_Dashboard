issn = {15582256},
journal = {Proceedings of the IEEE},
keywords = {ASIC,OR,VLSI,Very High cited doc,computer architecture,convolutional neural networks,dataflow processing,deep learning,deep neural networks,energy-efficient accelerators,low power,machine learning,spatial architectures},
mendeley-tags = {OR,Very High cited doc},
