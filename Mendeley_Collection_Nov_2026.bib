@techreport{Abuellah,
abstract = {The rapid growth of renewable resources induces the need for new regulating and operating schemes in the power grid. Conventional power plants in the fleet impose their ramp-rate limits on the operation of these renewables to the point that, with a high-level integration of wind and solar resources, these ramp rate limits must be managed by situational awareness and curtailment mechanisms. These mechanisms depend on forecasts, especially those that consider the ramp events. This paper defines and implements a qualifying metric for the solar power forecasts to assess the capability of the forecasting models to predict the ramp events, especially by the combined forecasts. A case study is presented and the criterion is also used to evaluate the accuracy of the forecasts in terms of ramp events as well as to demonstrate the suitability of the forecasts in the applications that consider the ramp rates of solar power.},
author = {Abuella, Mohamed and Chowdhury, Badrul},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Abuella, Chowdhury - 2018 - Qualifying Combined Solar Power Forecasts in Ramp Events' Perspective.pdf:pdf},
keywords = {Index Terms-Evaluation metrics,ramp rates,solar power forecasting},
title = {{Qualifying Combined Solar Power Forecasts in Ramp Events' Perspective}}
}
