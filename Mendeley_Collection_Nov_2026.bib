journal = {Case Studies on Transport Policy},
keywords = {Forest industry,Intermodal supply chains,Multimodal maritime transport,Purchasing,RoRo shipping,SSS,Short sea shipping,important doc,shipping},
mendeley-tags = {SSS,important doc,shipping},
number = {3},
pages = {711--720},
publisher = {Elsevier},
title = {{Determinant factors for the development of maritime supply chains: The case of the Swedish forest industry}},
