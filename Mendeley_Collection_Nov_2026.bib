issn = {09518320},
journal = {Reliability Engineering and System Safety},
keywords = {CMAPSS,Deep learning,Hybrid model,PhyML,Prognostics,RUL,Theoretical Background,read,shipping},
mendeley-tags = {PhyML,RUL,Theoretical Background,read,shipping},
pages = {107961},
publisher = {Elsevier Ltd},
title = {{Fusing physics-based and deep learning models for prognostics}},
