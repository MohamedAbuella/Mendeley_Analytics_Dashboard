journal = {Renewable Energy},
keywords = {PV Simulation,PV power conversion,PV systems,Short-term prediction,Solar irradiance forecasting,Tropical regions},
mendeley-tags = {PV Simulation},
pages = {496--509},
title = {{PV power conversion and short-term forecasting in a tropical, densely-built environment in Singapore}},
volume = {94},
year = {2016}
}
