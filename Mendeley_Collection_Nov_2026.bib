journal = {Energy},
keywords = {Alternating direction method of multipliers,Cooperative game,GASnets,GT,Hydrogen,Hydrogen energy,Multi-Vector Energy System,Multi-park integrated energy system,Nash bargaining theory,OR,Theoretical Background,important doc},
mendeley-tags = {GASnets,GT,Hydrogen,Multi-Vector Energy System,OR,Theoretical Background,important doc},
