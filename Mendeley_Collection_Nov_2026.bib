eprint = {1808.08070},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Hilpert et al. - 2018 - The Open Energy Modelling Framework (oemof) - A new approach to facilitate open science in energy system modelli.pdf:pdf},
issn = {2211467X},
journal = {Energy Strategy Reviews},
keywords = {Collaborative development,Decision support,Energy system modelling,Open science,Optimization},
month = {nov},
pages = {16--25},
publisher = {Elsevier Ltd},
title = {{The Open Energy Modelling Framework (oemof) - A new approach to facilitate open science in energy system modelling}},
volume = {22},
year = {2018}
}
