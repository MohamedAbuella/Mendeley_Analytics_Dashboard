isbn = {9781713870906},
issn = {23521465},
keywords = {Autonomous navigation,DBSCAN,automatic identification system,expert system,knowledge of the water area,maritime waterways,ships position clustering,vessel traffic monitoring,water transport system},
pages = {383--388},
publisher = {Elsevier B.V.},
title = {{Assessment of the Possibility of Using a Waterway for Operation of Autonomous Ships}},
volume = {68},
year = {2022}
}
