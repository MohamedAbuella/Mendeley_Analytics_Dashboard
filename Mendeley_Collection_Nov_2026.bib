@techreport{YungTay,
abstract = {This paper presents the analysis to reduce carbon emission from tugboat operations by utilizing a proposed unsupervised machine learning operational scoring system. The time-series analysis is performed by transforming data into a common domain for clustering. The data are collected from a tugboat to investigate the correlation between environmental and location data with fuel consumption to achieve fuel efficiency. The relevant parameters that influence the fuel consumption of the tugboat, such as fuel consumption, vessel route, vessel speed and wind metrics are collected from sensors installed onboard the ship and data provider to monitor and to gauge the vessel's performance. The raw readings are conditioned (data cleaning and data pre-processing) before transformation to Score Dataset: the Raw mass-flowrate readings are cleaned by using the Haar wavelet; the wind raw reading is converted to wind effect data; the Location data is converted to vessel speed data. Together, they form a Score Dataset by applying the time series K-means clustering. The subsequent unsupervised learning identifies the activity labels that describe qualitatively the operations of the vessels and are obtained by using the non-time series K-mean clustering. By using the Hidden Markov Model approach, this paper attempts to explain the stochastic correlation among parameters explained earlier. The correlation is the information of newly discovered knowledge in terms of likelihood matrices, also known as the knowledge base (KB). The KB may be consumed to perform predictions. Hence, it is possible to suggest the optimal ship operation, i.e., speed that produces the optimum fuel consumption. The Score Dataset and clustering that are produced in this paper could also be used in the Artificial Neural Network for future work. Code Availability: https://github.com/J-Hadi-SIT/efficientship 2 1. INTRODUCTION In the upcoming years, the International Maritime Organization (IMO) pledges to reduce greenhouse gas emissions (GHG) minimally 40% by 2030 in marine transportation [1]. The reason for this is to tackle the rising concern of the depletion in the ozone layer which has an adverse effect on the environment. Currently, the cost-efficient predominant methods in transporting cargo and goods still revolve significantly around shipping vessels [2]. This is because the world is filled with 70% water, leading to the vitality of shipping transportation's needs as compared to other means of transportations [3]. This fact leads to a high demand for fuel consumption result in continuously soaring fuel prices in the past decades and the increase of greenhouse gas emitted from shipping activities. Hence there is a need to ensure that fuel is consumed wisely to reduce operating costs [4] and mitigate climate change. Given this, substantial research efforts had been conducted that focused on shipping vessels to reduce GHG emissions. One of the methods is by ensuring that the vessel operates at optimum fuel efficiency while travelling in the international ocean [5, 6]. However, most of the research and development focused on shipping vessels and neglected the micro point of view that tugboats also contributed significantly to GHG while assisting these vessels docking. Based on Singapore sea straits, tugboats standalone contributed to an overall figure of 993 tonnes/day of CO2 emission [7], equivalent to 78,793 numbers of typical passenger vehicles in a single day. This information is calculated based on 4.6 metric tonnes/years of carbon emissions produced from a passenger vehicle [8]. This paper would adopt the collection of real operation data of a selected tugboat currently operating in the Singapore area coastline port. To acquire operational data, various sensors are deployed to capture variable features such as wind direction, wind speed, and vessel speed installed onboard that strongly influence the fuel consumption rate [9]. This information would subsequently be transferred to data acquisition (DAQ) for storage, which could be extracted manually or remotely. The time series K-means clustering methodology [10] is adopted in processing the raw data by creating the secondary data points, also referred to as the Score Dataset. The Haar wavelet method [11], which is useful in filtering out noises such as invalid values and null values, is used in filtering and cleaning the mass-flowmeter raw data collected from the tugboat. This method is also known as part of data pre-processing in preparing data for analysis and serving as input for machine learning. The scoring system is proposed here to put parameters from different domains into the same domain and will be used to categorize the ship operational activities. The focus of this paper is on the unsupervised machine learning tool to achieve fuel efficiency. The Hidden Markov Model (HMM) methodology [12] is used in assistive decision making for the ship operational activities in deciding the ideal ship speed to achieve optimum fuel efficiency.},
author = {{Yung Tay}, Zhi and Hadi, Januwar and Konovessis, Dimitrios and {Jin Loh}, De and {Kong Hong}, David},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Tay et al. - 2021 - Efficient harbor craft monitoring system Time-series data analytics and machine learning tools to achieve fuel effic.pdf:pdf},
keywords = {Hidden Markov Model,K-mean clustering,activity labels,data analytics,fuel efficiency,machine learning},
title = {{EFFICIENT HARBOR CRAFT MONITORING SYSTEM: TIME-SERIES DATA ANALYTICS AND MACHINE LEARNING TOOLS TO ACHIEVE FUEL EFFICIENCY BY OPERATIONAL SCORING SYSTEM}},
url = {https://github.com/J-Hadi-SIT/efficientship}
}
