@article{Sivaram2016,
abstract = {The paper presents a preliminary study of low cost, off-grid, small prefabricated housing system, under mild climate conditions. The design procedure starts with assessment of the basic amenities and the energy required for an assumed initial layout, based on an existing housing system. The house is designed as self-reliant, off-grid system for regions with unreliable infrastructure and utilities. Simulations of passive performance are carried out to analyze the overall performance of the assumed layout. The results indicate a frequent overheating in the summer. Large diurnal room temperature fluctuations that exceed 10 {\textordmasculine}C are observed as well. Major building design parameters such as panel insulation, window area and outer surface solar absorbtance, are systematically modified until a satisfactory passive performance is obtained. Simulations of the revised design produce significantly improved results using the following combination of design parameters: 15% window area (0.57 RSI, and 0.53 SHGC) along the south-facing fa{\c{c}}ade, 5 RSI insulation and 0.4 solar absorbtance of the outer surface of the panels. The summer peak temperature is reduced by around 7 {\textordmasculine}C, compared to the base case, when this configuration is employed. An addition of thermal mass on the inside of the walls (such as gypsum board), leads to a further reduction of peak summer temperature of 8.5 {\textordmasculine}C, and major reduction of the diurnal room temperature fluctuations. However this configuration reduces winter temperature as well. An optimal design may be reached by increasing the south-facing window area of the last configuration to 22.5%. An increased window area increases the winter temperature without compromising summer performance.},
