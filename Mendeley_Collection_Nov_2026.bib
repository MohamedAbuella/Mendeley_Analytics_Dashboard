@article{Schmidt2015a,
abstract = {Clouds are the dominant source of variability in surface solar radiation and uncertainty in its prediction. However, the increasing share of solar energy in the world-wide electric power supply increases the need for accurate solar radiation forecasts. In this work, we present results of a shortest-term global horizontal irradiance (GHI) forecast experiment based on hemispheric sky images. A two month dataset with images from one sky imager and high resolutive GHI measurements from 99 pyranometers distributed over 10 km by 12 km is used for validation. We developed a multi-step model and processed GHI forecasts up to 25 min with an update interval of 15 s. A cloud type classification is used to separate the time series in different cloud scenarios. Overall, the sky imager based forecasts do not outperform the reference persistence forecasts. Nevertheless, we find that analysis and forecast performance depend strongly on the predominant cloud conditions. Especially convective type clouds lead to high temporal and spatial GHI variability. For cumulus cloud conditions, the analysis error is found to be lower than that introduced by a single pyranometer if it is used representatively for the whole area in distances from the camera larger than 1–2 km. Moreover, forecast skill is much higher for these conditions compared to overcast or clear sky situations causing low GHI variability which is easier to predict by persistence. In order to generalize the cloud-induced forecast error, we identify a variability threshold indicating conditions with positive forecast skill.},
author = {Schmidt, T. and Kalisch, J. and Lorenz, E. and Heinemann, D.},
doi = {10.5194/acpd-15-26997-2015},
file = {::},
issn = {1680-7375},
journal = {Atmospheric Chemistry and Physics Discussions},
keywords = {important doc},
mendeley-tags = {important doc},
number = {19},
pages = {26997--27039},
title = {{Evaluating the spatio-temporal performance of sky imager based solar irradiance analysis and forecasts}},
url = {http://www.atmos-chem-phys-discuss.net/15/26997/2015/},
volume = {15},
year = {2015}
}
@article{Pelland2013a,
abstract = {Hourly solar and photovoltaic (PV) forecasts for horizons between 0 and 48 hours ahead were developed using Environment Canada's Global Environmental Multiscale (GEM) model. The motivation for this research was to explore PV forecasting in Ontario, Canada where feed-in tariffs are driving rapid growth in installed PV capacity. The solar and PV forecasts were compared to irradiance data from 10 North American ground stations and to AC power data from 3 Canadian PV systems. A one year period was used to train the forecasts and the following year was used for testing. Two post-processing methods were applied to the solar forecasts: spatial averaging and bias removal using a Kalman filter. On average, these two methods lead to a 43% reduction in RMSE over a persistence forecast (skill score = 0.67) and to a 15% reduction in RMSE over the GEM forecasts without post-processing (skill score = 0.28). Bias removal was primarily useful when considering a « regional » forecast for the average irradiance of the 10 ground stations, since bias was a more significant fraction of RMSE in this case. PV forecast accuracy was influenced mainly by the underlying (horizontal) solar forecast accuracy, with RMSE ranging from 6.4 to 9.2% of rated power for the individual PV systems. About 76% of the PV forecast errors were within +-5% of the rated power for the individual systems, but the largest errors reached up to 44 to 57% of rated power.},
archivePrefix = {arXiv},
arxivId = {1303.4604},
author = {Pelland, Sophie and Galanis, George and Kallos, George},
doi = {10.1002/pip.1180},
eprint = {1303.4604},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Pelland, Galanis, Kallos - 2011 - Solar and photovoltaic forecasting through post-processing of the Global Environmental Multiscale nume.pdf:pdf},
isbn = {1062-7995},
issn = {10627995},
journal = {Progress in Photovoltaics: Research and Applications},
keywords = {Kalman filter,numerical weather prediction,photovoltaic forecasting,post-processing,solar forecasting,spatial averaging},
mendeley-tags = {post-processing},
number = {3},
pages = {284--296},
pmid = {22107872},
title = {{Solar and photovoltaic forecasting through post-processing of the Global Environmental Multiscale numerical weather prediction model}},
volume = {21},
year = {2011}
}
@article{Galke2017a,
abstract = {We assess the suitability of word embeddings for practical information retrieval scenarios. Thus, we assume that users issue ad-hoc short queries where we return the first twenty retrieved documents after applying a boolean matching operation between the query and the documents. We compare the performance of several techniques that leverage word embeddings in the retrieval models to compute the similarity between the query and the documents, namely word centroid similarity, paragraph vectors, Word Mover's distance, as well as our novel inverse document frequency (IDF) re-weighted word centroid similarity. We evaluate the performance using the ranking metrics mean average precision, mean reciprocal rank, and normalized discounted cumulative gain. Additionally, we inspect the retrieval models' sensitivity to document length by using either only the title or the full-text of the documents for the retrieval task. We conclude that word centroid similarity is the best competitor to state-of-the-art retrieval models. It can be further improved by re-weighting the word frequencies with IDF before aggregating the respective word vectors of the embedding. The proposed cosine similarity of IDF re-weighted word vectors is competitive to the TF-IDF baseline and even outperforms it in case of the news domain with a relative percentage of 15%.},
author = {Galke, Lukas and Saleh, Ahmed and Scherp, Ansgar},
doi = {10.18420/in2017_215},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Galke, Saleh, Scherp - 2017 - Evaluating the impact of word embeddings on similarity scoring in practical information retrieval(3).pdf:pdf},
isbn = {9783885796695},
issn = {16175468},
journal = {Lecture Notes in Informatics (LNI), Proceedings - Series of the Gesellschaft fur Informatik (GI)},
keywords = {Document representation,Information retrieval,Word embeddings},
pages = {2155--2167},
title = {{Evaluating the impact of word embeddings on similarity scoring in practical information retrieval}},
volume = {275},
year = {2017}
}
@article{Andrews,
abstract = {1 Mobile pelagic species habitat is structured around dynamic oceanographic and ecological 2 processes which operate and interact horizontally and vertically throughout the water column 3 and change over time. However, pelagic species movements and distributions are often 4 poorly understood. We use the Maxent species distribution model to assess how changes in 5 the relative importance of modelled oceanographic (e.g., temperature) and climatic variables 6 (e.g., the North Atlantic Oscillation) over 17-years affect the monthly average horizontal and 7 vertical distribution of a keystone pelagic forage species, Atlantic Canadian capelin (Mallotus 8 villosus). We show the range and distribution of capelin occurrence probabilities vary across 9 horizontal and vertical axes over time, with binary presence/absence predictions indicating 10 capelin occupy between 0.72% (April) and 3.45% (November) of the total modelled space. 11 Furthermore, our analysis reveals that the importance of modelled oceanographic variables, 12 such as temperature, varying between months (e.g. 44% permutation importance in August to 13 2% in May). By capturing the spatial dynamics of capelin over horizontal, vertical, and 14 temporal axes, our analysis builds on work that improves our understanding and predictive 15 modelling ability of pelagic species distributions under current and future conditions for pro-16 active ecosystem-based management.},
author = {Andrews, Samantha and Leroux, Shawn J and Fortin, Marie-Jos{\'{e}}e},
doi = {10.1101/2020.04.16.044156},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Kementerian Kesehatan Republik Indonesia - 2020 - Modelling the spatial-temporal distributions and associated determining factors of a k.pdf:pdf},
title = {{Title: Modelling the spatial-temporal distributions and associated determining factors of a keystone pelagic fish}},
url = {https://doi.org/10.1101/2020.04.16.044156}
}
