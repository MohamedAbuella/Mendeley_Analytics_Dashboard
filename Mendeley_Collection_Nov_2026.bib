issn = {17551315},
month = {feb},
number = {2},
publisher = {IOP Publishing Ltd},
title = {{Clustering of Marine Vessel Trajectory Data for Routes Planning through Water Areas with Heavy Traffic}},
volume = {988},
year = {2022}
}
