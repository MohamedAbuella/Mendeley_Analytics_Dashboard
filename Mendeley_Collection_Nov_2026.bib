publisher = {Hydrogen Energy Publications LLC},
title = {{Investigation on the decarbonization of shipping: An approach to hydrogen and ammonia}},
url = {https://doi.org/10.1016/j.ijhydene.2022.01.189},
volume = {47},
year = {2022}
}
