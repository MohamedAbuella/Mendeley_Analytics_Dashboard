file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Hampp, D{\"{u}}ren, Brown - 2023 - Import options for chemical energy carriers from renewable sources to Germany(2).pdf:pdf},
