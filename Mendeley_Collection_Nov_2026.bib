journal = {Applied Ocean Research},
keywords = {Added wave resistance,Engine load diagram,Minimum propulsion power,Propeller light running margin,Semi-empirical methods,important doc,read,shipping},
mendeley-tags = {important doc,read,shipping},
number = {June 2020},
pages = {102543},
publisher = {Elsevier Ltd},
title = {{Preliminary assessment of increased main engine load as a consequence of added wave resistance in the light of minimum propulsion power}},
url = {https://doi.org/10.1016/j.apor.2021.102543},
volume = {108},
year = {2021}
