keywords = {Ammonia,Case study,Decarbonization,Lifecycle CO2 emissions,Maritime transportation},
month = {may},
number = {41},
pages = {18148--18168},
publisher = {Elsevier Ltd},
title = {{Environmental and economic evaluation of ammonia as a fuel for short-sea shipping: A case study}},
volume = {47},
year = {2022}
