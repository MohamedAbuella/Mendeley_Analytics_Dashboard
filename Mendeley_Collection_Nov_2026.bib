@article{Demeester2016,
abstract = {Methods based on representation learning currently hold the state-of-the-art in many natural language processing and knowledge base inference tasks. Yet, a major challenge is how to efficiently incorporate commonsense knowledge into such models. A recent approach regularizes relation and entity representations by propositionalization of first-order logic rules. However, propositionalization does not scale beyond domains with only few entities and rules. In this paper we present a highly efficient method for incorporating implication rules into distributed representations for automated knowledge base construction. We map entity-tuple embeddings into an approximately Boolean space and encourage a partial ordering over relation embeddings based on implication rules mined from WordNet. Surprisingly, we find that the strong restriction of the entity-tuple embedding space does not hurt the expressiveness of the model and even acts as a regularizer that improves generalization. By incorporating few commonsense rules, we achieve an increase of 2 percentage points mean average precision over a matrix factorization baseline, while observing a negligible increase in runtime.},
archivePrefix = {arXiv},
arxivId = {1606.08359},
author = {Demeester, Thomas and Rockt{\"{a}}schel, Tim and Riedel, Sebastian},
doi = {10.18653/v1/d16-1146},
eprint = {1606.08359},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Mikolov et al. - 2013 - Distributed Representations of Words and Phrases and their Compositionality.pdf:pdf},
isbn = {9781945626258},
journal = {EMNLP 2016 - Conference on Empirical Methods in Natural Language Processing, Proceedings},
pages = {1389--1399},
title = {{Lifted rule injection for relation embeddings}},
year = {2016}
}
@article{Rashid2018a,
abstract = {Recurrent Neural Networks (RNNs) are possibly the most prevailing and advantageous type of neural network. On the other hand, these networks still have some weaknesses in terms of learning speed, error convergence, and accuracy due to long-term dependencies, which need to be solved. Long-term dependencies are mainly exploding and vanishing gradients through Back Propagation Learning Algorithm. In this paper, Long Short Term Memory or LSTM is used and well structured for resolving the above concerns. Four different optimizers based on Metaheuristic Algorithms are chosen to train LSTM (these are; Harmony Search (HS), Gray Wolf Optimizer (GWO), Sine Cosine (SCA), and Ant Lion Optimization algorithms (ALOA). The suggested representations are used for classification and analysis of real and medical time series data sets (Breast Cancer Wisconsin Data Set and Epileptic Seizure Recognition Data Set). Classification accuracy measure has been used instead of error rate and mean square error methods to train LSTM with above optimizing algorithms. The experimental results are verified using the 5-fold cross validation. Details of simulations and coding in R programing language can be obtained in the following link “https://github.com/pollaeng/rnn”.},
author = {Rashid, Tarik A. and Fattah, Polla and Awla, Delan K.},
doi = {10.1016/j.procs.2018.10.307},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Rashid, Fattah, Awla - 2018 - Using accuracy measure for improving the training of LSTM with metaheuristic algorithms(3).pdf:pdf},
issn = {18770509},
journal = {Procedia Computer Science},
keywords = {Deep learning,LSTM,Machine learning,Medical time series,Metaheuristics,Nature inspired algorithms,Optimization,shipping},
mendeley-tags = {LSTM,shipping},
pages = {324--333},
publisher = {Elsevier B.V.},
title = {{Using accuracy measure for improving the training of LSTM with metaheuristic algorithms}},
url = {https://doi.org/10.1016/j.procs.2018.10.307},
volume = {140},
year = {2018}
}
