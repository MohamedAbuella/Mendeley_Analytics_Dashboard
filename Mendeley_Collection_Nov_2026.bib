isbn = {7845005002},
journal = {arXiv preprint arXiv:1408.3264},
keywords = {Platform,Survey,artificial neural,classification,deep belief network,feature extraction,matlab toolbox,network,restricted boltzmann machine},
number = {September},
pages = {0--25},
title = {{A brief survey on deep belief networks and introducing a new object oriented MATLAB toolbox (DeeBNet V2.2)}},
url = {http://arxiv.org/abs/1408.3264},
