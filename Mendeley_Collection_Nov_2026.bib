journal = {Ocean Dynamics},
keywords = {Air-sea interaction,High cited doc,NORA10,Nordic Seas,North Atlantic Oscillation,SSS,Swell,Theoretical Background,Wave age,Wave climate,Wind sea,important doc,shipping},
mendeley-tags = {High cited doc,SSS,Theoretical Background,important doc,shipping},
number = {2},
pages = {223--240},
title = {{The wind sea and swell waves climate in the Nordic seas}},
volume = {65},
