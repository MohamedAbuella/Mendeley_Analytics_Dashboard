issn = {19961073},
journal = {Energies},
keywords = {ANFIS,Artificial neural networks (ANN),Big data,Blockchain,Decision tree (DT),Deep learning,Energy demand,Energy informatics,Energy systems,Ensemble,Forecasting,Hybrid models,Internet of things (IoT),Machine learning,Neuro-fuzzy,OR,Prediction,Remote sensing,Renewable energy systems,Smart sensors,Support vector machines (SVM),Wavelet neural network (WNN),review},
mendeley-tags = {OR,review},
number = {7},
