file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Aguzzi et al. - 2022 - Developing technological synergies between deep-sea and space research(2).pdf:pdf},
issn = {23251026},
journal = {Elementa},
keywords = {Artificial intelligence,Biomimicking,Deep-sea robotics,Exo-oceans,Marine observatory networks,Miniaturized life-tracing sensors,PhyML,review,shipping},
mendeley-tags = {PhyML,review,shipping},
