pages = {45},
title = {{Reliability Guideline: Distributed Energy Resource Modeling}},
url = {https://www.nerc.com/comm/PC_Reliability_Guidelines_DL/Reliability_Guideline_-_DER_Modeling_Parameters_-_2017-08-18_-_FINAL.pdf},
year = {2017}
