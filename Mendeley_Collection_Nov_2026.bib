journal = {Applied Energy},
keywords = {Libya,Macro-energy systems,Multi-Vector Energy System,OR,OSeMOSYS,OpenStreetMap,Optimization,PyPSA meets Earth,PyPSA-Africa,PyPSA-Earth,RE Teaching,Theoretical Background},
mendeley-tags = {Libya,Multi-Vector Energy System,OR,OSeMOSYS,RE Teaching,Theoretical Background},
number = {March},
pages = {121096},
publisher = {Elsevier Ltd},
title = {{PyPSA-Earth. A new global open energy system optimization model demonstrated in Africa}},
url = {https://doi.org/10.1016/j.apenergy.2023.121096},
volume = {341},
year = {2023}
