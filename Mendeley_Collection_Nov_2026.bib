keywords = {RUL,artificial intelligence,deep leaning,gnn,industry 4.0,machine learning,predictive maintenance,prognostic and health management,shipping},
mendeley-tags = {RUL,gnn,shipping},
number = {November},
pages = {1--24},
title = {{Prognostics and Health Management of Industrial Assets: Current Progress and Road Ahead}},
volume = {3},
year = {2020}
