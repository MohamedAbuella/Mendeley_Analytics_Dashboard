issn = {20711050},
journal = {Sustainability (Switzerland)},
keywords = {AIrev,VOSviewer,alternative marine fuel,bibliometric analysis,biblioshiny,climate,decarbonization,important doc,maritime shipping,review,shipping},
mendeley-tags = {AIrev,climate,important doc,review,shipping},
number = {9},
title = {{Alternative Marine Fuel Research Advances and Future Trends: A Bibliometric Knowledge Mapping Approach}},
volume = {14},
