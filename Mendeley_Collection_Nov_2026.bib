journal = {Journal of Ocean Engineering and Science},
keywords = {Decision-making,Fuel consumption,Hull and propeller roughness,PhyML,Service performance,Ship's noon report,Theoretical Background,Very High cited doc,Weather,read,shipping},
mendeley-tags = {PhyML,Theoretical Background,Very High cited doc,read,shipping},
number = {2},
pages = {157--166},
publisher = {Elsevier B.V.},
title = {{On the estimation of ship's fuel consumption and speed curve: A statistical approach}},
