keywords = {GNN,Path,Tra_GMM_DMP_Spline,shipping},
mendeley-tags = {GNN,Path,Tra_GMM_DMP_Spline,shipping},
title = {{Adaptive Sparsified Graph Learning Framework for Vessel Behavior Anomalies}},
