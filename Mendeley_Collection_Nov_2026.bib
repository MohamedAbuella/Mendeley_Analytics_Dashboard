issn = {03014215},
journal = {Energy Policy},
keywords = {Climate change,Decarbonization,EnergPolicy,Energy storage,OR,OSeMOSYS,Renewable energy economics,Theoretical Background},
mendeley-tags = {EnergPolicy,OR,OSeMOSYS,Theoretical Background},
number = {March},
title = {{Cost minimization for fully renewable electricity systems: A Mauritius case study}},
