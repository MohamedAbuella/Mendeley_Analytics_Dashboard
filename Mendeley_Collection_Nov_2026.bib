journal = {Energies},
keywords = {FMEA,Maritime autonomous surface ship,Operational modes,PhyML,Risk assessment,shipping},
mendeley-tags = {PhyML,shipping},
number = {13},
pages = {1--12},
title = {{Towards a framework of operational-risk assessment for a maritime autonomous surface ship}},
volume = {14},
year = {2021}
}
