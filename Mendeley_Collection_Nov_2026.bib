@article{,
abstract = {This introductory chapter provides an overview of the content presented in other chapters of the book. Chapter 2 discusses the simplest estimation procedure— that is, least squares. It explains the properties of the estimator both with and without the assumption of Gaussian modeling errors. Chapter 3 introduces the important maximum likelihood approach to estimation. Properties of the estimator are investigated for nondynamic models. Chapter 4 is concerned with the development of mathematical models for dynamic systems. It also discusses various canonical forms and their relevance to the estimation of parameters in linear dynamic systems. Chapter 5 discusses the least squares, maximum likelihood, instrumental variables, and generalized least squares. It gives details of multiple-input, multiple-output systems, and optimization algorithms. In Chapter 6, the problem of accuracy of estimation is considered. It is shown that the choice of experimental conditions has a significant effect upon the achievable accuracy. Chapter 7 describes recursive estimation and experiment design techniques. These are shown to be particularly relevant in situations where the dynamics may be time varying. {\textcopyright} 1977, Academic Press, Inc.},
