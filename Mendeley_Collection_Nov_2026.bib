title = {{Global Horizontal Irradiance Clear Sky Models: Implementation and Analysis}},
year = {2012}
}
@inproceedings{Das2021a,
abstract = {Rapid variations in weather condition or load profile, leads to high power ramp rate in a renewable energy sources (RESs) powered grid interactive microgrid. Such variations, often termed as the microgrid power ramp events (MPREs), burden the utility grid voltage and frequency regulations, and can even threaten the overall system stability. This paper presents the development of an active power management (APM) scheme, to limit the net output power ramp rate arising due to MPREs, using a battery energy storage (BES) in the wind-solar AC microgrid. The microgrid APM is carried out using a computationally efficient variable kernel width maximum correntropy criterion (VKW-MCC) adaptive filtering methodology. The charging/discharging of the BES during MPREs, is indirectly controlled through the grid side converter, based on a pre-determined positive and negative ramp rate limit (RRL). The feasibility and effectiveness of the APM scheme is verified through simulations in MATLAB platform.},
author = {Das, Souvik and Singh, Bhim},
booktitle = {2021 International Conference on Sustainable Energy and Future Electric Transportation, SeFet 2021},
doi = {10.1109/SeFet48154.2021.9375684},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Gdv et al. - Unknown - Active Power Management Scheme Based on Ramp Rate Limit Control in a Wind-Solar AC Microgrid.pdf:pdf},
isbn = {9781728156811},
keywords = {Active Power Management,Doubly FedInduction Generator.,Microgrid,Ramp Rate Limit,Solar Photovoltaic},
month = {jan},
