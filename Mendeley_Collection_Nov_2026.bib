keywords = {Clustering,Data preprocessing,Forecasting,Scholar_abs_solar_post,Solar radiation,post-processing},
mendeley-tags = {Scholar_abs_solar_post,post-processing},
number = {April 2016},
pages = {1371--1383},
title = {{A novel clustering approach for short-term solar radiation forecasting}},
volume = {122},
year = {2015}
}
