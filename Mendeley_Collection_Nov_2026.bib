@article{Liu2015f,
abstract = {Abstract Ship manoeuvrability plays a major role in navigation safety. In order to achieve certain manoeuvring requirements, ship configurations need to be specifically considered, which in turn influence the economic performance of shipping. Compared with seagoing ships, inland vessels sail in a more complex navigation environment. At the same time, inland vessels have to operate independently without additional assistance like tugs. This paper presents a review of the state-of-the-art of evaluation and prediction methods for inland vessel manoeuvrability. First of all, different aspects that influence manoeuvrability and the methods assessed for inland vessels and seagoing ships are compared. Accordingly, additional knowledge is required regarding the modelling methods and evaluation criteria of inland vessel manoeuvrability. Furthermore, a step-by-step review on manoeuvrability research relates various impact factors to manoeuvring performance. Finally, the gaps in knowledge of evaluation and prediction methods for inland vessel manoeuvrability in shallow/restricted waterways are described.},
author = {Liu, Jialun and Hekkenberg, Robert and Rotteveel, Erik and Hopman, Hans},
doi = {10.1016/j.oceaneng.2015.07.021},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Liu et al. - 2015 - Literature review on evaluation and prediction methods of inland vessel manoeuvrability(2).pdf:pdf},
issn = {00298018},
journal = {Ocean Engineering},
keywords = {Inland vessel manoeuvrability,Manoeuvrability criteria,Manoeuvrability test manoeuvres,Numerical simulations,Path,SSS,important doc,review,shipping},
mendeley-tags = {Path,SSS,important doc,review,shipping},
pages = {458--471},
publisher = {Elsevier},
title = {{Literature review on evaluation and prediction methods of inland vessel manoeuvrability}},
