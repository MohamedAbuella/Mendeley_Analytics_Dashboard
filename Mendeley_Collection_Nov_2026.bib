issn = {1553877X},
journal = {IEEE Communications Surveys and Tutorials},
keywords = {Electric demand forecasting,microgrid,short-term load forecasting,smart building,smart grid},
number = {3},
pages = {1460--1495},
title = {{A survey on electric power demand forecasting: Future trends in smart grids, microgrids and smart buildings}},
volume = {16},
year = {2014}
}
