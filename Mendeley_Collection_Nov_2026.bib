issn = {03050548},
journal = {Computers and Operations Research},
keywords = {Artificial neural networks,Decision support system,Operational measures,Ship energy efficiency,Very High cited doc,important doc,shipping},
mendeley-tags = {Very High cited doc,important doc,shipping},
number = {January 2013},
pages = {393--401},
title = {{An artificial neural network based decision support system for energy efficient ship operations}},
volume = {66},
