mendeley-tags = {EnergPolicy,GASnets,Multi-Vector Energy System,OR,Very High cited doc,important doc},
pages = {473--483},
publisher = {Elsevier},
title = {{A sequential Monte Carlo model of the combined GB gas and electricity network}},
url = {http://dx.doi.org/10.1016/j.enpol.2013.08.011},
volume = {62},
