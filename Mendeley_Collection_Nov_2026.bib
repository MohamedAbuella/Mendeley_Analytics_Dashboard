issn = {08858993},
journal = {IEEE Transactions on Power Electronics},
keywords = {Battery degradation,Charging infrastructure,Distribution system,Grid operator,Grid-to-vehicle (G2V),Hydrogen,Plug-in electric vehicles (PEVs),RE Teaching,Regulation,Smart charging,Theoretical Background,Unidirectional/bidirectional power flow,Utility interface,Vehicleto-grid (V2G),Very High cited doc,review,shipping},
mendeley-tags = {Hydrogen,RE Teaching,Theoretical Background,Very High cited doc,review,shipping},
