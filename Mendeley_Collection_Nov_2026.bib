@article{Khaligh2022,
abstract = {This paper proposes a cooperative energy management model of a microgrid with bidirectional electricity-hydrogen energy conversion. Electrolysis as power to hydrogen (P2H) and fuel cells as hydrogen to power (H2P) units are the energy coupling links among electricity and hydrogen subsystems. Hydrogen subsystem is equipped with hydrogen storage systems (HSS) hydrogen vehicles (HV) as demand. Alternating direction method of multipliers (ADMM) is used to provide a cooperative coordination among energy subsystems and handle energy links. Uncertainty associated with HVs as well as other uncertainties including wind power output, PV output, demand, and price uncertainty are considered. A set of case studies are examined on a test system to evaluate the proposed method.},
