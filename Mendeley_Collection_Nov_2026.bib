journal = {Renewable and Sustainable Energy Reviews},
keywords = {GASnets,Hydrogen,Hydrogen energy,Integrated electricity-gas-hydrogen systems,Investment equilibrium,Multi-Vector Energy System,OR,Renewable energy,Theoretical Background,important doc},
mendeley-tags = {GASnets,Hydrogen,Multi-Vector Energy System,OR,Theoretical Background,important doc},
