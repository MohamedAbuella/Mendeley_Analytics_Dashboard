journal = {ICASSP, IEEE International Conference on Acoustics, Speech and Signal Processing - Proceedings},
keywords = {LLM,Theoretical Background,Very High cited doc,important doc},
mendeley-tags = {LLM,Theoretical Background,Very High cited doc,important doc},
pages = {8595--8598},
title = {{Building high-level features using large scale unsupervised learning}},
year = {2013}
}
@article{Amidi2018,
abstract = {Metrics Given a set of data points {x (1) , ..., x (m) }, where each x (i) has n features, associated to a set of outcomes {y (1) , ..., y (m) }, we want to assess a given classifier that learns how to predict y from x. Classification In a context of a binary classification, here are the main metrics that are important to track to assess the performance of the model. {\`{I}} Confusion matrix-The confusion matrix is used to have a more complete picture when assessing the performance of a model. It is defined as follows: Predicted class +-Actual class TP FN + False Negatives True Positives Type II error FP TN-False Positives True Negatives Type I error {\`{I}} Main metrics-The following metrics are commonly used to assess the performance of classification models: Metric Formula Interpretation Accuracy TP + TN TP + TN + FP + FN Overall performance of model Precision TP TP + FP How accurate the positive predictions are Recall TP TP + FN Coverage of actual positive sample Sensitivity Specificity TN TN + FP Coverage of actual negative sample F1 score 2TP 2TP + FP + FN Hybrid metric useful for unbalanced classes {\`{I}} ROC-The receiver operating curve, also noted ROC, is the plot of TPR versus FPR by varying the threshold. These metrics are are summed up in the table below: Metric Formula Equivalent True Positive Rate TP TP + FN Recall, sensitivity TPR False Positive Rate FP TN + FP 1-specificity FPR {\`{I}} AUC-The area under the receiving operating curve, also noted AUC or AUROC, is the area below the ROC as shown in the following figure: Regression {\`{I}} Basic metrics-Given a regression model f , the following metrics are commonly used to assess the performance of the model: Total sum of squares Explained sum of squares Residual sum of squares SStot = m i=1 (y i − y) 2 SSreg = m i=1 (f (x i) − y) 2 SSres = m i=1 (y i − f (x i)) 2 {\`{I}} Coefficient of determination-The coefficient of determination, often noted R 2 or r 2 , provides a measure of how well the observed outcomes are replicated by the model and is defined as follows: R 2 = 1 − SSres SStot {\`{I}} Main metrics-The following metrics are commonly used to assess the performance of regression models, by taking into account the number of variables n that they take into consideration: Mallow's Cp AIC BIC Adjusted R 2 SSres + 2(n + 1) $\sigma$ 2 m 2 (n + 2) − log(L) log(m)(n + 2) − 2 log(L) 1 − (1 − R 2)(m − 1) m − n − 1 Stanford University 1 Fall 2018},
author = {Amidi, Afshine and Amidi, Shervine},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Amidi, Amidi - 2018 - CS229 ML Stanford Cheatsheet on Machine Learning.pdf:pdf},
journal = {Stanford University},
keywords = {Theoretical Background,important doc},
