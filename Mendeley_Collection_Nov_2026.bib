journal = {Building and Environment},
keywords = {Building and urban energy demand,Data-driven models,Machine learning,Open data,Pre-processing,Time-series models},
month = {jul},
publisher = {Elsevier Ltd},
title = {{Ten questions concerning data-driven modelling and forecasting of operational energy demand at building and urban scale}},
volume = {239},
year = {2023}
}
