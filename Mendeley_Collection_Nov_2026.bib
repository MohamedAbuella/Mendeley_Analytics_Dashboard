journal = {2022 International Conference on Information Technology Systems and Innovation, ICITSI 2022 - Proceedings},
keywords = {AIS,CRISP-DM,DBSCAN,LSTM,Machine Learning,Semantic,Theoretical Background,important doc,shipping},
