keywords = {Bibliometrics,Decision Support System (DSS),Maritime Transportation System (MTS),Maritime risk and safety,Systematic literature review},
number = {March},
pages = {104717},
publisher = {Elsevier},
title = {{A bibliometric analysis and systematic review of shipboard Decision Support Systems for accident prevention}},
