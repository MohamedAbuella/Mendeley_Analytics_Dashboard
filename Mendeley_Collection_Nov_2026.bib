@phdthesis{Sørensen2021,
abstract = {In this work, we firstly implement an unsupervised VAE with BLSTM and Multi-Headed Self-Attention mechanisms to find contextual information in Gatehouse Maritime AIS data. No labelled Gatehouse Maritime AIS anomalies exists, and the model is consequently evaluated qualitatively on few examples, leading to the detection of contextual information corresponding to well defined trajectory patterns in addition to the detection of what is presumed to be anomalies. This demonstrates the method's prospect of automatically findingcomplex anomalies in AIS data. Moreover, an AIS dark ships detection framework is implemented, finding in one scenario 15, 002 dark ships from 9 months of AIS data from a specific geographical region. Additionally, three types of deep learning architectures are implemented to forecast AIS trajectories, all using Bidirectional Long Short Term Memory networks and Attention mechanisms; The regression model learns the historical behaviour of cargo ships, and predictstrajectories 5 minutes into the future with a RMSE of 0.2, and a median error of ≈ 68km 100 minutes into the future. Thereafter, we implement an adaptive and a global classification forecast model. The global classification forecast model was not fully trained and has a categorical accuracy of 17.5%. The adaptive classification forecast model has an accuracy of ≈ 95% for predictions 5 and 25 minutes into the future with stationary ships, and an accuracy of 87% and 91% respectively by excluding stationary ships. We subsequently propose a method to fuse the cooperative AIS data with the non-cooperative SAR data, culminating in a dark ship detection case study.},
author = {S{\o}rensen, Kristian Aalling},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/S{\o}rensen - 2021 - Automatic Identification System tracking of ships using Neural Networks and correlation with satellite images.pdf:pdf},
keywords = {AIS data,Automatic Identification System,Bidirectional Long short term memory networks,Deep Learning,Long short term memory (LSTM),Self-Attention Mechanism,Ship detection,Ship trajectory prediction,Synthetic aperture radar (SAR),Thesis,Trajectory Prediction,Variational Autoencoders,maritime traffic,shipping,trajectory anomalies},
mendeley-tags = {Thesis,shipping},
number = {February},
