journal = {IEEE Transactions on Cybernetics},
keywords = {Bayesian inference,Dirichlet process mixture model (DPMM),Gibbs sampling,Path,incremental trajectory clustering,intelligent transportation system,nonparametric model,shipping,unsupervised learning},
mendeley-tags = {Path,shipping},
