keywords = {Risk assessment,Scenario Analysis,Human factors,Au,autonomous,human factors,mass,risk assessment,scenario analysis,shipping,ships,shore control centre,shore control centre operator},
mendeley-tags = {shipping},
pages = {179--211},
publisher = {Springer Berlin Heidelberg},
title = {{Human-centred risk assessment for a land-based control interface for an autonomous vessel}},
