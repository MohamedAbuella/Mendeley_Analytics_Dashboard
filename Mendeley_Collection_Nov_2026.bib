issn = {09574174},
journal = {Expert Systems with Applications},
keywords = {Features extraction,Image classification,Linear Discriminant Analysis (LDA),Principal Component Analysis (PCA),Ripeness,Support Vector Machines (SVMs)},
number = {4},
pages = {1892--1905},
publisher = {Elsevier Ltd},
title = {{Using machine learning techniques for evaluating tomato ripeness}},
url = {http://dx.doi.org/10.1016/j.eswa.2014.09.057},
