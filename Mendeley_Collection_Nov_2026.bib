@article{Lorenz2012a,
abstract = {With the constantly increasing contribution of PV to the electricity mix, reliable predictions of the expected PV power production are getting more and more important as a basis for management and operation strategies. Here, we present a new approach for irradiance forecasting to improve the operational PV power prediction system of University of Oldenburg and Meteocontrol GmbH by integrating additional data sources, including satellite images and different numerical weather prediction systems. For short term forecast horizons up to four hours ahead, irradiance forecasts based on cloud motion vector fields from satellite images perform significantly better than forecasts of numerical weather prediction systems, demonstrated in an evaluation with 290 measurement stations in Germany. The investigation of an optimized combination of the different data sources in dependence on the forecast horizon is a second focus of the paper and the benefit of this approach is shown.},
