keywords = {Discrete choice models,Mediterranean area,Ro-ro and container services,Short sea shipping},
month = {jun},
pages = {27--33},
publisher = {Elsevier Ltd},
title = {{Competition between ro-ro and lo-lo services in short sea shipping market: The case of Mediterranean countries}},
volume = {19},
