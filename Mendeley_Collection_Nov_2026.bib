keywords = {Decarbonization,Energy saving devices,Maritime transport,Ro-Pax shipping,SSS,Short sea shipping,shipping},
mendeley-tags = {SSS,shipping},
number = {March},
title = {{Decarbonizing maritime transport: A Ro-Pax case study}},
volume = {37},
year = {2020}
