isbn = {9781538653791},
keywords = {Gaussian process regression (GPR),Light emitting diode (LED),Missing data,Multi-task Gaussian process (MTGP),Prognostics and health management (PHM)},
month = {jan},
pages = {1182--1187},
publisher = {Institute of Electrical and Electronics Engineers Inc.},
title = {{Prognostic Health Management for LED with Missing Data: Multi-task Gaussian Process Regression Approach}},
year = {2019}
}
