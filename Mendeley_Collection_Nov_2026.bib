doi = {10.1016/j.clscn.2021.100003},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Schinas, Bergmann - 2021 - Cleaner Logistics and Supply Chain Emissions trading in the aviation and maritime sector Findings from a rev.pdf:pdf},
issn = {27723909},
journal = {Cleaner Logistics and Supply Chain},
keywords = {Aviation,CORSIA,ETS design,EU ETS,Emissions trading,Environmental economics,Shipping},
month = {oct},
publisher = {Elsevier Ltd},
title = {{Emissions trading in the aviation and maritime sector: Findings from a revised taxonomy}},
volume = {1},
year = {2021}
}
