file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Karagiannidis, Themelis - 2021 - Data-driven modelling of ship propulsion and the effect of data pre-processing on the prediction of (4).pdf:pdf},
