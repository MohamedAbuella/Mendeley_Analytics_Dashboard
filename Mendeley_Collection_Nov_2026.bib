file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Gupta et al. - 2016 - Optimizing front metallization patterns Efficiency with aesthetics in free-form solar cells.pdf:pdf},
issn = {18790682},
journal = {Renewable Energy},
keywords = {Free-form,Front metallization,Optimal design,Solar cells,Topology optimization},
pages = {1332--1339},
publisher = {Elsevier Ltd},
title = {{Optimizing front metallization patterns: Efficiency with aesthetics in free-form solar cells}},
url = {http://dx.doi.org/10.1016/j.renene.2015.09.071},
volume = {86},
year = {2016}
