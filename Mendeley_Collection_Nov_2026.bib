isbn = {VO -},
journal = {2016 IEEE International Conference on Systems, Man, and Cybernetics (SMC)},
keywords = {AutoEncoder,Forecasting,LSTM neural networks,Machine learning,Multi-layer neural network,Neural networks,Neurons,Power generation,Power system analysis computing,Predictive models,Recurrent neural networks,Solar Energy,Weather forecasting,artificial neural network,belief networks,deep belief networks,deep learning,electric power generation,learning (artificial intelligence),load forecasting,neural nets,power engineering computing,power generation,power grid,power grids,renewable energy power forecasting,renewable energy power plants,solar power forecasting,solar power stations},
pages = {2858--2865},
title = {{Deep Learning for solar power forecasting; An approach using AutoEncoder and LSTM Neural Networks}},
year = {2016}
}
@article{Slingo2011,
abstract = {Following Lorenz's seminal work on chaos theory in the 1960s, probabilistic approaches to prediction have come to dominate the science of weather and climate forecasting. This paper gives a perspective on Lorenz's work and how it has influenced the ways in which we seek to represent uncertainty in forecasts on all lead times from hours to decades. It looks at how model uncertainty has been represented in probabilistic prediction systems and considers the challenges posed by a changing climate. Finally, the paper considers how the uncertainty in projections of climate change can be addressed to deliver more reliable and confident assessments that support decision-making on adaptation and mitigation.},
