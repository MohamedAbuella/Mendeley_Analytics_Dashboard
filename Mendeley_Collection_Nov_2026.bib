number = {June},
pages = {27--41},
publisher = {Elsevier},
title = {{Estimating ramping requirements with solar-friendly flexible ramping product in multi-timescale power system operations}},
url = {https://doi.org/10.1016/j.apenergy.2018.05.031},
volume = {225},
