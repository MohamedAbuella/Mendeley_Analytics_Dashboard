keywords = {AIrev,Latent Dirichlet allocation,Software engineering,Topic modeling,Tutorial,Very High cited doc,important doc},
mendeley-tags = {AIrev,Very High cited doc,important doc},
pages = {139--159},
title = {{Latent Dirichlet Allocation: Extracting Topics from Software Engineering Data}},
volume = {3},
year = {2015}
}
