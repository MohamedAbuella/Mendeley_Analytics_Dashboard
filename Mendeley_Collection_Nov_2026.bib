journal = {International Journal of Forecasting},
keywords = {Artificial neural networks,Computational intelligence,Empirical evaluation,NN3 competition,Time series forecasting},
month = {jul},
number = {3},
pages = {635--660},
title = {{Advances in forecasting with neural networks? Empirical evidence from the NN3 competition on time series prediction}},
url = {http://linkinghub.elsevier.com/retrieve/pii/S0169207011000616},
volume = {27},
year = {2011}
