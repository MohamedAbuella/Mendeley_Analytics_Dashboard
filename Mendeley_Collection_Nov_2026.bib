@article{Qiu2017,
abstract = {Load demand forecasting is a critical process in the planning of electric utilities. An ensemble method composed of Empirical Mode Decomposition (EMD) algorithm and deep learning approach is presented in this work. For this purpose, the load demand series were first decomposed into several intrinsic mode functions (IMFs). Then a Deep Belief Network (DBN) including two restricted Boltzmann machines (RBMs) was used to model each of the extracted IMFs, so that the tendencies of these IMFs can be accurately predicted. Finally, the prediction results of all IMFs can be combined by either unbiased or weighted summation to obtain an aggregated output for load demand. The electricity load demand data sets from Australian Energy Market Operator (AEMO) are used to test the effectiveness of the proposed EMD-based DBN approach. Simulation results demonstrated attractiveness of the proposed method compared with nine forecasting methods.},
author = {Qiu, Xueheng and Ren, Ye and Suganthan, Ponnuthurai Nagaratnam and Amaratunga, Gehan A.J.},
doi = {10.1016/j.asoc.2017.01.015},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Qiu et al. - 2017 - Empirical Mode Decomposition based ensemble deep learning for load demand time series forecasting.pdf:pdf},
isbn = {1568-4946},
issn = {15684946},
journal = {Applied Soft Computing Journal},
keywords = {Deep learning,Empirical Mode Decomposition,Ensemble method,Load demand forecasting,Neural networks,Random forests,Support vector regression,Time series forecasting,post-processing},
mendeley-tags = {post-processing},
pages = {246--255},
publisher = {Elsevier B.V.},
title = {{Empirical Mode Decomposition based ensemble deep learning for load demand time series forecasting}},
