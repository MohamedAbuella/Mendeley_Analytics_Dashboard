journal = {International journal of energy research},
keywords = {adsorption,thermal storage,zeolite-water},
number = {August 2007},
pages = {135--147},
pmid = {19566191},
title = {{Experimental investigation of an adsorptive thermal energy storage}},
volume = {31},
year = {2007}
