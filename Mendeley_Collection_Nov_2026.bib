file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Makridakis, Spiliotis, Assimakopoulos - 2020 - The M4 Competition 100 , 000 time series and 61 forecasting methods.pdf:pdf},
