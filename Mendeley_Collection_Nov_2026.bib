issn = {17545706},
journal = {Energy and Environmental Science},
number = {3},
pages = {830--839},
publisher = {Royal Society of Chemistry},
title = {{Ultrahigh-efficiency desalination: Via a thermally-localized multistage solar still}},
volume = {13},
year = {2020}
}
