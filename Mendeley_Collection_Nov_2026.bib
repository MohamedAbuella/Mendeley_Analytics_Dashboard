@article{Santos2017,
abstract = {A novel methodology is developed for determining the characteristics of a cargo roll-on/roll-off (ro-ro) ship and the fleet size required for a given short sea shipping route. The ship and required fleet size to satisfy the transportation demand (for each pair of speed and freight rate) are determined using a database of existing cargo ro-ro ships to obtain the main technical characteristics of the most suitable ship. The time charter, voyage costs and revenue are then calculated considering the technical characteristics of each ship. Fuel costs are corrected for the actual ship speed and loading condition. A number of restrictions in the transportation problem are considered leading to the exclusion of unfeasible solutions. The maximum profit over the period of a year is identified among the feasible pairs of speed and freight rate. This general methodology is applied in a case study that considers the route between Leix{\~{o}}es (Portugal) and Rotterdam (Netherlands). The study allows the identification of the most suitable ship and fleet sizes for different market penetration levels and quantifies the impact on shipping company profit of changes in parameters such as fuel costs, time charter costs, emission control area, installed propulsion power and stacking factor.},
author = {Santos, Tiago A. and {Guedes Soares}, C.},
doi = {10.1080/03088839.2017.1349349},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Santos, Guedes Soares - 2017 - Methodology for ro-ro ship and fleet sizing with application to short sea shipping.pdf:pdf},
issn = {14645254},
journal = {Maritime Policy and Management},
keywords = {SSS,Short sea shipping,Theoretical Background,fleet sizing,liner shipping,logistics,ro-ro shipping,shipping},
mendeley-tags = {SSS,Theoretical Background,shipping},
number = {7},
pages = {859--881},
publisher = {Routledge},
title = {{Methodology for ro-ro ship and fleet sizing with application to short sea shipping}},
url = {https://doi.org/10.1080/03088839.2017.1349349},
volume = {44},
year = {2017}
}
@article{Nepogodiev2021b,
abstract = {Background: Preoperative SARS-CoV-2 vaccination could support safer elective surgery. Vaccine numbers are limited so this study aimed to inform their prioritization by modelling. Methods: The primary outcome was the number needed to vaccinate (NNV) to prevent one COVID-19-related death in 1 year. NNVs were based on postoperative SARS-CoV-2 rates and mortality in an international cohort study (surgical patients), and community SARS-CoV-2 incidence and case fatality data (general population). NNV estimates were stratified by age (18–49, 50–69, 70 or more years) and type of surgery. Best- and worst-case scenarios were used to describe uncertainty. Results: NNVs were more favourable in surgical patients than the general population. The most favourable NNVs were in patients aged 70 years or more needing cancer surgery (351; best case 196, worst case 816) or non-cancer surgery (733; best case 407, worst case 1664). Both exceeded the NNV in the general population (1840; best case 1196, worst case 3066). NNVs for surgical patients remained favourable at a range of SARS-CoV-2 incidence rates in sensitivity analysis modelling. Globally, prioritizing preoperative vaccination of patients needing elective surgery ahead of the general population could prevent an additional 58 687 (best case 115 007, worst case 20 177) COVID-19-related deaths in 1 year. Conclusion: As global roll out of SARS-CoV-2 vaccination proceeds, patients needing elective surgery should be prioritized ahead of the general population.},
author = {Nepogodiev, Dmitri and Simoes, Joana F.F. and Li, Elizabeth and Glasbey, James and Picciochi, Maria and Kamarajah, Sivesh K. and Gujjuri, Rohan and Bhangu, Aneel and Maryam, A. and Azab, Mohammed A. and Zahran, Mohammed A. and Abdelaziz, Areej A. and Aamir, Junaid and Rahman, Norhafiza Ab and Zaid, Muna Aba and Abaalkhail, Muath and Ababneh, Adnan and Ababneh, Hazim and Ababneh, Laila and Ababneh, Roba and Alonso, Rafael Abad and Gurumeta, Alfredo Abad and Abad-Motos, Ane and Abaker, Mussab and Abary, Ryan Rainiel and Abass, Adam and Abate, Emmanuele and Ahmed, Sheraz Abayazeed and Abayomi, Olukayode and Abazeed, Alaa and Abbad, Bader and Abbadessa, Francesco and Abbadi, Osaid and Abbakar, Malaz and Abbas, Ahmed M. and Abbas, Alzhraa Salah and Abbas, Asad and Abbas, Aya M. and Abbas, Jihad and Abbas, Manzar and Abbas, Mohammad Monir and Abbas, Omer and Abbasov, Aykhan and Abbo, Olivier and Abbott, Daniel and Abbott, Tom and Abboud, Omar Sudig and Abd, Waleed and Alghafour, Tayma Abd and El-Ghani, Wael Abd and Elsayed, Mustafa Abd and Elwahab, Ahmed Abd and Elwahab, Sami Abd and Abd-Elkariem, Ahmed Yassien and Abd-Elsalam, Sherief and Junior, Joel Abdala and Abdalah, Ahmad and Abdalhadi, Alya and Abdalla, Ahmed and Abdalla, Eman Adam and Abdalla, Samir and Abdalla, Shimaa and Abdalla, Siddig and Abdallah, Emne and Abdallah, Ghaida and Abdallah, Lubna and Abdallah, Munir and Abdallah, Rasha and Abdalnour, Hani and Abdeen, Bashar and Abdeewi, Saedah and Abdeh, Louai and Fattah, Shrouk Abdel and Abdel-Aleem, Mahmoud and Abdel-Elsalam, Wafaa and Abdel-Fattah, Areej and Abdel-Fattah, Nour and Abdel-Hafez, Ibrahim and Abdelaal, Abdelrahman and Abdelazeem, Khaled and Abdelaziz, Mohammed and Abdelbagi, Mohamad and Abdelbaset, Abouelnour and Abdeldayem, Hesham and Abdelfattah, Mahmoud and Abdelgadir, Alwaleed and Abdelgalel, Khaled and Abdelghafar, Moslem and Abdelhafez, Mohammed and Abdeljalil, Abdelkarim and Abdelkabir, Mohammed and Salama, Ibrahim Abdelkader and 