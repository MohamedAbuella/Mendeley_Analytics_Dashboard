journal = {Energy Procedia},
keywords = {cloud image forecasting,optimization,sky image,solar power forecasting},
pages = {362--368},
publisher = {Elsevier B.V.},
title = {{Research on a cloud image forecasting approach for solar power forecasting}},
url = {https://doi.org/10.1016/j.egypro.2017.12.057},
volume = {142},
