issn = {01411187},
journal = {Applied Ocean Research},
keywords = {3DMI,High cited doc,Ship efficiency,Ship safety,WSR,Weather routing system,shipping},
mendeley-tags = {High cited doc,WSR,shipping},
pages = {130--140},
publisher = {Elsevier B.V.},
title = {{The optimization of ship weather-routing algorithm based on the composite influence of multi-dynamic elements (II): Optimized routings}},
url = {http://dx.doi.org/10.1016/j.apor.2014.12.005},
volume = {50},
year = {2015}
}
