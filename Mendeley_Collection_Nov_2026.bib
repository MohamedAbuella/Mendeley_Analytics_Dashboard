issn = {18785921},
journal = {Journal of Clinical Epidemiology},
keywords = {AIrev,Meta-analysis,Reporting guidelines,Reproducibility,Systematic reviews,Theoretical Background,Transparency,Very High cited doc,important doc},
mendeley-tags = {AIrev,Theoretical Background,Very High cited doc,important doc},
pages = {103--112},
pmid = {33577987},
publisher = {Elsevier Inc.},
title = {{Updating guidance for reporting systematic reviews: development of the PRISMA 2020 statement}},
url = {https://doi.org/10.1016/j.jclinepi.2021.02.003},
volume = {134},
year = {2021}
}
