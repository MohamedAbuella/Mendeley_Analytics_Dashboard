journal = {Journal of Modern Power Systems and Clean Energy},
keywords = {Alternating current (AC) optimal power flow (OPF),High cited doc,PhyML,RL,Theoretical Background,deep reinforcement learning (DRL),imitation learning,proximal policy optimization,shipping},
mendeley-tags = {High cited doc,PhyML,RL,Theoretical Background,shipping},
