volume = {149},
year = {2020}
}
@article{Yao2023,
abstract = {Digital simulation is an effective tool to analyze, design, test and optimize Multi-Vector Energy System (MVES) in a flexible and cost-saving way. This paper explores to realize the joint simulation of multi dynamic physical processes in MVES. The structured modeling technology is adopted to encapsulate each component as a standard module, where the over-detailed distributed-parameter component models are simplified as the input-output characteristic models with lumped parameters. On this basis, a unified solution framework that divides the system simulation model into several parts to avoid directly solving the stiff system equations is developed, which is capable of carrying out generic simulation of any MVES and suitable to provide back-end support for generic simulation platforms. Case studies demonstrate the validity of our modeling and solution methods.},
