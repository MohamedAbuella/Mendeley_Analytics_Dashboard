author = {Ruan, Guangchun and Zhong, Haiwang and Zhang, Guanglun and He, Yiliu and Wang, Xuan and Pu, Tianjiao},
doi = {10.17775/CSEEJPES.2020.03070},
eprint = {2007.00210},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Ruan et al. - 2019 - Review of Learning-Assisted Power System Optimization.pdf:pdf},
issn = {20960042},
