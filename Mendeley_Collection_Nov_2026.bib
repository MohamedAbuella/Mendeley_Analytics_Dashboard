file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Powell, Meisel - 2016 - Tutorial on Stochastic Optimization in Energy - Part II An Energy Storage Illustration.pdf:pdf},
