issn = {1757899X},
month = {nov},
number = {1},
publisher = {IOP Publishing Ltd},
title = {{Prediction of vessel propulsion power from machine learning models based on synchronized AIS-, ship performance measurements and ECMWF weather data}},
volume = {929},
year = {2020}
}
