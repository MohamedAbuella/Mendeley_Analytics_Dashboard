isbn = {9781665407700},
journal = {Proceedings - 2021 5th International Conference on Vision, Image and Signal Processing, ICVISP 2021},
keywords = {AIS,Anomaly detection,Event detection,GNN,Graph neural networks,Marine systems,Path,Spatiotemporal graph embeddings,Theoretical Background,important doc,shipping},
