issn = {13640321},
keywords = {Biodiesel,Byproducts,Combustion,Glycerol},
pages = {475--493},
publisher = {Elsevier Ltd},
title = {{Glycerol: Production, consumption, prices, characterization and new trends in combustion}},
volume = {27},
year = {2013}
