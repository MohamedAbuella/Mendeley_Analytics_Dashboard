keywords = {Exploration and exploitation,Henry gas solubility optimization,Local optima,Metaheuristic,Optimization,Path,Physics-inspired,Theoretical Background,Very High cited doc,shipping},
mendeley-tags = {Path,Theoretical Background,Very High cited doc,shipping},
pages = {646--667},
publisher = {Elsevier B.V.},
title = {{Henry gas solubility optimization: A novel physics-based algorithm}},
