@techreport{Wu2022d,
abstract = {Hydrogen energy storage (HES) transforms and stores electric energy from the grid into hydrogen, and supplements other energy storage and demand response resources in addressing challenges in renewable-intensive power systems. Understanding how to optimally utilize an HES system to maximize its economic benefits from stacked value streams is highly important to its development and deployment. This paper presents a techno-economic assessment framework for an HES system considering three common energy delivery pathways and multiple grid and end-user services. Models are developed to capture the operational capability, flexibility , and constraints associated with hydrogen production, compression, storage, and utilization as well as different grid services in an economic assessment. To define the technically achievable benefits, an optimal dispatch formulation is proposed to maximize the economic benefits over a representative year with an hourly time step considering the trade-offs among different value streams. Representative case studies are designed and carried out to show how system configuration, energy delivery pathways, and grid services may affect economic benefits. It was found that value streams from bundling grid services account for up to 76% of the total benefits and are critical for an HES project to be financially viable. Nomenclature Sets N DC j A set that contains all hours within a demand charge period j N DR j A set that contains all hours within a demand response period j N k A set that contains all hours that are used to calculate the baseline load of hour k Parameters $\alpha$ The maximum admixture rate by volume for hydrogen directly injected into gas pipelines (unitless) ∆T Time step size, which is an hour in this paper $\kappa$ SC , $\kappa$ TC Ratio of hydrogen intake to electricity consumed by a storage compressor and tube compressor, respectively (kg/MWh) $\kappa$ E Ratio of hydrogen produced to electricity consumed by an electrolyzer (kg/MWh) $\kappa$ M Ratio of hydrogen converted to electricity consumption by a methanation reactor (kg/MWh) $\kappa$ FC Ratio of electricity produced to hydrogen consumed by a fuel cell (MWh/kg) µ DC j Demand charge rate of month j ($/MW-month) µ DR j Demand response incentive rate of month j ($/MW-month)},
author = {Wu, Di and Wang, Dexin and Ramachandran, Thiagarajan and Holladay, Jamie},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Wu et al. - 2022 - A techno-economic assessment framework for hydrogen energy storage toward multiple energy delivery pathways and gr(2).pdf:pdf},
keywords = {Economic analysis,TEA,energy storage,grid services,hydrogen electrolysis,optimization,stacked value streams},
mendeley-tags = {TEA},
title = {{A techno-economic assessment framework for hydrogen energy storage toward multiple energy delivery pathways and grid services}},
url = {https://www.elsevier.com/open-access/userlicense/1.0/},
year = {2022}
}
