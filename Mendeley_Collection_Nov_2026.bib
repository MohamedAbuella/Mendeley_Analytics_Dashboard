@article{Ayodele2016,
abstract = {The availability of reasonably accurate global solar radiation data is vital for the success of any solar project. However, only a few meteorological stations around the world capture these data as a result of the high cost of measuring equipment and the lack of technical capability in calibrating them. In an attempt to resolve this challenge, engineers and researchers have developed various alternatives to generate the data. In this paper, we surveyed the methods used in generating synthetic global solar radiation with a view to classifying them and bringing out the advantages and the challenges of each. This could motivate the development of a new set of robust prediction techniques that combines the strengths of different existing models for prediction purposes. The various prediction techniques can be generally classified into four categories: the regression techniques, the artificial intelligence methods, the statistical approaches, and the satellite imagery techniques. It is shown from the review th...},
