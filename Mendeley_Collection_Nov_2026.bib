keywords = {Coordinated control,ferry,hybrid electric ferry,impedance-based stability,propulsion load,shipboard microgrid (SMG),shipping},
mendeley-tags = {ferry,shipping},
number = {3},
pages = {828--839},
publisher = {IEEE},
title = {{Coordinated Control of a Hybrid-Electric-Ferry Shipboard Microgrid}},
volume = {5},
