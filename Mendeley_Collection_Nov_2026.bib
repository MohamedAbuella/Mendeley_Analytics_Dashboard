journal = {Journal of Engineering for Gas Turbines and Power},
keywords = {AIS,important doc,shipping},
mendeley-tags = {AIS,important doc,shipping},
number = {7},
title = {{A data filter for identifying steady-state operating points in engine flight data for condition monitoring applications}},
volume = {133},
