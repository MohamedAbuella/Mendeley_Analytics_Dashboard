journal = {International Conference on Electrical Engineering, Computer Science and Informatics (EECSI)},
keywords = {GPS,M2M,Machine Learning,Naive Bayes,Regresi logistik,Vessel Monitoring System,shipping},
mendeley-tags = {shipping},
pages = {128--135},
title = {{Marine vessel telemetry data processing using machine learning}},
year = {2019}
