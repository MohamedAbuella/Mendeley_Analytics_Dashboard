keywords = {GT,GT-IES,Game theory,Market competition,Multi-Vector Energy System,OR,Oligopoly model,Social welfare,Sustainable manufacturing,Tax and subsidy,Theoretical Background,Very High cited doc,important doc},
mendeley-tags = {GT,GT-IES,Multi-Vector Energy System,OR,Theoretical Background,Very High cited doc,important doc},
pages = {94--103},
publisher = {Elsevier Ltd},
title = {{An oligopoly model to analyze the market and social welfare for green manufacturing industry}},
url = {http://dx.doi.org/10.1016/j.jclepro.2014.01.016},
volume = {85},
