@article{Heidaryan2010,
abstract = {Gas compressibility factor (z-Factor) is one of the most important parameters in upstream and downstream calculations of petroleum industries. The importance of z-Factor cannot be overemphasized in oil and gas engineering calculations. The experimental measurements, Equations of State (EoS) and empirical correlations are the most common sources of z-Factor calculations. There are more than twenty correlations available with two variables for calculating the z-Factor from fitting in an EoS or just through fitting techniques. However, these correlations are too complex, which require initial value and more complicated and longer computations or have magnitude error. The purpose of this study is to develop a new accurate correlation to rapidly estimate z-Factor. Result of this correlation is compared with large scale of database and experimental data also. Proposed correlation has 1.660 of Absolute Percent Relative Error (EABS) versus Standing and Katz chart and has also 3.221 of EABS versus experimental data. The output of this correlation can be directly assumed or be used as an initial value of other implicit correlations. This correlation is valid for gas coefficient of isothermal compressibility (cg) calculations also. {\textcopyright} 2010 CAS/DICP.},
author = {Heidaryan, Ehsan and Salarabadi, Amir and Moghadasi, Jamshid},
doi = {10.1016/S1003-9953(09)60050-5},
file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Heidaryan, Salarabadi, Moghadasi - 2010 - A novel correlation approach for prediction of natural gas compressibility factor.pdf:pdf},
isbn = {1153237269982},
issn = {10039953},
journal = {Journal of Natural Gas Chemistry},
keywords = {Compressibility factor,Correlation,GASnets,Natural gas,OR,Standing and Katz chart,Theoretical Background},
mendeley-tags = {GASnets,OR,Theoretical Background},
number = {2},
pages = {189--192},
publisher = {CAS/DICP},
title = {{A novel correlation approach for prediction of natural gas compressibility factor}},
url = {http://dx.doi.org/10.1016/S1003-9953(09)60050-5},
volume = {19},
year = {2010}
}
