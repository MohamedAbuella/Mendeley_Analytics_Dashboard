journal = {Journal of Cleaner Production},
keywords = {Decision support systems,Exact and heuristic algorithms,Fisheries planning,Route optimization,Ship routing and scheduling,Weather routing},
number = {July},
pages = {128661},
publisher = {Elsevier Ltd},
title = {{Towards a framework for fishing route optimization decision support systems: Review of the state-of-the-art and challenges}},
