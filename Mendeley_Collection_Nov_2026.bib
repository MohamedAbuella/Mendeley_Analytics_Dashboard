file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Zhang et al. - 2019 - Data-driven ship energy efficiency analysis and optimization model for route planning in ice-covered Arctic wat(2).pdf:pdf},
