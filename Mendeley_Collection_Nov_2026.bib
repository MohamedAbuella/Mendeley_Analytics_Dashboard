keywords = {RE Teaching,Ramp PV,Theoretical Background,ground-based sky images,important doc,open-source datasets,review},
mendeley-tags = {RE Teaching,Ramp PV,Theoretical Background,important doc,review},
title = {{Open-Source Ground-based Sky Image Datasets for Very Short-term Solar Forecasting, Cloud Analysis and Modeling: A Comprehensive Survey}},
url = {http://arxiv.org/abs/2211.14709},
year = {2022}
}
