file = {:C\:/Users/Mhdella/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Krantz et al. - 2022 - Indirect CO 2 emissions caused by the fuel demand switch in international shipping.pdf:pdf},
issn = {13619209},
